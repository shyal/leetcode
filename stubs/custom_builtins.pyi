from typing import (
    Any as Any,
    Callable as Callable,
    Dict as Dict,
    Generic as Generic,
    Iterable as Iterable,
    Iterator as Iterator,
    List as List,
    Optional as Optional,
    Tuple as Tuple,
    TypeVar as TypeVar,
    Union as Union,
    overload as overload,
)

_T = TypeVar("_T")
_KT = TypeVar("_KT")
_VT = TypeVar("_VT")

class TreeNode:
    def __init__(self, val: int = 0, left: Optional["TreeNode"] = None, right: Optional["TreeNode"] = None) -> None: ...
    val: int
    left: Optional["TreeNode"]
    right: Optional["TreeNode"]

class ListNode:
    def __init__(self, val: int = 0, next: Optional["ListNode"] = None) -> None: ...
    val: int
    next: Optional["ListNode"]

class Node:
    def __init__(self, val: Any, children: Dict[Any, "Node"] = ...) -> None: ...
    val: Any
    children: Dict[Any, "Node"]

class defaultdict(Generic[_KT, _VT]):
    def __init__(self, default_factory: Callable[[], _VT] | None = None, /, **kwargs: _VT) -> None: ...
    default_factory: Callable[[], _VT] | None

dd = defaultdict

class Counter(Generic[_KT]):
    def __init__(self, iterable: Iterable[_KT] | None = None, /, **kwds: int) -> None: ...

def tabulate(tabular_data: Iterable[Iterable[Any]], headers: Iterable[str] = ..., tablefmt: str = ..., **kwargs: Any) -> str: ...

def rich_print(*args: Any, **kwargs: Any) -> None: ...

def draw_tree(root: Optional[TreeNode]) -> None: ...

def draw_linked_list(head: Optional[ListNode]) -> None: ...

def draw_general_tree(root: Optional[Node]) -> None: ...

def build_tree(arr: List[Optional[int]]) -> Optional[TreeNode]: ...

def generate_and_print_random_bst(n: int, seed: Optional[int] = None, verbose: bool = True) -> Optional[TreeNode]: ...

def generate_full_binary_tree(height: int) -> Optional[TreeNode]: ...

def get_list_values(head: Optional[ListNode]) -> List[int]: ...

def print_linked_list(head: Optional[ListNode]) -> None: ...

def build_linked_list(vals: List[int]) -> Optional[ListNode]: ...

def find_node(root: Optional[TreeNode], val: Any) -> Optional[TreeNode]: ...

def get_inorder(root: Optional[TreeNode]) -> List[int]: ...

def is_balanced(root: Optional[TreeNode]) -> bool: ...

def is_valid_bst(root: Optional[TreeNode]) -> bool: ...

def groupby(iterable: Iterable[_T], key: Callable[[_T], _KT] | None = None) -> Iterator[Tuple[_KT, Iterator[_T]]]: ...

def combinations(iterable: Iterable[_T], r: int) -> Iterator[Tuple[_T, ...]]: ...

def log10(x: float) -> float: ...

def log2(x: float) -> float: ...

def floor(x: float) -> int: ...

def ceil(x: float) -> int: ...

def prod(iterable: Iterable[int | float], /, *, start: int | float = 1) -> int | float: ...

def pairwise(iterable: Iterable[_T]) -> Iterator[Tuple[_T, _T]]: ...

def zip_longest(*iterables: Iterable[_T], fillvalue: Any = None) -> Iterator[Tuple[Any, ...]]: ...

def reduce(function: Callable[..., _T], iterable: Iterable[_T], initializer: _T | None = None) -> _T: ...

def takewhile(predicate: Callable[[_T], object], iterable: Iterable[_T]) -> Iterator[_T]: ...

def product(*iterables: Iterable[_T], repeat: int = 1) -> Iterator[Tuple[_T, ...]]: ...

def enumr(iterable: Iterable[_T], start: int = 0) -> Iterator[Tuple[int, _T]]: ...

def accumulate(iterable: Iterable[_T], func: Callable[[_T, _T], _T] = ..., *, initial: _T | None = None) -> Iterator[_T]: ...

def bisect_left(a: List[_T], x: _T, lo: int = 0, hi: int | None = None) -> int: ...

def bisect_right(a: List[_T], x: _T, lo: int = 0, hi: int | None = None) -> int: ...

def chain(*iterables: Iterable[_T]) -> Iterator[_T]: ...

def add(a: Any, b: Any) -> Any: ...

def xor(a: Any, b: Any) -> Any: ...

def heapify(heap: List[_T]) -> None: ...

def heappop(heap: List[_T]) -> _T: ...

def heappush(heap: List[_T], item: _T) -> None: ...

def nlargest(n: int, iterable: Iterable[_T], key: Callable[[_T], Any] | None = None) -> List[_T]: ...

def nsmallest(n: int, iterable: Iterable[_T], key: Callable[[_T], Any] | None = None) -> List[_T]: ...

ascii_letters: str = ...

ascii_lowercase: str = ...

ascii_uppercase: str = ...

def match(pattern: str, string: str, flags: int = 0) -> Any: ...

def permutations(iterable: Iterable[_T], r: int | None = None) -> Iterator[Tuple[_T, ...]]: ...

def or_(a: Any, b: Any) -> Any: ...

def and_(a: Any, b: Any) -> Any: ...