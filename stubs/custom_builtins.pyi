# Type aliases (as specified)
List = List
Optional = Optional
Dict = Dict
Tuple = Tuple
Any = Any
Callable = Callable
Generic = Generic
Iterable = Iterable
Iterator = Iterator
TypeVar = TypeVar
Union = Union
overload = overload

# Custom classes
class TreeNode:
    val: int
    left: Optional["TreeNode"]
    right: Optional["TreeNode"]
    def __init__(self, val: int = 0, left: Optional["TreeNode"] = None, right: Optional["TreeNode"] = None) -> None: ...

class ListNode:
    val: int
    next: Optional["ListNode"]
    def __init__(self, val: int = 0, next: Optional["ListNode"] = None) -> None: ...
    def __repr__(self) -> str: ...

class Node:
    val: Any
    children: Dict[Any, "Node"]
    def __init__(self, val: Any, children: Dict[Any, "Node"] = ...) -> None: ...

# Class stubs for collections
_KT = TypeVar("_KT")
_VT = TypeVar("_VT")
_T = TypeVar("_T")

class defaultdict(dict, Generic[_KT, _VT]):
    def __init__(self, default_factory: Optional[Callable[[], _VT]] = None, /, **kwargs: _VT) -> None: ...

dd = defaultdict

class Counter(dict, Generic[_T]):
    def __init__(self, iterable: Optional[Iterable[_T]] = None, /, **kwds: int) -> None: ...
    def elements(self) -> Iterator[_T]: ...
    def most_common(self, n: Optional[int] = None) -> List[Tuple[_T, int]]: ...
    @classmethod
    def fromkeys(cls, iterable: Iterable[_T], v: Optional[int] = None) -> "Counter[_T]": ...
    def update(self, iterable: Optional[Iterable[_T]] = None, /, **kwds: int) -> None: ...

