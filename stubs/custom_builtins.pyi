import re
from typing import Any, Callable, Dict, Generic, Iterable, Iterator, List, Optional, Tuple, TypeVar, Union, overload

_K = TypeVar("_K")
_T = TypeVar("_T")
_S = TypeVar("_S")
_V = TypeVar("_V")

# Type aliases
from typing import List as List, Optional as Optional

# Custom classes
class TreeNode:
    def __init__(self, val: int = 0, left: Optional["TreeNode"] = None, right: Optional["TreeNode"] = None) -> None: ...
    val: int
    left: Optional["TreeNode"]
    right: Optional["TreeNode"]

class ListNode:
    def __init__(self, val: int = 0, next: Optional["ListNode"] = None) -> None: ...
    val: int
    next: Optional["ListNode"]

class Node:
    def __init__(self, val: Any, children: Dict[Any, "Node"] = ...) -> None: ...
    val: Any
    children: Dict[Any, "Node"]

# Classes
class defaultdict(dict[_K, _V], Generic[_K, _V]):
    def __init__(self, default_factory: Optional[Callable[[], _V]] = None, /, **kwargs: Any) -> None: ...

class Counter(dict[_T, int]):
    def __init__(self, iterable: Optional[Iterable[_T]] = None, /, **kwds: int) -> None: ...

# Constants
ascii_letters: str = ...
ascii_lowercase: str = ...
ascii_uppercase: str = ...

# Function stubs for shortcuts
def groupby(iterable: Iterable[_T], key: Optional[Callable[[_T], _K]] = None) -> Iterator[Tuple[_K, Iterator[_T]]]: ...

def combinations(iterable: Iterable[_T], r: int) -> Iterator[Tuple[_T, ...]]: ...

def log10(x: float) -> float: ...

def log2(x: float) -> float: ...

def floor(x: float) -> int: ...

def ceil(x: float) -> int: ...

def pairwise(iterable: Iterable[_T]) -> Iterator[Tuple[_T, _T]]: ...

def zip_longest(*iterables: Iterable[Any], fillvalue: Any = None) -> Iterator[Tuple[Any, ...]]: ...

@overload
def reduce(function: Callable[[_T, _S], _T], sequence: Iterable[_S], initial: _T) -> _T: ...
@overload
def reduce(function: Callable[[_T, _T], _T], sequence: Iterable[_T]) -> _T: ...

def takewhile(predicate: Callable[[_T], object], iterable: Iterable[_T]) -> Iterator[_T]: ...

def prod(iterable: Iterable[int], *, start: int = 1) -> int: ...

def product(*iterables: Iterable[_T], repeat: int = 1) -> Iterator[Tuple[_T, ...]]: ...

dd = defaultdict

def enumr(iterable: Iterable[_T], start: int = 0) -> Iterator[Tuple[int, _T]]: ...

def accumulate(iterable: Iterable[_T], func: Callable[[_T, _T], _T] = ..., *, initial: Optional[_T] = None) -> Iterator[_T]: ...

def bisect_left(a: List[_T], x: _T, lo: int = 0, hi: Optional[int] = None) -> int: ...

def bisect_right(a: List[_T], x: _T, lo: int = 0, hi: Optional[int] = None) -> int: ...

def chain(*iterables: Iterable[_T]) -> Iterator[_T]: ...

def add(a: _T, b: _T) -> _T: ...

def xor(a: int, b: int) -> int: ...

def heapify(heap: List[_T]) -> None: ...

def heappop(heap: List[_T]) -> _T: ...

def heappush(heap: List[_T], item: _T) -> None: ...

def nlargest(n: int, iterable: Iterable[_T], key: Optional[Callable[[_T], Any]] = None) -> List[_T]: ...

def nsmallest(n: int, iterable: Iterable[_T], key: Optional[Callable[[_T], Any]] = None) -> List[_T]: ...

def match(pattern: Union[str, re.Pattern[str]], string: str, flags: int = 0) -> Optional[re.Match[str]]: ...

# Pretty printing
def tabulate(tabular_data: Iterable[Iterable[Any]], headers: Iterable[str] = (), tablefmt: str = "simple", **kwargs: Any) -> str: ...

def rich_print(*objects: Any, sep: str = " ", end: str = "\n", file: Any = ..., flush: bool = False) -> None: ...

# Tree utils
def draw_tree(root: Optional[TreeNode]) -> None: ...

def draw_general_tree(root: Optional[Node]) -> None: ...

def build_tree(arr: List[Optional[int]]) -> Optional[TreeNode]: ...

def generate_full_binary_tree(height: int) -> Optional[TreeNode]: ...

def find_node(root: Optional[TreeNode], val: int) -> Optional[TreeNode]: ...

def get_inorder(root: Optional[TreeNode]) -> List[int]: ...

def is_balanced(root: Optional[TreeNode]) -> bool: ...

# BST utils
def generate_and_print_random_bst(n: int, seed: Optional[int] = None, verbose: bool = True) -> Optional[TreeNode]: ...

def is_valid_bst(root: Optional[TreeNode]) -> bool: ...

# Linked list utils
def draw_linked_list(head: Optional[ListNode]) -> None: ...

def get_list_values(head: Optional[ListNode]) -> List[int]: ...

def print_linked_list(head: Optional[ListNode]) -> None: ...

def build_linked_list(vals: List[int]) -> Optional[ListNode]: ...