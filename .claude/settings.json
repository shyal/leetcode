{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [{"type": "command", "command": "utils/check/format-one"}]
            }
        ],
        "UserPromptSubmit": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"$CLAUDE_PROJECT_DIR\" && utils/rs/target/release/kg_rep --line 2>/dev/null || true"
                    },
                    {
                        "type": "command",
                        "command": "cd \"$CLAUDE_PROJECT_DIR\" && utils/rs/target/release/kg_chat --check 2>/dev/null || true"
                    }
                ]
            }
        ]
    }
}
