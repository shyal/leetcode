#!/usr/bin/env python3

import subprocess
import os
import sys
import time
import re
from datetime import datetime, timezone

# --failed: file the attempt as a FAILED one (make failed). Same flow —
# same folder, same solve-time trailer, same extraction — but the filename,
# commit message and an appended note say it was abandoned, so the judge
# records struggled evidence instead of a solve.
FAILED = "--failed" in sys.argv


def parse_current(file_path="current.py"):
    with open(file_path, "r") as f:
        content = f.read()

    # Find the first docstring
    match = re.search(r'"""(.*?)"""', content, re.DOTALL)
    if not match:
        return None, None, ""

    docstring = match.group(1).strip()
    lines = docstring.split("\n")

    problem_id = None
    title = None
    for line in lines:
        line = line.strip()
        if line:
            drill_match = re.match(r"DRILL:\s*(.+)", line)
            if drill_match:
                return "drill", drill_match.group(1).strip(), content
            prob_match = re.match(r"(\d+[a-zA-Z]?)\.\s*(.+)", line)
            if prob_match:
                problem_id = prob_match.group(1).strip()
                title = prob_match.group(2).strip()
                break

    if problem_id is None:
        # If not in first line, check after url
        for i, line in enumerate(lines):
            if line.strip().startswith("https://"):
                if i + 1 < len(lines):
                    next_line = lines[i + 1].strip()
                    prob_match = re.match(r"(\d+[a-zA-Z]?)\.\s*(.+)", next_line)
                    if prob_match:
                        problem_id = prob_match.group(1).strip()
                        title = prob_match.group(2).strip()
                        break

    return problem_id, title, content


def comment_out_prints(content):
    lines = content.split("\n")
    new_lines = []
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("print(") or stripped.startswith("print ("):
            leading_whitespace = line[: line.index(stripped[0])]
            new_lines.append(leading_whitespace + "# " + stripped)
        else:
            new_lines.append(line)
    return "\n".join(new_lines)


def main():
    # Find the start time
    # First, check for commit with message "started"
    result = subprocess.run(
        ["git", "log", "-1", "--grep=^started$", "--format=%ct"],
        capture_output=True,
        text=True,
    )
    output = result.stdout.strip()

    if output:
        start_time = int(output)
    else:
        # Get the last commit time
        result = subprocess.run(
            ["git", "log", "-1", "--format=%ct"], capture_output=True, text=True
        )
        if result.returncode != 0 or not result.stdout.strip():
            print("No commits found. Using current time as start.")
            start_time = time.time()
        else:
            start_time = int(result.stdout.strip())

    current_time = time.time()
    delta_seconds = current_time - start_time
    minutes = int(delta_seconds // 60)
    seconds = int(delta_seconds % 60)
    solve_time = f"{minutes}m {seconds}s"

    if not os.path.exists("current.py"):
        print("current.py does not exist. Exiting.")
        return

    problem_id, title, content = parse_current()
    if problem_id is None or title is None:
        print("Could not parse problem id and title from current.py. Exiting.")
        return

    # Comment out print statements
    # content = comment_out_prints(content)

    # Save to ./solved
    clean_title = re.sub(r"[^\w\s-]", "", title).strip().replace(" ", "_")
    utc_now = datetime.now(timezone.utc)
    iso = utc_now.isoformat() + "Z"
    sanitized = re.sub(r"[^\w]", "_", iso)
    marker = "_FAILED" if FAILED else ""
    if problem_id == "drill":
        filename = f"d_{clean_title}{marker}_{sanitized}.py"
    else:
        filename = f"p{problem_id}_{clean_title}{marker}_{sanitized}.py"

    if FAILED:
        content += (
            f"\n\n# FAILED: walked away after {solve_time}; no working solution."
            "\n# Judge the moves actually attempted as struggled, not clean.\n"
        )
    output_dir = "./solved"
    os.makedirs(output_dir, exist_ok=True)
    filepath = os.path.join(output_dir, filename)

    with open(filepath, "w") as f:
        f.write(content)

    # Clear current.py
    with open("current.py", "w") as f:
        f.write("")

    # Prepare commit message
    if problem_id == "drill":
        commit_message = f"drill: {title}\n\nsolve time: {solve_time}"
    else:
        commit_message = f"{problem_id}. {title}\n\nsolve time: {solve_time}"
    if FAILED:
        commit_message = "failed: " + commit_message

    try:
        subprocess.run(["git", "add", "."], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error running git add: {e}")
        return

    try:
        subprocess.run(["git", "commit", "-m", commit_message], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error running git commit: {e}")
        return

    # Get current branch
    try:
        current_branch = (
            subprocess.check_output(["git", "rev-parse", "--abbrev-ref", "HEAD"])
            .decode()
            .strip()
        )
    except subprocess.CalledProcessError as e:
        print(f"Error getting current branch: {e}")
        return

    if current_branch == "master":
        print("Operations completed successfully.")
        return

    # Checkout master
    try:
        subprocess.run(["git", "checkout", "master"], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error checking out master: {e}")
        return

    # Squash merge the branch
    try:
        subprocess.run(["git", "merge", "--squash", current_branch], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error squash merging: {e}")
        return

    # Commit with the solve time message
    try:
        subprocess.run(["git", "commit", "-m", commit_message], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error committing squash merge: {e}")
        return

    # Delete the feature branch
    try:
        subprocess.run(["git", "branch", "-D", current_branch], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Error deleting branch: {e}")
        return

    print("Operations completed successfully.")


if __name__ == "__main__":
    main()
