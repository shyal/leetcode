#!/usr/bin/env python3

# timer — live pacing bars for the solve in current.py, branch-aware so it
# can sit open in a terminal split all session.
#
#   make timer
#
# Idle on master. The moment `make prepare` / `make drill` cuts a solve
# branch, the timer picks it up: three bars against the same forecast
# `make next` printed — expected time, the hint mark (2x), and the stop
# mark (4x — bank it, reinforce). The clock counts what `make solved`
# will record: ACTIVE time on the branch (kg_lib.active_seconds), the
# slept intervals of a parked/resumed problem excluded. When the branch merges away
# the timer goes idle again and waits for the next one. Ctrl+C to quit;
# it records nothing — `make solved` stays the only recorder.

import glob
import os
import re
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader

import pyfiglet
from rich.align import Align
from rich.console import Console, Group
from rich.live import Live
from rich.panel import Panel
from rich.progress import BarColumn, Progress, TextColumn
from rich.text import Text

from kg_lib import (DRILLS_DIR, load_problems, solve_forecast, drill_forecast,
                    drill_solved_stem, active_seconds)

UTILS = os.path.dirname(os.path.abspath(__file__))
console = Console()


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def start_time():
    """A virtual t0 such that (now - t0) = ACTIVE time on the branch —
    slept intervals (make sleep / make wake markers) excluded, same clock
    `make solved` records."""
    return time.time() - active_seconds()[0]


def forecast():
    solved = SourceFileLoader("_solved", os.path.join(UTILS, "solved")).load_module()
    pid, title, _ = solved.parse_current()
    if pid is None:
        return None, None
    if pid == "drill":
        stem = re.sub(r"[^\w\s-]", "", title).strip().replace(" ", "_")
        path = next((p for p in glob.glob(os.path.join(DRILLS_DIR, "*", "*.py"))
                     if drill_solved_stem(p) == stem), None)
        return f"drill: {title}", (drill_forecast(path) if path else None)
    return f"{pid}. {title}", solve_forecast(pid, load_problems())


def clock(secs):
    m, s = divmod(int(secs), 60)
    return f"{m}m {s:02d}s"


def active_branch():
    """The solve branch, or None when idle (master, or no parseable stub)."""
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch in ("", "master", "HEAD"):
        return None
    try:
        if not open("current.py").read().strip():
            return None
    except OSError:
        return None
    return branch


def big_clock(secs, color):
    """The elapsed clock as large figlet digits, colored by zone. Font from
    $TIMER_FONT (default doh, same as make goals), stepping down to smaller
    fonts and finally plain text when the pane is too narrow."""
    m, s = divmod(int(secs), 60)
    face = f"{m}:{s:02d}"
    for font in (os.environ.get("TIMER_FONT", "doh"), "univers", "big"):
        try:
            art = pyfiglet.figlet_format(face, font=font)
        except Exception:
            continue
        lines = [l for l in art.rstrip().splitlines() if l.strip()]
        if lines and max(map(len, lines)) <= console.width - 4:
            return Text("\n".join(lines), style=f"bold {color}")
    return Text(clock(secs), style=f"bold {color}")


class Session:
    """One timed solve: forecast and clock, cached until the branch changes."""

    def __init__(self):
        self.label, fc = forecast()
        self.t0 = start_time()
        self.slept, self.parks = active_seconds()[1:]
        self.marks = [("expected", fc[0] * 60, "green"),
                      ("hint fair game", fc[1] * 60, "yellow"),
                      ("stop, reinforce", fc[2] * 60, "red")] if fc else []
        self.progress = Progress(
            TextColumn("{task.description}"),
            BarColumn(bar_width=None, complete_style="cyan", finished_style="bold cyan"),
            TextColumn("[dim]{task.fields[mark]}[/dim]"),
            TextColumn("{task.fields[left]:>10s}"),
            console=console, expand=True,
        )
        self.tasks = [self.progress.add_task(f"[{c}]{name:15s}[/{c}]",
                                             total=total, mark=clock(total), left="")
                      for name, total, c in self.marks]

    def zone(self, elapsed):
        """(color, message) for where the clock sits between the marks."""
        if not self.marks:
            return "cyan", "no forecast — plain clock"
        if elapsed > self.marks[2][1]:
            return "red", "past the stop mark — bank it, reinforce"
        if elapsed > self.marks[1][1]:
            return "yellow", "hint is fair game"
        if elapsed > self.marks[0][1]:
            return "yellow", "past expected — keep going"
        return "green", "on pace"

    def render(self):
        elapsed = time.time() - self.t0
        color, message = self.zone(elapsed)
        for t, (_, total, c) in zip(self.tasks, self.marks):
            left = "" if elapsed >= total else f"-{clock(total - elapsed)}"
            self.progress.update(t, completed=min(elapsed, total), left=left)
        body = [Align.center(big_clock(elapsed, color))]
        if self.marks:
            body.append(self.progress)
        subtitle = f"[{color}]{message}[/{color}]"
        if self.parks:
            sh, sm = divmod(self.slept // 60, 60)
            subtitle += f"  [dim]· slept {sh}h {sm:02d}m over {self.parks} park(s)[/dim]"
        return Panel(Group(*body), title=f"[bold]{self.label}[/bold]",
                     subtitle=subtitle, border_style=color, padding=(1, 2))


def main():
    branch = None
    session = None
    try:
        with Live(console=console, refresh_per_second=2) as live:
            while True:
                b = active_branch()
                if b != branch:
                    branch = b
                    session = Session() if b else None
                if session:
                    live.update(session.render())
                else:
                    live.update(Panel(Align.center(Text.from_markup(
                        "[dim]idle — waiting for a solve branch "
                        "(`make next`, `make drill`)[/dim]")),
                        border_style="dim", padding=(1, 2)))
                time.sleep(1.0)
    except KeyboardInterrupt:
        if session:
            console.print(f"{session.label} — {clock(time.time() - session.t0)} "
                          "on the clock. `make solved` when it lands.")


if __name__ == "__main__":
    main()
