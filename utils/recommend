#!/usr/bin/env python3

# recommend

import json
import argparse
from rich.console import Console
from rich.markdown import Markdown
import os
import sys
import subprocess as _subprocess
from history_builder import get_history_string, get_today_solves

console = Console()


def main():
    parser = argparse.ArgumentParser(description="Recommend a leetcode question.")
    parser.add_argument("--contest", action="store_true", help="recommend for contest.")
    parser.add_argument(
        "--fundamentals", action="store_true", help="recommend for fundamentals."
    )
    parser.add_argument("--review", action="store_true", help="recommend for review.")
    parser.add_argument(
        "--include-easy",
        action="store_true",
        help="include easy problems in the solve history sent to the coach.",
    )

    args = parser.parse_args()

    speciality = "analyzing ther candidate's solve history"
    extra = ""

    include_notes = True

    if args.contest:
        include_notes = False
        speciality = "getting a candidate contest ready"
        with open("readiness.json") as r:
            readiness = json.loads(r.read())
            by_run_date = {}
            for entry in readiness:
                by_run_date[entry["run_date"]] = entry
            latest_run_date = next(iter(sorted(by_run_date, reverse=True)))
            extra = f"""

These are the candidate's contest topic readiness estimates:

{json.dumps(by_run_date[latest_run_date], indent=4)}

"""
    elif args.fundamentals:
        speciality = "strengthening a candidate's fundamentals"
    elif args.review:
        speciality = "helping a candidate review hard solves that may need solidifying"
        extra = """
Analyze the user's solve history to identify weak areas.

Examine very carefully how the user is solving questions, and think about what his weaknesses are. To strengthen
his skills, think about areas he's working on, and areas he's good at, and think of how to combine those various
aspects in novel ways with new problems.

Sometimes it's good to re-inforce an existing skill. Sometimes it's good to challenge it by mixing it with a new
skill the user is currently acquiring, and seeing those skills in various juxtapositions.
"""

    history_str = get_history_string(
        filter_out_easy=not args.include_easy, include_notes=include_notes
    )

    problems_solved_today = len(get_today_solves())

    system_prompt = f"""You are an expert LeetCode coach specializing in {speciality}.
    
Recommend EXACTLY ONE next problem to solve.

{extra}

After the solve, it will be added to the solve history, and you'll be given the opportunity to make more recommendations.
As such, this is a feedback loop: you make a recommendation, the user works on it, you get the history and get to make more
recommendations. You can thus build theories about why the user is struggling in a certain area, and learn as you go whether
your recommendations are help the candidate improve over time.

Older solves in the history are compressed to a one-line summary and annotated with their source file, e.g.
"(compressed, file: solved/pXYZ_Title_...py)". If a compressed summary is too vague for you to judge the
candidate's approach — e.g. you want to see which pattern they used, whether they used the canonical template, or
what notes they wrote — use the Read tool to open the file directly. Prefer reading at most 2-3 files per
recommendation; don't read every compressed solve. Glob/Grep are also available if you want to search the
./solved/ directory by topic or pattern. Do not recommend a problem the candidate has already solved unless you
are specifically recommending a review re-solve.

For your recommendation, specify:
- Problem number and full title (e.g., "1. Two Sum").
- Difficulty: Easy or Medium.
- Main topic(s): 1-3 key topics (e.g., Array, Hash Table).
- Why this problem: A brief explanation (2-4 sentences) on how it targets weaknesses, builds skills, or progresses learning — at the level of the candidate's journey, NOT the problem's solution.

ABSOLUTELY CRITICAL — NO SOLUTION HINTS:
You are recommending a problem, not teaching how to solve it. The candidate wants to work it out themselves.
- DO NOT describe the intended algorithm, data structure, pattern, or approach for the problem.
- DO NOT say things like "use a hash map", "two pointers", "sliding window", "DP on subsequences",
  "think about it as a graph", "sort first", "binary search on the answer", "greedy works here", etc.
- DO NOT hint at time/space complexity targets, invariants, or key observations.
- DO NOT describe edge cases or tricky inputs.
- DO NOT foreshadow the solution shape ("this is simpler than it looks", "the trick is...", "watch out for...").
- Listing the problem's topic tags (e.g. "Array, Hash Table") is fine — those are category labels, not hints.
- The "Why this problem" section must talk about the CANDIDATE (their solve history, gaps, progression,
  pacing, confidence, review cadence) and NOT about the problem's internals.

If you catch yourself explaining HOW to approach the problem, stop and rewrite. The candidate will ask
for hints separately if they want them.

Keep the response concise, structured, and encouraging. output a time limit for the solve e.g 15m, 30m or 50m etc. based on difficulty and solve history. Problems solved today: {problems_solved_today}."""

    user_prompt = f"""Here is my LeetCode solve history (most recent last):\n\n{history_str}\n\nBased on this, recommend my next problem."""

    with open("_recommendation_prompt.txt", "w") as w:
        w.write(system_prompt + user_prompt)

    md = Markdown(user_prompt)
    console.print(md)
    # exit()

    try:
        proc = _subprocess.Popen(
            [
                "claude",
                "-p",
                user_prompt,
                "--system-prompt",
                system_prompt,
                "--allowedTools",
                "Read",
                "Glob",
                "Grep",
                "--permission-mode",
                "bypassPermissions",
                "--output-format",
                "stream-json",
                "--verbose",
            ],
            stdout=_subprocess.PIPE,
            stderr=_subprocess.PIPE,
            text=True,
            bufsize=1,
        )

        final_text = ""
        tool_calls = 0
        assert proc.stdout is not None
        for raw in proc.stdout:
            raw = raw.strip()
            if not raw:
                continue
            try:
                event = json.loads(raw)
            except json.JSONDecodeError:
                continue
            etype = event.get("type")
            if etype == "assistant":
                for block in event.get("message", {}).get("content", []):
                    if block.get("type") != "tool_use":
                        continue
                    tool_calls += 1
                    name = block.get("name", "")
                    inp = block.get("input", {}) or {}
                    if name == "Read":
                        detail = inp.get("file_path", "")
                    elif name in ("Glob", "Grep"):
                        detail = inp.get("pattern", "")
                        path = inp.get("path")
                        if path:
                            detail = f"{detail} in {path}"
                    else:
                        detail = json.dumps(inp)[:120]
                    console.print(f"[dim]→ {name} {detail}[/dim]")
            elif etype == "result":
                final_text = event.get("result", "") or final_text

        proc.wait()
        if proc.returncode != 0:
            stderr = proc.stderr.read() if proc.stderr else ""
            print(f"claude exited with {proc.returncode}: {stderr}")
            sys.exit(proc.returncode)

        console.print(f"\n[dim]({tool_calls} tool call{'s' if tool_calls != 1 else ''})[/dim]\n")
        if final_text:
            md = Markdown(final_text)
            console.print(md)
    except Exception as e:
        print(f"Error calling Claude CLI: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
