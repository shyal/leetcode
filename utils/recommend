#!/usr/bin/env python3

# recommend

from rich.console import Console
from rich.markdown import Markdown
import os
import sys
from xai_sdk import Client
from xai_sdk.chat import system, user
from history_builder import get_history_string, get_today_solves

console = Console()

api_key = os.getenv("GROK_API_KEY")
if not api_key:
    raise ValueError("GROK_API_KEY environment variable not set")

client = Client(api_key=api_key)


def main():

    history_str = get_history_string()

    problems_solved_today = len(get_today_solves())

    system_prompt = f"""You are an expert LeetCode coach specializing in building strong fundamentals.
    
Analyze the user's solve history to identify weak areas.

Recommend EXACTLY ONE next problem to solve. 

Examine very carefully how the user is solving questions, and think about what his weaknesses are. Recommend exercises to work on his weakest areas.

After the solve, it will be added to the solve history, and you'll be given the opportunity to make more recommendations. As such, this is
a feedback loop: you make a recommendation, the user works on it, you get the history and get to make more recommendations. You can thus
build theories about why the user is struggling in a certain area, and learn as you go whether your recommendations are
help the candidate improve over time.

For your recommendation, specify:
- Problem number and full title (e.g., "1. Two Sum").
- Difficulty: Easy or Medium.
- Main topic(s): 1-3 key topics (e.g., Array, Hash Table).
- Why this problem: A brief explanation (2-4 sentences) on how it targets weaknesses, builds skills, or progresses learning.

Keep the response concise, structured, and encouraging. output a time limit for the solve e.g 15m, 30m or 50m etc. based on difficulty and solve history. Problems solved today: {problems_solved_today}."""

    user_prompt = f"""Here is my LeetCode solve history (most recent last):\n\n{history_str}\n\nBased on this, recommend my next problem."""

    with open("_recommendation_prompt.txt", "w") as w:
        w.write(user_prompt)

    md = Markdown(user_prompt)
    console.print(md)
    # exit()

    try:
        chat = client.chat.create(
            model="grok-4-0709",
            messages=[
                system(system_prompt),
                user(user_prompt),
            ],
        )
        response = chat.sample()
        recommendation = response.content
        md = Markdown(recommendation)
        console.print(md)
    except Exception as e:
        print(f"Error calling xAI API: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
