#!/usr/bin/env python3

# recommend

import json
import argparse
from rich.console import Console
from rich.markdown import Markdown
import os
import sys
import subprocess as _subprocess
from history_builder import get_history_string, get_today_solves

console = Console()


def main():
    parser = argparse.ArgumentParser(description="Recommend a leetcode question.")
    parser.add_argument("--contest", action="store_true", help="recommend for contest.")
    parser.add_argument(
        "--fundamentals", action="store_true", help="recommend for fundamentals."
    )
    parser.add_argument("--review", action="store_true", help="recommend for review.")

    args = parser.parse_args()

    speciality = "analyzing ther candidate's solve history"
    extra = ""

    include_notes = True

    if args.contest:
        include_notes = False
        speciality = "getting a candidate contest ready"
        with open("readiness.json") as r:
            readiness = json.loads(r.read())
            by_run_date = {}
            for entry in readiness:
                by_run_date[entry["run_date"]] = entry
            latest_run_date = next(iter(sorted(by_run_date, reverse=True)))
            extra = f"""

These are the candidate's contest topic readiness estimates:

{json.dumps(by_run_date[latest_run_date], indent=4)}

"""
    elif args.fundamentals:
        speciality = "strengthening a candidate's fundamentals"
    elif args.review:
        speciality = "helping a candidate review hard solves that may need solidifying"
        extra = """
Analyze the user's solve history to identify weak areas.

Examine very carefully how the user is solving questions, and think about what his weaknesses are. To strengthen
his skills, think about areas he's working on, and areas he's good at, and think of how to combine those various
aspects in novel ways with new problems.

Sometimes it's good to re-inforce an existing skill. Sometimes it's good to challenge it by mixing it with a new
skill the user is currently acquiring, and seeing those skills in various juxtapositions.
"""

    history_str = get_history_string(filter_out_easy=True, include_notes=include_notes)

    problems_solved_today = len(get_today_solves())

    system_prompt = f"""You are an expert LeetCode coach specializing in {speciality}.
    
Recommend EXACTLY ONE next problem to solve.

{extra}

After the solve, it will be added to the solve history, and you'll be given the opportunity to make more recommendations.
As such, this is a feedback loop: you make a recommendation, the user works on it, you get the history and get to make more
recommendations. You can thus build theories about why the user is struggling in a certain area, and learn as you go whether
your recommendations are help the candidate improve over time.

For your recommendation, specify:
- Problem number and full title (e.g., "1. Two Sum").
- Difficulty: Easy or Medium.
- Main topic(s): 1-3 key topics (e.g., Array, Hash Table).
- Why this problem: A brief explanation (2-4 sentences) on how it targets weaknesses, builds skills, or progresses learning.

Keep the response concise, structured, and encouraging. output a time limit for the solve e.g 15m, 30m or 50m etc. based on difficulty and solve history. Problems solved today: {problems_solved_today}."""

    user_prompt = f"""Here is my LeetCode solve history (most recent last):\n\n{history_str}\n\nBased on this, recommend my next problem."""

    with open("_recommendation_prompt.txt", "w") as w:
        w.write(system_prompt + user_prompt)

    md = Markdown(user_prompt)
    console.print(md)
    # exit()

    try:
        result = _subprocess.run(
            ["claude", "-p", user_prompt, "--system-prompt", system_prompt],
            capture_output=True, text=True,
        )
        recommendation = result.stdout.strip()
        md = Markdown(recommendation)
        console.print(md)
    except Exception as e:
        print(f"Error calling Claude CLI: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
