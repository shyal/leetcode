#!/usr/bin/env python3

# kg_today — freeze today's study plan into data/study_plan/<date>.json.
#
#   make today            # build the plan if today's file does not exist
#   make today -- --force # rebuild (deliberate regeneration, e.g. bad draft)
#
# The plan file is the determinism boundary: judgment (one claude call that
# reads the recent FAILED solves and turns them into consolidation work) runs
# ONCE per day and is frozen here; from that moment `make today` is idempotent
# and `make next` is a pure function of (plan, evidence). Same convention as
# kg_hard's map_with_claude cache. Gitignored — the plan is derived state.
#
# Sections, in serve order (the operator's spec):
#   warmup       2 mega-easies, straight from kg_next's session-start rule
#   review       FRAGILE/STALE targets with their carriers (rules 1-2)
#   consolidate  re-attempts / drills the failure analysis prescribes —
#                failures must account for something, not get hopped over
#   create-drill a rung the bank lacks; `make next` just SAYS to create it
#   new          rule 3/4 material, only when nothing above needs the day
#
# `make next` marks items done from evidence (a matching solve/drill rep on
# or after the plan date), the same self-clearing convention sleep uses.
# Failures during the day do not reshuffle the plan; they are tomorrow's
# consolidation input.

import argparse
import json
import os
import sys
from datetime import date, datetime
from importlib.machinery import SourceFileLoader

from rich.console import Console

from kg_lib import (
    GRAPH_DIR, DRILLS_DIR, load_nodes, load_problems, load_evidence,
    node_status, SOLID, STALE, FRAGILE, MISSING, load_sleep, sleep_state,
    last_solved, pnum_key, carriers_for, gentleness, unlocks, acceptance,
    drill_gated, has_drill_bank, claude_json, taxonomy_summary,
)

console = Console()
UTILS = os.path.dirname(os.path.abspath(__file__))
PLAN_DIR = os.path.join(os.path.dirname(GRAPH_DIR), "data", "study_plan")

FAILURE_LOOKBACK_DAYS = 7
MAX_REVIEWS = 2


def plan_path(day=None):
    return os.path.join(PLAN_DIR, f"{(day or date.today()).isoformat()}.json")


def _kg_next():
    return SourceFileLoader("_kg_next", os.path.join(UTILS, "kg_next")).load_module()


def recent_failures(evidence):
    """FAILED solve files from the lookback window, with their code (head for
    the attempt, tail for the operator's own verdict notes)."""
    out = []
    today = date.today()
    for fname, rec in sorted(evidence.items(), key=lambda kv: kv[1]["date"]):
        if "FAILED" not in fname:
            continue
        if (today - date.fromisoformat(rec["date"])).days > FAILURE_LOOKBACK_DAYS:
            continue
        try:
            code = open(os.path.join(os.path.dirname(UTILS), fname)).read()
        except OSError:
            code = ""
        if len(code) > 4500:
            code = code[:2500] + "\n# ... (elided) ...\n" + code[-2000:]
        out.append((rec, fname, code))
    return out


def failure_analysis(failures, nodes, problems):
    """The once-a-day judgment call: turn recent failures into consolidation
    items. Cached by being written into the plan file."""
    digests = []
    for rec, fname, code in failures:
        pnum = rec.get("problem", "?")
        title = problems.get(pnum, {}).get("title", "")
        moves = rec.get("moves", {})
        digests.append(f"--- FAILED {rec['date']}: {pnum}. {title}\n"
                       f"evidenced moves: {json.dumps(moves)}\n{code}")
    banked = sorted(n for n in nodes if has_drill_bank(n))
    system = f"""You are a training coach turning a leetcode learner's recent FAILED attempts into a short consolidation plan.

Taxonomy of technique moves (use ONLY these ids):
{taxonomy_summary(nodes)}

Nodes that already have a drill bank: {', '.join(banked)}

For each failure decide what converts it into a wired skill:
- a re-attempt of the same problem, unaided, once enough days passed ("consolidate")
- reps on an EXISTING drill bank ("drill")
- a NEW drill worth creating because the bank lacks the rung ("create_drill") — say exactly what the rung trains, in 1-2 sentences

Rules:
- Diagnose from the code: recognition (did not see the technique), mechanics (saw it, could not execute), or endurance. A blank file is recognition; near-working code is mechanics.
- Do NOT prescribe a fresh new Hard.
- In every "note"/"spec"/"why" text: never reveal a technique the operator's own failed code or notes did not already use or name. Recognizing the move is his rep. Drill node ids are overt (drills are named by what they train) — but a note attached to a PROBLEM re-attempt must not name the move unless his own file already names it.
- At most 4 items total. Deduplicate: one item per wound.

Output STRICT JSON, nothing else:
{{"consolidate": [{{"problem": "<num>", "note": "<non-spoiling one-liner>", "why": "<diagnosis>"}}],
 "drills": [{{"node": "<node-id>", "why": "<diagnosis>"}}],
 "create_drills": [{{"node": "<node-id>", "spec": "<what the new rung trains>", "why": "<diagnosis>"}}]}}"""
    return claude_json("Recent failures:\n\n" + "\n\n".join(digests), system)


def review_items(nodes, problems, evidence, statuses, taken):
    """Rules 1-2 targets with their carriers, capped — the plan's spaced-review
    slice, not the whole frontier."""
    unl = unlocks(statuses, problems)
    rusty = sorted((n for n in nodes if statuses[n][0] in (FRAGILE, STALE)),
                   key=lambda n: (-unl.get(n, 0), statuses[n][1]))
    items = []
    for target in rusty:
        if len(items) >= MAX_REVIEWS:
            break
        if drill_gated(target, *statuses[target]):
            items.append({"kind": "drill", "node": target,
                          "why": "rusty move with a drill bank — drill until clean"})
            continue
        cands = [c for c in carriers_for(target, problems, statuses, nodes)
                 if c not in taken]
        if not cands:
            continue
        cands.sort(key=lambda p: (gentleness(p, problems, nodes),
                                  last_solved(p, evidence), -acceptance(p), pnum_key(p)))
        items.append({"kind": "review", "problem": cands[0], "target": target,
                      "why": "spaced review of a rusty move"})
        taken.add(cands[0])
    return items


def main():
    parser = argparse.ArgumentParser(description="Freeze today's study plan.")
    parser.add_argument("--force", action="store_true",
                        help="rebuild even if today's plan exists")
    args = parser.parse_args([a for a in sys.argv[1:] if a != "today"])

    path = plan_path()
    if os.path.exists(path) and not args.force:
        plan = json.load(open(path))
        console.print(f"[dim]plan for {plan['date']} already exists "
                      f"({len(plan['items'])} items) — `make next` serves it; "
                      f"--force to rebuild[/dim]")
        return

    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()
    statuses = {n: node_status(n, evidence) for n in nodes}
    asleep, _ = sleep_state(load_sleep(), evidence)
    kn = _kg_next()

    items = []
    taken = set(asleep)

    # warmups — the same two the session-start rule would serve
    for pnum in kn.trivial_easies(problems, nodes, evidence, statuses)[:2]:
        items.append({"kind": "warmup", "problem": pnum,
                      "why": "session start — juice, not training"})
        taken.add(pnum)

    # reviews — capped slice of the rusty frontier
    items += review_items(nodes, problems, evidence, statuses, taken)

    # failure consolidation — the one claude call, frozen into the file
    failures = recent_failures(evidence)
    analysis = {}
    if failures:
        console.print(f"[dim]Reading {len(failures)} recent failure(s) — "
                      "one claude call, frozen into the plan...[/dim]")
        try:
            analysis = failure_analysis(failures, nodes, problems)
        except Exception as exc:
            console.print(f"[red]failure analysis unavailable ({exc}); "
                          "plan proceeds without consolidation items[/red]")
    for it in analysis.get("consolidate", []):
        if str(it.get("problem")) not in taken:
            items.append({"kind": "consolidate", "problem": str(it["problem"]),
                          "note": it.get("note", ""), "why": it.get("why", "")})
            taken.add(str(it["problem"]))
    for it in analysis.get("drills", []):
        if it.get("node") in nodes:
            items.append({"kind": "drill", "node": it["node"],
                          "why": it.get("why", "")})
    for it in analysis.get("create_drills", []):
        if it.get("node") in nodes:
            items.append({"kind": "create-drill", "node": it["node"],
                          "spec": it.get("spec", ""), "why": it.get("why", "")})

    # new ground — only when the day is not already spoken for
    if not any(i["kind"] in ("consolidate", "create-drill") for i in items):
        choice = kn.pick(nodes, problems, evidence, statuses,
                         asleep=asleep, exclude=taken)
        if choice and not str(choice[2]).startswith("drill:"):
            target, _, pnum, reason = choice
            if "new" in reason or "summit" in reason:
                items.append({"kind": "new", "problem": pnum, "why": reason})

    os.makedirs(PLAN_DIR, exist_ok=True)
    plan = {"date": date.today().isoformat(),
            "generated": datetime.now().isoformat(timespec="seconds"),
            "items": items}
    with open(path, "w") as f:
        json.dump(plan, f, indent=2)

    counts = {}
    for it in items:
        counts[it["kind"]] = counts.get(it["kind"], 0) + 1
    summary = ", ".join(f"{v} {k}" for k, v in counts.items()) or "empty"
    console.print(f"[bold]plan for {plan['date']}[/bold]: {summary}")
    console.print("[dim]`make next` now serves it, in order.[/dim]")


if __name__ == "__main__":
    main()
