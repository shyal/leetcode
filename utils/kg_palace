JS = """
(function(){
  var LESS='\\u2212 fewer';
  function setBtn(b, open){
    var rest=b.parentElement.querySelector('.rest');
    b.setAttribute('aria-expanded', open);
    b.textContent = open ? LESS : '+'+rest.childElementCount+' more';
  }
  document.addEventListener('click', function(e){
    var b=e.target.closest('button.prob-more'); if(!b) return;
    var rest=b.parentElement.querySelector('.rest');
    setBtn(b, rest.classList.toggle('open'));
  });
  var all=document.getElementById('toggle-all');
  if(all) all.addEventListener('click', function(){
    var opening = all.dataset.state!=='open';
    document.querySelectorAll('.rest').forEach(function(r){ r.classList.toggle('open', opening); });
    document.querySelectorAll('button.prob-more').forEach(function(b){ setBtn(b, opening); });
    all.dataset.state = opening?'open':'closed';
    all.textContent = opening?'collapse all stations':'expand all stations';
  });
})();
"""


def main():
    nodes = load_nodes()           # id -> node, in nodes.json order
    problems = load_problems()     # num -> meta, in problems.json order
    evidence = load_evidence()
    palace = load_palace()
    solved = solved_set()
    lc_meta = load_lc_metadata()
    room_meta = {r["group"]: r for r in palace["rooms"]}
    loci = palace["loci"]

    carriers = {nid: [] for nid in nodes}
    for num, meta in problems.items():
        for move in meta["moves"]:
            if move in carriers:
                carriers[move].append((num, meta))

    missing_loci = [nid for nid in nodes if nid not in loci]
    if missing_loci:
        print(f"WARNING: no locus for {missing_loci} — add images to graph/palace.json")

    rooms, no = [], 0
    for i, group in enumerate(ROUTE, 1):
        stations = []
        for node in (n for n in nodes.values() if n["group"] == group):
            no += 1
            status, _ = node_status(node["id"], evidence)
            stations.append({"no": no, "node": node, "status": status})
        rooms.append({"index": i, "group": group, "stations": stations,
                      "name": room_meta[group]["name"], "flavor": room_meta[group]["flavor"]})

    all_statuses = [s["status"] for r in rooms for s in r["stations"]]
    counts = Counter(all_statuses)
    plan = floor_plan([{**r, "stations": [(s["no"], s["node"]["name"], s["status"])
                                          for s in r["stations"]]} for r in rooms])

    sections = []
    for room in rooms:
        cards = []
        for s in room["stations"]:
            node, status = s["node"], s["status"]
            locus = loci.get(node["id"], {"image": node["desc"], "trigger": node["desc"]})
            cards.append(f'''<article class="card st-{status.lower()}">
  <header><span class="card-no">{s["no"]}</span>
    <h4>{esc(node["name"])}</h4>
    {status_chip(status)}
  </header>
  <p class="image">{locus["image"]}</p>
  <p class="trigger"><span class="lbl">Trigger</span>{locus["trigger"]}</p>
  {probs_para(carriers[node["id"]], solved, lc_meta)}
</article>''')
        sections.append(f'''<section id="room-{room["index"]}" class="room-section">
  <header class="room-header">
    <span class="room-index">Room {room["index"]}</span>
    <h3>{esc(room["name"])}</h3>
    <p class="flavor">{room["flavor"]} <span class="room-sum">{sum_phrase([s["status"] for s in room["stations"]])}</span></p>
  </header>
  <div class="cards">{"".join(cards)}</div>
</section>''')

    today = date.today().isoformat()
    page = f'''<title>The Technique Palace</title>
<style>{CSS}</style>
<div class="wrap">
  <p class="eyebrow">Method of loci · leetcode technique graph</p>
  <h1>The Technique Palace</h1>
  <p class="lede">Thirteen rooms off one corridor, one station per atomic move — built from
  <code>graph/nodes.json</code>, lit by <code>graph/evidence.json</code>. Walk it in order;
  the route never changes.</p>
  <p class="method"><b>How to use it:</b> when a problem appears, find the <b>room</b> first
  (what kind of question is this?), then the <b>station</b> (which move answers it). Each
  station has a fixed image to hang the move on, and its trigger — the cue that should fire
  it. Problem numbers carry their Major-system consonant skeleton
  (<span class="prob" style="font-size:11px"><b>217</b><i>N·T·K</i></span>) so you can peg
  the canonical exemplars; 6 = J/SH/CH, 7 = K/G, 9 = P/B, as usual.</p>
  <div class="statline">
    <span><strong>{len(all_statuses)}</strong> stations</span><span><strong>{len(rooms)}</strong> rooms</span>
    <span><strong>{counts["SOLID"]}</strong> lit (solid)</span> <span><strong>{counts["STALE"]}</strong> dusty (stale)</span> <span><strong>{counts["FRAGILE"]}</strong> flickering (fragile)</span> <span><strong>{counts["MISSING"]}</strong> dark (missing)</span>
  </div>
  <div class="legend">
    <span class="chip chip-solid"><span class="chip-dot"></span>solid · lit</span>
    <span class="chip chip-stale"><span class="chip-dot"></span>stale · dusty</span>
    <span class="chip chip-fragile"><span class="chip-dot"></span>fragile · flickering</span>
    <span class="chip chip-missing"><span class="chip-dot"></span>missing · dark</span>
    <span>Lighting is derived from solve evidence, never stored — clean within ~6 weeks burns bright.</span>
  </div>
  <div class="legend">
    <span>Every station now carries its full problem list: <b>+N more</b> unfolds it.
    A dashed problem chip is unsolved; <span class="dif dif-E">E</span>/<span class="dif dif-M">M</span>/<span class="dif dif-H">H</span> is difficulty.</span>
    <button id="toggle-all" class="linklike" data-state="closed">expand all stations</button>
  </div>
  <figure>
    <div class="plan-scroll">{plan}</div>
    <figcaption>The floor plan. Click a room to walk to it. Half-filled dots have gone dusty;
    flickering outlines were struggled with or solved only once; dashed outlines are unlit.</figcaption>
  </figure>
  {"".join(sections)}
  <footer class="colophon">
    Generated from the technique graph on {today} by <code>utils/kg_palace</code>.
    Statuses re-derive from <code>evidence.json</code> each time this page is rebuilt —
    the palace is a map of the territory, not the territory: knowing the room is not the
    same as walking it cleanly. Rebuild after a session to watch rooms light up.
  </footer>
</div>
<script>{JS}</script>
'''

    out_path = os.path.join(GRAPH_DIR, "palace.html")
    with open(out_path, "w") as f:
        f.write(page)
    lit = " · ".join(f"{counts[s]} {STATUS_WORD[s]}" for s in STATUS_ORDER)
    print(f"wrote {os.path.relpath(out_path)} — {len(all_statuses)} stations, {lit}")


if __name__ == "__main__":
    main()
