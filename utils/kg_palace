#!/usr/bin/env python3

# kg_palace — rebuild the Technique Palace (method-of-loci HTML) from the graph.
#
#   PYTHONPATH=./utils python3 utils/kg_palace          # writes graph/palace.html
#
# Layout is generated from graph/nodes.json (rooms = groups along the fixed
# route, stations = moves); hand-crafted loci (room names/flavor, station
# images/triggers) live in graph/palace.json and are never invented here.
# Lighting derives from evidence.json via kg_lib.node_status at build time.
# Each station lists every carrier problem: four exemplar pegs visible, the
# rest behind a "+N more" toggle, marked with difficulty and solved state.
#
# Publish: the page is the artifact "The Technique Palace" — republish the
# generated file to the same artifact URL to update it in place.

import html
import json
import os
import re
from collections import Counter
from datetime import date

from kg_lib import GRAPH_DIR, load_nodes, load_problems, load_evidence, node_status

ROUTE = [
    "containers", "streaming", "index-order", "pointers-windows", "stack-queue",
    "linked-lists", "binary-search", "trees", "graphs", "recursion-dp",
    "heaps-greedy", "bits-math", "strings",
]
ROW_SPLIT = 7          # rooms 1..7 on the top row of the floor plan
EXEMPLARS = 4          # carrier chips visible before the "+N more" toggle

STATUS_WORD = {"SOLID": "lit", "STALE": "dusty", "FRAGILE": "flickering", "MISSING": "dark"}
STATUS_ORDER = ["SOLID", "STALE", "FRAGILE", "MISSING"]
MAJOR = "STNMRLJKFP"   # digit -> Major-system consonant


def esc(s):
    return html.escape(s, quote=True)


def skeleton(num):
    return "·".join(MAJOR[int(d)] for d in str(num) if d.isdigit())


def solved_set():
    solved_dir = os.path.join(os.path.dirname(GRAPH_DIR), "solved")
    out = set()
    for f in os.listdir(solved_dir):
        m = re.match(r"p(\w+?)_", f)
        if m:
            out.add(m.group(1))
    return out


def load_palace():
    with open(os.path.join(GRAPH_DIR, "palace.json")) as f:
        return json.load(f)


def load_lc_metadata():
    path = os.path.join(os.path.dirname(GRAPH_DIR), "data/problems_metadata.json")
    if not os.path.exists(path):
        return {}
    with open(path) as f:
        return json.load(f)


def difficulty(num, meta, lc_meta):
    if meta.get("difficulty"):
        return meta["difficulty"]
    # fall back to the leetcode metadata cache, but only when the title agrees —
    # problems.json also holds Codeforces entries whose numbers collide with LC ids
    cached = lc_meta.get(str(num))
    if cached and cached["title"].lower() == meta["title"].lower():
        return cached["difficulty"]
    return ""


def prob_chip(num, meta, solved, lc_meta):
    dif = difficulty(num, meta, lc_meta)[:1]
    cls = "prob" if num in solved else "prob prob-un"
    bits = [f"<b>{esc(str(num))}</b>", f"<i>{skeleton(num)}</i>", esc(meta["title"])]
    if dif:
        bits.append(f'<span class="dif dif-{dif}">{dif}</span>')
    return f'<span class="{cls}">{"".join(bits)}</span>'


def probs_para(carriers, solved, lc_meta):
    head = [prob_chip(n, m, solved, lc_meta) for n, m in carriers[:EXEMPLARS]]
    rest = [prob_chip(n, m, solved, lc_meta) for n, m in carriers[EXEMPLARS:]]
    out = "".join(head)
    if rest:
        out += f'<span class="rest">{"".join(rest)}</span>'
        out += (f'<button class="prob prob-more" aria-expanded="false">'
                f"+{len(rest)} more</button>")
    return f'<p class="probs">{out}</p>'


def status_chip(status):
    word = STATUS_WORD[status]
    return (f'<span class="chip chip-{status.lower()}"><span class="chip-dot"></span>'
            f"{status.lower()} · {word}</span>")


def sum_phrase(statuses):
    counts = Counter(statuses)
    parts = [f"{counts[s]} {STATUS_WORD[s]}" for s in STATUS_ORDER if counts[s]]
    return f"{len(statuses)} stations — " + " · ".join(parts)


def station_dot(cx, cy, no, name, status):
    cx = f"{cx:g}"
    title = f"<title>{no}. {esc(name)} — {status.lower()} ({STATUS_WORD[status]})</title>"
    if status == "SOLID":
        return f'<circle cx="{cx}" cy="{cy}" r="6" class="g-solid">{title}</circle>'
    if status == "STALE":
        return (f'<g class="g-stale"><circle cx="{cx}" cy="{cy}" r="6" fill="none"/>'
                f'<path d="M {float(cx) - 6:g} {cy} A 6 6 0 0 1 {float(cx) + 6:g} {cy} Z"/>{title}</g>')
    cls = "g-fragile" if status == "FRAGILE" else "g-missing"
    return f'<circle cx="{cx}" cy="{cy}" r="5.5" class="{cls}">{title}</circle>'


def floor_plan(rooms):
    # rooms: list of dicts {index, name, group, stations: [(no, name, status)]}
    col_width = {4: 172, 3: 142, 2: 112, 1: 96}
    placed, x = [], 24
    for i, room in enumerate(rooms):
        if i == ROW_SPLIT:
            x = 24
        cols = -(-len(room["stations"]) // 2)  # ceil
        w = col_width[cols]
        y = 24 if i < ROW_SPLIT else 246
        placed.append((room, x, y, w, cols))
        x += w + 16
    vbw = max(x + w + 24 for _, x, y, w, _ in placed if y == 24)

    route_pts = [f"M 10 103"]
    route_pts += [f"L {x + w / 2:g} 103" for _, x, y, w, _ in placed if y == 24]
    route_pts += [f"L {vbw - 20} 103", f"L {vbw - 20} 325"]
    route_pts += [f"L {x + w / 2:g} 325" for _, x, y, w, _ in reversed(placed) if y == 246]
    route_pts += ["L 10 325"]

    svg = [f'<svg viewBox="0 0 {vbw} 428" role="img" '
           f'aria-label="Palace floor plan: {len(rooms)} rooms along a snaking route" '
           f'xmlns="http://www.w3.org/2000/svg">',
           f'  <path d="{" ".join(route_pts)}" class="route"/>']
    for room, x, y, w, cols in placed:
        cx = x + w / 2
        svg.append(f'  <a href="#room-{room["index"]}" class="room-link">\n'
                   f'  <rect x="{x}" y="{y}" width="{w}" height="158" rx="7" class="room"/>\n'
                   f'  <circle cx="{x + 20}" cy="{y + 22}" r="11" class="room-num-bg"/>\n'
                   f'  <text x="{x + 20}" y="{y + 26.5}" class="room-num">{room["index"]}</text>\n'
                   f'  <text x="{cx:g}" y="{y + 50}" class="room-name">{esc(room["name"].removeprefix("The "))}</text>\n'
                   f'  <text x="{cx:g}" y="{y + 68}" class="room-id">{room["group"]}</text>')
        dots = []
        for j, (no, name, status) in enumerate(room["stations"]):
            dx = cx - (cols - 1) * 15 + (j % cols) * 30
            dy = y + 100 + (j // cols) * 24
            dots.append(station_dot(dx, dy, no, name, status))
        svg.append("  " + "".join(dots) + "\n</a>")
    svg.append(f'  <text x="{vbw / 2:g}" y="218.0" class="corridor-label">'
               f"— the corridor · walk 1 → {len(rooms)} —</text>")
    svg.append("</svg>")
    return "\n".join(svg)


