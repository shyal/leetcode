#!/usr/bin/env python3

# kg_sleep — park the problem you are blocked on; face it when the ground
# is ready.
#
#   make sleep            # mid-exercise: parks the problem on the current branch
#   make sleep 108        # park an explicit problem (its branch must exist)
#   make wake 108         # resume a parked problem on its own branch
#   make sleep -- --list  # show park state (also printed by kg_status)
#
# A parked problem IS its `<num>-slept` branch — no metadata file. Parking
# commits the WIP with a `sleeping:` marker, renames the branch, and returns
# you to master; waking renames it back and stamps a `woke:` marker, so the
# branch history carries every park/resume cycle and `make solved` can report
# the true active solve time (awake intervals only, kg_lib.active_seconds).
#
# There are no timers. A parked problem wakes when it is READY — every move
# in its walk closure is SOLID, the picker having warmed the rusty ones
# meanwhile (kg_next rule 0) — or under CAP PRESSURE: at most
# kg_lib.MAX_ASLEEP problems may hide at once, and the oldest parks are
# forced awake past that. Park an (N+1)th and you must face one.
#
# Sleep when you are looping — no new idea in ~15 minutes — not when you are
# merely uncomfortable; discomfort means retrieval is working.

import argparse
import subprocess
import sys
from datetime import datetime

from kg_lib import (
    load_nodes, load_problems, load_evidence, node_status, input_tree,
    active_seconds, sleep_records, sleep_state, slept_branches,
    MAX_ASLEEP, SOLID,
)


def git(*cmd, check=True):
    return subprocess.run(["git", *cmd], check=check, capture_output=True, text=True)


def current_branch():
    return git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()


def branch_exists(name):
    return git("rev-parse", "--verify", "--quiet", "refs/heads/" + name,
               check=False).returncode == 0


def hm(secs):
    h, m = divmod(int(secs) // 60, 60)
    return f"{h}h {m:02d}m" if h else f"{m}m"


def show_list(nodes, problems, evidence):
    recs = sleep_records(problems, evidence)
    if not recs:
        print("nothing parked")
        return
    asleep, woken = sleep_state(nodes, problems, evidence)
    statuses = {n: node_status(n, evidence) for n in nodes}
    for pnum in asleep + woken:
        rec = recs[pnum]
        since = datetime.fromtimestamp(rec["slept"]).isoformat(timespec="minutes")
        cycles = f", slept x{rec['cycles']}" if rec["cycles"] > 1 else ""
        if pnum in woken:
            print(f"{pnum}. {rec['title']} — AWAKE (make wake {pnum}) "
                  f"— parked {since}{cycles}")
        else:
            rusty = sorted(n for n in input_tree(problems[pnum]["moves"], nodes)
                           if statuses[n][0] != SOLID)
            print(f"{pnum}. {rec['title']} — asleep, blocked on: "
                  f"{', '.join(rusty) or '?'} — parked {since}{cycles}")


def wake(args, nodes, problems, evidence):
    pnum = args.problem
    if not pnum:
        _, woken = sleep_state(nodes, problems, evidence)
        if len(woken) != 1:
            sys.exit("which one? make wake <problem>")
        pnum = woken[0]
    branch = f"{pnum}-slept"
    if not branch_exists(branch):
        sys.exit(f"no parked branch {branch}")
    if current_branch() != "master":
        sys.exit(f"wake from master (you are on {current_branch()})")
    title = problems.get(pnum, {}).get("title", "?")
    git("branch", "-M", branch, pnum)
    git("checkout", pnum)
    git("commit", "--allow-empty", "-m", f"woke: {pnum}. {title}")
    active, slept, sleeps = active_seconds(pnum)
    print(f"{pnum}. {title} is awake on branch {pnum} — "
          f"{hm(active)} fought so far, {hm(slept)} slept over {sleeps} park(s). "
          "make solved / make sleep as usual.")


def park(args, nodes, problems, evidence):
    branch = current_branch()
    pnum = args.problem or (branch if branch in problems else None)
    if pnum is None or pnum not in problems:
        sys.exit(f"can't tell which problem to sleep (branch {branch!r}); "
                 "pass one: make sleep 108")
    if branch_exists(f"{pnum}-slept") and pnum in sleep_records(problems, evidence):
        sys.exit(f"{pnum} is already parked")

    title = problems[pnum]["title"]
    if branch == pnum:
        fought = active_seconds(pnum)[0]
        # park ONLY current.py on the branch. Other bystander files stay in
        # the working tree — sweeping them onto the parked branch would strip
        # them from master's checkout. --allow-empty: the sleeping commit is
        # the park timestamp even when current.py is already committed.
        git("add", "current.py")
        git("commit", "--allow-empty", "-m", f"sleeping: {pnum}. {title}")
        git("branch", "-M", pnum, f"{pnum}-slept")
        git("checkout", "master")
        print(f"WIP parked on branch {pnum}-slept ({hm(fought)} fought); "
              "back on master.")
    elif branch_exists(pnum):
        # park an attempt whose branch exists but isn't checked out: stamp
        # the marker on it, rename, come back to where we were
        git("checkout", pnum)
        git("commit", "--allow-empty", "-m", f"sleeping: {pnum}. {title}")
        git("branch", "-M", pnum, f"{pnum}-slept")
        git("checkout", branch)
        print(f"branch {pnum} parked as {pnum}-slept.")
    else:
        sys.exit(f"no attempt to park — no branch {pnum}. "
                 f"Parking marks what you are BLOCKED on; start it first "
                 f"(make prepare {pnum}).")

    asleep, woken = sleep_state(nodes, problems, evidence)
    forced = [p for p in woken if p in slept_branches()
              and not_ready_but_woken(p, nodes, problems, evidence)]
    if forced:
        p = forced[0]
        print(f"cap ({MAX_ASLEEP}) reached — {p}. "
              f"{problems.get(p, {}).get('title', '?')} is forced awake: face it "
              f"(make wake {p}).")

    statuses = {n: node_status(n, evidence) for n in nodes}
    rusty = [n for n in input_tree(problems[pnum]["moves"], nodes)
             if statuses[n][0] != SOLID]
    print(f"{pnum}. {title} sleeps until its ground is ready.")
    print("kg_next will warm meanwhile: " + (", ".join(sorted(rusty)) if rusty
          else "nothing — its walk is already solid; the simmer alone is the treatment"))


def not_ready_but_woken(pnum, nodes, problems, evidence):
    statuses = {n: node_status(n, evidence) for n in nodes}
    return any(statuses.get(n, (None,))[0] != SOLID
               for n in input_tree(problems[pnum]["moves"], nodes))


def main():
    parser = argparse.ArgumentParser(
        description="Park the current problem until its ground is ready.")
    parser.add_argument("problem", nargs="?", help="problem number (default: current branch)")
    parser.add_argument("--wake", action="store_true", help="resume a parked problem")
    parser.add_argument("--list", action="store_true", help="show park state and exit")
    args = parser.parse_args()

    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()

    if args.list:
        show_list(nodes, problems, evidence)
    elif args.wake:
        wake(args, nodes, problems, evidence)
    else:
        park(args, nodes, problems, evidence)


if __name__ == "__main__":
    main()
