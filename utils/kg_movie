#!/usr/bin/env python3

# kg_movie — animate the technique graph's history into graph/kg.mp4.
#
#   make movie                 # render + report
#   make movie 10              # render the whole history into 10 seconds
#   utils/kg_movie --open      # render + open the mp4
#
# Statuses are derived, never stored, so the graph's state on any historical
# date is just node_status() over the evidence recorded up to that date.
# Date ticks are every evidence date plus weekly ticks between them — the
# weekly ticks are what make decay visible: watch rooms dim to stale when
# solving stops, not only light up when it resumes. Nodes whose status
# changed since the previous tick get a bright border.
#
# Each solve flashes its problem number in gold next to every move its walk
# exercised, then fades over ~2s. Solves replay in true within-day order
# (filename timestamps, second granularity), staggered across the day's
# tick — a marathon day is a cascade, not a burst.
#
# Screen time is paced by solves, not by the calendar (--pace calendar for the
# old behaviour): a tick's share of the runtime is proportional to how many
# solves it carries, so the event rate stays roughly constant instead of
# tracking how bursty the work actually was. Marathon days stretch out enough
# to read; a 100-day dry spell still dims and still reads as a gap, but takes
# a moment rather than half the film. The tail dissolves back into the opening
# frame instead of freezing, so the GIF loops without dead frames at the seam.
# Label placement is chosen at spawn from ~20 candidate spots around the
# node, overlapping NOTHING graphviz drew — nodes, edges, cluster borders
# and titles, the header — nor any still-fading label; the spot is pinned
# for the label's lifetime so nothing jumps between frames.

import argparse
import json
import os
import struct
import subprocess
import tempfile
from collections import Counter, defaultdict
from datetime import date, timedelta

from PIL import Image, ImageDraw, ImageFont

from kg_lib import GRAPH_DIR, load_nodes, load_evidence, node_status
from kg_render import make_digraph, status_node, add_legend

FPS_OUT = 25       # output framerate
END_FADE_S = 1.2   # dissolve from the final state back to the opening frame
DPI = 144

DEFAULT_SECONDS = 50  # fixed, so the movie stops growing as history does
TICK_DAYS = 1      # gap between interpolated date ticks — daily keyframes
TARGET_FPS = 60    # what we aim for when a total duration is requested
MAX_FPS = 120      # past this a "movie" is a blur nothing can play properly
GOP_S = 0.5        # seconds between encoded keyframes, so scrubbing lands close
LABEL_LIFE_FRACTION = 0.04  # label fade as a share of runtime (2s in a 50s cut)
FADE_FRACTION = 0.08  # loop-closing dissolve shrinks with short movies
LULL_WEIGHT = 0.25  # screen time a solve-less day gets, in units of one solve

GOLD = (255, 215, 95)
LABEL_LIFE_S = 2.0                 # solve labels fade over this long
LABEL_PT = 19
LABEL_GAP = 6                      # px between a node box and its label
LABEL_FONT = "/System/Library/Fonts/Menlo.ttc"
MAX_PROBS = 3                      # per node per day; the rest become "+k"


def frame_dates(evidence, tick_days=TICK_DAYS):
    """Every solve date, plus a tick every `tick_days` between them.

    The in-between ticks are what make decay visible — the graph dims on days
    nothing was solved. Denser ticks mean more distinct states, so a dry spell
    fades gradually instead of stepping down once a week.
    """
    solve_days = sorted({r["date"] for r in evidence.values()})
    first, last = date.fromisoformat(solve_days[0]), date.fromisoformat(solve_days[-1])
    days = {first - timedelta(days=1)}  # opening frame: the dark graph
    days.update(date.fromisoformat(d) for d in solve_days)
    tick = first
    while tick < last:
        days.add(tick)
        tick += timedelta(days=tick_days)
    return sorted(days)


def statuses_asof(nodes, evidence, day):
    upto = {f: r for f, r in evidence.items() if r["date"] <= day.isoformat()}
    return {n: node_status(n, upto, today=day) for n in nodes}


def png_size(path):
    with open(path, "rb") as f:
        f.seek(16)
        return struct.unpack(">II", f.read(8))


def build_graph(nodes, statuses, changed, title):
    dot = make_digraph("kg-frame", title=title)
    dot.graph_attr["dpi"] = str(DPI)
    dot.node_attr["penwidth"] = "2"  # constant width so highlights don't shift layout

    groups = defaultdict(list)
    for node_id, node in nodes.items():
        groups[node["group"]].append(node_id)
    for group, members in groups.items():
        with dot.subgraph(name=f"cluster_{group}") as c:
            c.attr(label=group, fontcolor="#8b949e", color="#30363d",
                   style="rounded", fontname="Helvetica")
            for node_id in members:
                status, when = statuses[node_id]
                status_node(c, node_id, nodes[node_id], status, when,
                            highlight=node_id in changed)
    for node_id, node in nodes.items():
        for prereq in node.get("prereqs", []):
            if prereq in nodes:
                dot.edge(prereq, node_id)
    add_legend(dot)
    return dot


def layout_geometry(dot, png_wh):
    """One layout pass -> (node boxes, weighted obstacle rects) in pixel space.

    Obstacles cover everything graphviz draws: node boxes (legend included),
    cluster borders and titles, the header line, and every edge spline
    rasterized into a corridor of small rects. Weights let the fallback
    scoring prefer grazing a thin edge over covering text if no spot is free.
    """
    layout = json.loads(dot.pipe(format="json").decode())
    bb = [float(v) for v in layout["bb"].split(",")]
    pad = 4.0  # graphviz default margin, in points
    pw, ph = png_wh
    sx, sy = pw / (bb[2] + 2 * pad), ph / (bb[3] + 2 * pad)

    def tf(x, y):
        return (x + pad) * sx, ph - (y + pad) * sy

    boxes, obstacles = {}, []

    def add_text_ops(obj, weight):
        for op in obj.get("_ldraw_", []):
            if op.get("op") == "T":
                x, y = tf(*op["pt"])
                w = op["width"] * sx
                h = 16 * sy  # about a line of the 14-16pt graphviz label fonts
                x0 = x - w / 2 if op.get("align") == "c" else x
                obstacles.append(((x0, y - h, x0 + w, y + 3), weight))

    add_text_ops(layout, 5)  # the graph title / stat line
    for obj in layout.get("objects", []):
        name = obj.get("name", "")
        if name.startswith("cluster"):
            cx0, cy1 = tf(*(float(v) for v in obj["bb"].split(",")[:2]))
            cx1, cy0 = tf(*(float(v) for v in obj["bb"].split(",")[2:]))
            for strip in (  # the four rounded-border lines, as thin rects
                (cx0 - 2, cy0 - 2, cx1 + 2, cy0 + 2), (cx0 - 2, cy1 - 2, cx1 + 2, cy1 + 2),
                (cx0 - 2, cy0 - 2, cx0 + 2, cy1 + 2), (cx1 - 2, cy0 - 2, cx1 + 2, cy1 + 2),
            ):
                obstacles.append((strip, 2))
            add_text_ops(obj, 5)
            continue
        if "pos" not in obj or "," not in obj.get("pos", ""):
            continue
        x, y = (float(v) for v in obj["pos"].split(","))
        w, h = float(obj["width"]) * 72 * sx, float(obj["height"]) * 72 * sy
        cx, cy = tf(x, y)
        box = (cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2)
        boxes[name] = box
        obstacles.append((box, 5))  # legend nodes included — they're drawn too

    for edge in layout.get("edges", []):
        pts = []
        for tok in edge.get("pos", "").split():
            if tok[:2] in ("e,", "s,"):
                tok = tok[2:]
            ex, ey = (float(v) for v in tok.split(","))
            pts.append(tf(ex, ey))
        for (ax, ay), (bx_, by_) in zip(pts, pts[1:]):
            steps = max(1, int(((bx_ - ax) ** 2 + (by_ - ay) ** 2) ** 0.5 // 14))
            for k in range(steps + 1):
                mx, my = ax + (bx_ - ax) * k / steps, ay + (by_ - ay) * k / steps
                obstacles.append(((mx - 4, my - 4, mx + 4, my + 4), 1))

    return boxes, obstacles


def solves_by_day(evidence):
    """date -> [(problem, moves)] in true within-day solve order.

    Order comes from the filename timestamps (second granularity). Even the
    migration-stamped files preserve their original sequence in the
    microseconds, so marathon days replay in the order they happened.
    """
    import re

    by_day = defaultdict(list)  # date -> [(ts, problem, moves)]
    for fname, rec in evidence.items():
        p = rec.get("problem", "")
        if not p or not p[0].isdigit():
            continue  # drills and misc entries carry no leetcode number
        m = re.search(r"\d{4}_\d{2}_\d{2}T[\d_]+", fname)
        by_day[rec["date"]].append((m.group(0) if m else "", p, list(rec.get("moves", {}))))
    out = {}
    for day, rows in by_day.items():
        rows.sort()
        seen, ordered = set(), []
        for _, p, moves in rows:
            if p not in seen:  # a same-day re-solve flashes once
                seen.add(p)
                ordered.append((p, moves))
        out[day] = ordered
    return out


def overlaps(a, b):
    return a[0] < b[2] and b[0] < a[2] and a[1] < b[3] and b[1] < a[3]


def candidate_spots(node_box, w, h):
    """Positions to try around a node: above > below > right > left, each with
    center/left/right (or top/bottom) alignments, then a farther second ring."""
    x0, y0, x1, y1 = node_box
    cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
    g = LABEL_GAP
    xs = (cx - w / 2, x0, x1 - w)
    spots = [(x, y0 - g - h) for x in xs] + [(x, y1 + g) for x in xs]
    spots += [(x1 + g, y) for y in (cy - h / 2, y0, y1 - h)]
    spots += [(x0 - g - w, y) for y in (cy - h / 2, y0, y1 - h)]
    for ring in (20, 40):
        spots += [(cx - w / 2, y0 - g - h - ring), (cx - w / 2, y1 + g + ring),
                  (x1 + g + ring, cy - h / 2), (x0 - g - w - ring, cy - h / 2)]
    return spots


def place_label(node_box, block_options, obstacles, taken):
    """Pick (rect, texts, line_h) touching nothing; least-weighted-overlap fallback.

    block_options are (texts, (w, h), line_h) variants — vertical stack first,
    single-line second. taken are rectangles of labels still fading: a dying
    label keeps its ground until it is gone.
    """
    x0, y0, x1, y1 = node_box
    vicinity = (x0 - 260, y0 - 260, x1 + 260, y1 + 260)
    obstacles = [o for o in obstacles if overlaps(o[0], vicinity)]
    weighted_taken = [(r, 5) for r in taken if overlaps(r, vicinity)]
    best, best_bad = None, None
    for texts, (w, h), line_h in block_options:
        for lx, ly in candidate_spots(node_box, w, h):
            rect = (lx, ly, lx + w, ly + h)
            bad = sum(((min(r[2], rect[2]) - max(r[0], rect[0])) *
                       (min(r[3], rect[3]) - max(r[1], rect[1]))) * wt
                      for r, wt in obstacles + weighted_taken if overlaps(rect, r))
            if bad == 0:
                return rect, texts, line_h
            if best_bad is None or bad < best_bad:
                best, best_bad = (rect, texts, line_h), bad
    return best


def label_alpha(age_s):
    if age_s < 0:
        return 0  # not born yet — spawns are staggered within a tick
    t = age_s / LABEL_LIFE_S
    return 0 if t >= 1 else int(255 * (1 - t) ** 1.4)


def pace_weights(days, by_day, pace):
    """Screen time each date tick deserves, in units of "one solve".

    Calendar pacing gives every day an equal slice, so runtime tracks the
    calendar: a 100-day dry spell costs 100 days of film and the movie stalls
    in the middle of a history that is bursty in real life. Solve pacing
    weights a tick by the solves it carries plus a small floor, so the event
    rate is roughly constant — bursts stretch out enough to read, dry spells
    compress to a brief dim that still registers as a gap.
    """
    if pace == "calendar":
        return [1.0] * len(days)
    return [len(by_day.get(day.isoformat(), ())) + LULL_WEIGHT for day in days]


def allocate_frames(weights, total, floors):
    """Split `total` frames across ticks by weight, honouring per-tick floors.

    Allocation is cumulative rounding: a tick gets the frames between where the
    running weight total rounds to before it and after it. That sums to exactly
    `total`, so the movie lands on its requested length, and — unlike
    largest-remainder, whose ties all break the same way and pile the spare
    frames onto whichever end of the timeline sorts first — it spreads thin
    weights evenly. Ten dry days worth a quarter-frame each become a frame on
    every fourth day, which is what makes a compressed dry spell read as a
    steady dim rather than one abrupt jump to stale.

    The repair pass then lifts any tick below its floor by taking frames from
    the best-funded ticks: a day something happened on always gets at least one
    frame, while a day nothing happened on may get none and never be rendered.
    """
    total_w = sum(weights) or 1.0
    frames, cum, mark = [], 0.0, 0
    for w in weights:
        cum += w
        nxt = round(cum * total / total_w)
        frames.append(nxt - mark)
        mark = nxt
    for i, floor in enumerate(floors):
        while frames[i] < floor:
            j = max(range(len(frames)), key=lambda k: frames[k] - floors[k])
            if frames[j] - 1 < floors[j]:
                raise SystemExit("not enough frames to show every day that happened")
            frames[j] -= 1
            frames[i] += 1
    return frames


def retime(weights, floors, seconds, target_fps=TARGET_FPS):
    """Fit weighted date ticks into a movie of exactly `seconds` total.

    Returns (frames_per_tick, fps, fade_s, label_life_s). The loop-closing
    dissolve and the label fade are both fractions of the whole, so a short
    movie is neither mostly a dissolve nor a flicker of unreadable gold — and
    crucially the fade tracks runtime rather than tick count, so making
    keyframes denser does not make the problem numbers flash by faster. Weights
    are already in solve units, so aiming for one frame per unit of weight is
    what gives each solve its own frame; the fps rises to buy that where
    target_fps is too slow.
    """
    fade = min(END_FADE_S, seconds * FADE_FRACTION)
    ticks_s = seconds - fade
    fps = min(MAX_FPS, max(target_fps, sum(weights) / ticks_s)) if ticks_s > 0 else MAX_FPS
    needed = sum(floors)
    if ticks_s <= 0 or needed / ticks_s > MAX_FPS:
        # every tick that carries a solve needs a frame of its own; below that
        # the ticks themselves would be dropped, silently rewriting the history
        floor_s = (needed / MAX_FPS) / (1 - FADE_FRACTION)
        raise SystemExit(
            f"{seconds:g}s is too short for {needed} date ticks that carry "
            f"solves. Shortest sensible movie is ~{floor_s:.1f}s."
        )
    frames = allocate_frames(weights, round(ticks_s * fps), floors)
    return frames, fps, fade, seconds * LABEL_LIFE_FRACTION


def main():
    global FPS_OUT, END_FADE_S, LABEL_LIFE_S

    parser = argparse.ArgumentParser(description="Animate the technique graph's history.")
    parser.add_argument("seconds", nargs="?", type=float, default=DEFAULT_SECONDS,
                        help=f"total movie length in seconds (default: {DEFAULT_SECONDS:g})")
    parser.add_argument("--tick-days", type=int, default=TICK_DAYS,
                        help=f"days between interpolated keyframes (default: {TICK_DAYS})")
    parser.add_argument("--fps", type=float, default=TARGET_FPS,
                        help=f"target output framerate (default: {TARGET_FPS:g})")
    parser.add_argument("--pace", choices=("solves", "calendar"), default="solves",
                        help="spend runtime per solve (default) or per calendar day")
    parser.add_argument("--open", action="store_true", help="open the mp4 when done")
    args = parser.parse_args()

    nodes = load_nodes()
    evidence = load_evidence()
    days = frame_dates(evidence, max(1, args.tick_days))
    by_day = solves_by_day(evidence)
    weights = pace_weights(days, by_day, args.pace)
    # a day that happened is never skipped; the opening dark frame stays too
    floors = [1 if i == 0 or by_day.get(day.isoformat()) else 0
              for i, day in enumerate(days)]
    tick_frames, FPS_OUT, END_FADE_S, LABEL_LIFE_S = retime(
        weights, floors, args.seconds, args.fps)
    out = os.path.join(GRAPH_DIR, "kg.mp4")
    try:
        font = ImageFont.truetype(LABEL_FONT, LABEL_PT)
    except OSError:
        font = ImageFont.load_default()
    line_h = LABEL_PT + 6

    def block_options(text):
        return [([text], (font.getbbox(text)[2], line_h), line_h)]

    with tempfile.TemporaryDirectory() as tmp:
        prev, boxes, obstacles, opening = None, None, None, None
        active = []  # {"node", "texts", "rect", "born"} — rect pinned at spawn

        def compose(bg, t):
            """The graph at `bg` with every label still alive at time `t` on top."""
            live = [(a, label_alpha(t - a["born"])) for a in active]
            layer = Image.new("RGBA", bg.size, (0, 0, 0, 0))
            draw = ImageDraw.Draw(layer)
            for a, alpha in live:
                if alpha <= 0:
                    continue
                lx, ly = a["rect"][0], a["rect"][1]
                for j, text in enumerate(a["texts"]):
                    draw.text((lx, ly + j * a["line_h"]), text, font=font,
                              fill=(*GOLD, alpha))
            return Image.alpha_composite(bg, layer).convert("RGB")

        out_idx, tick_t = 0, 0.0
        rendered = 0
        for i, day in enumerate(days):
            subframes = tick_frames[i]
            if not subframes:
                continue  # a day nothing happened on, inside a compressed lull
            tick_s = subframes / FPS_OUT
            statuses = statuses_asof(nodes, evidence, day)
            changed = {n for n in nodes if prev and statuses[n][0] != prev[n][0]}
            counts = Counter(s[0] for s in statuses.values())
            title = (f"{day}   ·   {counts['SOLID']:2d} solid  {counts['STALE']:2d} stale  "
                     f"{counts['FRAGILE']:2d} fragile  {counts['MISSING']:2d} missing")
            dot = build_graph(nodes, statuses, changed, title)
            dot.render(filename="base", directory=tmp, format="png", cleanup=True)
            base_png = os.path.join(tmp, "base.png")
            if boxes is None:
                boxes, obstacles = layout_geometry(dot, png_size(base_png))

            active = [a for a in active if label_alpha(tick_t - a["born"]) > 0]
            day_solves = by_day.get(day.isoformat(), [])
            for k, (prob, moves) in enumerate(day_solves):
                born = tick_t + k * tick_s / len(day_solves)  # replay in solve order
                for node_id in moves:
                    if node_id not in boxes:
                        continue
                    alive_here = [a for a in active if a["node"] == node_id]
                    if len(alive_here) >= MAX_PROBS:  # evict the oldest on a hot node
                        active.remove(min(alive_here, key=lambda a: a["born"]))
                    rect, texts, lh = place_label(boxes[node_id], block_options(prob),
                                                  obstacles, [a["rect"] for a in active])
                    active.append({"node": node_id, "texts": texts, "rect": rect,
                                   "line_h": lh, "born": born})

            base = Image.open(base_png).convert("RGBA")
            if opening is None:
                opening = base.copy()  # the dark graph the loop dissolves back to
            clean_idx = None  # first label-free frame of this tick, for hardlink reuse
            for s in range(subframes):
                t = tick_t + s / FPS_OUT
                frame_path = os.path.join(tmp, f"f_{out_idx:05d}.jpg")
                if any(label_alpha(t - a["born"]) > 0 for a in active):
                    compose(base, t).save(frame_path, quality=92)
                elif clean_idx is not None:
                    os.link(os.path.join(tmp, f"f_{clean_idx:05d}.jpg"), frame_path)
                else:
                    base.convert("RGB").save(frame_path, quality=92)
                    clean_idx = out_idx
                out_idx += 1
            prev, tick_t, rendered = statuses, tick_t + tick_s, rendered + 1
            print(f"\r{i + 1}/{len(days)} ticks", end="", flush=True)
        print()

        # Close the loop by dissolving the finished graph back into the opening
        # frame rather than freezing on it. A freeze is dead frames, which is
        # exactly what a looping GIF makes you stare at, and the cut from a fully
        # lit graph to a dark one is jarring however long you hold it. The
        # dissolve keeps moving and lands a hair short of frame 0, so the seam
        # has nothing to catch on. Labels caught mid-fade keep fading through it.
        if opening.size != base.size:
            opening = opening.resize(base.size)
        n_fade = max(1, round(END_FADE_S * FPS_OUT))
        # Land on the opening frame a little before the end rather than exactly
        # on it: the README GIF resamples this movie down to 20fps, so its last
        # frame falls a few source frames short, and a dissolve that only
        # completes on the very last one leaves the loop with a visible step.
        settle = min(n_fade - 1, max(1, round(FPS_OUT / 12)))
        for k in range(n_fade):
            mix = Image.blend(base, opening, min(1.0, (k + 1) / (n_fade - settle)))
            compose(mix, tick_t + k / FPS_OUT).save(
                os.path.join(tmp, f"f_{out_idx:05d}.jpg"), quality=92)
            out_idx += 1

        w, h = base.size
        w, h = w + w % 2, h + h % 2
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-framerate", str(FPS_OUT),
             "-i", os.path.join(tmp, "f_%05d.jpg"),
             "-vf", (f"scale={w}:{h}:force_original_aspect_ratio=decrease,"
                     f"pad={w}:{h}:(ow-iw)/2:(oh-ih)/2:color=0x0d1117,"
                     f"format=yuv420p"),
             "-c:v", "libx264", "-crf", "20",
             "-g", str(max(1, round(FPS_OUT * GOP_S))), "-keyint_min", "1",
             "-force_key_frames", f"expr:gte(t,n_forced*{GOP_S})", out],
            check=True,
        )

    print(f"wrote {out} — {rendered}/{len(days)} ticks rendered, {FPS_OUT:.6g}fps, "
          f"{out_idx / FPS_OUT:.1f}s ({END_FADE_S:.1f}s loop dissolve)")
    if args.open:
        subprocess.run(["open", out], check=False)


if __name__ == "__main__":
    main()
