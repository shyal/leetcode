#!/usr/bin/env python3

# kg_warmup — momentum laps, gated by the clock.
#
# Detects the start of the day: count the solves committed since local
# midnight (Asia/Manila — git stamps are UTC, so the midnight cutoff is
# passed to git with its +08:00 offset) — solve commits only, meaning
# files added under solved/ or drills/, never meta/tooling commits.
# Fewer than LAPS solves so far -> still in the warmup: prescribe the
# remaining laps, dead-easy first — all-SOLID easies with tiny walks and
# high acceptance. Momentum, not tests, not training — nothing worse
# than stalling first thing in the morning. Quiet from lap LAPS onward.
#
#   make warmup    # also runs automatically at the top of `make`

import json
import os
import subprocess
from datetime import datetime
from zoneinfo import ZoneInfo

from rich.console import Console

from kg_lib import (
    GRAPH_DIR, load_nodes, load_problems, load_evidence, node_status,
    acceptance, tree_size, last_solved, SOLID,
)

MANILA = ZoneInfo("Asia/Manila")
LAPS = 2

console = Console()


def solves_today():
    """Solve files committed since local midnight (added, not just touched)."""
    midnight = datetime.now(tz=MANILA).replace(hour=0, minute=0, second=0,
                                               microsecond=0)
    out = subprocess.run(
        ["git", "log", f"--since={midnight.isoformat()}", "--diff-filter=A",
         "--name-only", "--format=", "--", "solved/", "drills/"],
        capture_output=True, text=True,
        cwd=os.path.dirname(GRAPH_DIR)).stdout.split()
    return sorted(set(out))


def problem_url(pnum):
    meta_path = os.path.join(os.path.dirname(GRAPH_DIR), ".problems_metadata.json")
    try:
        slug = json.load(open(meta_path))[str(pnum)]["slug"]
        return f"https://leetcode.com/problems/{slug}/"
    except Exception:
        return f"https://leetcode.com/problemset/?search={pnum}"


def pick_laps(problems, nodes, evidence, n=LAPS):
    statuses = {m: node_status(m, evidence) for m in nodes}
    cands = []
    for pnum, p in problems.items():
        moves = p.get("moves", [])
        if p.get("banned") or p.get("difficulty") != "Easy" or not moves:
            continue
        if not all(m in nodes and statuses[m][0] == SOLID for m in moves):
            continue
        cands.append((tree_size(pnum, problems, nodes), -acceptance(pnum),
                      last_solved(pnum, evidence), pnum))
    cands.sort()
    return [c[3] for c in cands[:n]]


def main():
    done = solves_today()
    remaining = LAPS - len(done)
    if remaining <= 0:
        return  # warmed up — the day is on
    problems = load_problems()
    laps = pick_laps(problems, load_nodes(), load_evidence(), n=remaining)
    if not laps:
        return
    console.print(f"[bold]Warmup — {len(done)}/{LAPS} solves today.[/bold] "
                  f"{len(laps)} momentum lap{'s'[:len(laps) > 1]} before the assignment:")
    for i, pnum in enumerate(laps, 1):
        console.print(f"  {i}. {pnum}. {problems[pnum]['title']}  [dim]{problem_url(pnum)}[/dim]")


if __name__ == "__main__":
    main()
