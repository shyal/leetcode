#!/usr/bin/env python3

# preflight v2 — prerequisite audit as a deterministic graph join.
#
# moves(problem) come from graph/problems.json; mastery status is derived
# from graph/evidence.json dates. No LLM call at all for known problems
# (milliseconds). Unknown problems trigger ONE small claude call (problem +
# taxonomy only, no solve history) and the result is cached back into
# problems.json.
#
# Verdict: READY when at most one move is non-SOLID (that move is the
# training target). Hards are summits: READY only when EVERY move in the
# walk is SOLID — rusty gear stays at basecamp. Otherwise PREP FIRST, with
# one prep step per weak move: STALE -> spaced re-solve of its most recent
# carrier; FRAGILE/MISSING -> the node's micro-drill.

import argparse
import sys
from rich.console import Console
from rich.table import Table

from kg_lib import (
    load_nodes, load_problems, load_evidence, save_problems,
    node_status, latest_carrier, claude_json, taxonomy_summary,
    SOLID, STALE, FRAGILE, MISSING,
)

console = Console()

STATUS_STYLE = {SOLID: "green", STALE: "yellow", FRAGILE: "orange3", MISSING: "red"}


def resolve_moves(problem_key, problems, nodes):
    # an entry with an EMPTY walk is a withdrawn mapping, not a mapped
    # problem: a bad edge was pulled and the walk still has to be re-derived.
    # Falling through to the mapping call is what makes the withdrawal
    # repairable instead of a dead end.
    if problems.get(problem_key, {}).get("moves"):
        p = problems[problem_key]
        return p["moves"], p.get("title", ""), p, False
    # try matching by title fragment
    for key, p in problems.items():
        if problem_key.lower() in p.get("title", "").lower() and p.get("moves"):
            return p["moves"], p["title"], p, False

    console.print("[dim]Problem not in graph/problems.json — one claude call to map it (cached after)...[/dim]")
    system = f"""You are mapping a LeetCode problem onto a fixed taxonomy of atomic technique moves.

Taxonomy (use ONLY these ids):
{taxonomy_summary(nodes)}

Determine the canonical clean solution for the problem, then output STRICT JSON, nothing else:
{{"title": "<full problem title>", "difficulty": "Easy|Medium|Hard", "moves": ["<node-id>", ...], "unmapped": ["<short description of any required move with no matching node>"]}}

List every move a candidate must execute, including foundational micro-moves (algebra steps, idioms). Do not explain the solution."""
    result = claude_json(f"LeetCode problem: {problem_key}", system)
    moves = result["moves"]
    problems[problem_key] = {
        "title": result.get("title", problem_key),
        "difficulty": result.get("difficulty", ""),
        "moves": moves,
    }
    if result.get("unmapped"):
        problems[problem_key]["unmapped"] = result["unmapped"]
        console.print(f"[orange3]Proposed new nodes (review!): {result['unmapped']}[/orange3]")
    save_problems(problems)
    return moves, result.get("title", ""), problems[problem_key], True


def main():
    parser = argparse.ArgumentParser(description="Deterministic prerequisite audit for a problem.")
    parser.add_argument("problem", nargs="+", help='problem number or title, e.g. 1 or "Two Sum"')
    args = parser.parse_args()
    problem_key = " ".join(args.problem).strip().rstrip(".")

    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()

    moves, title, meta, _ = resolve_moves(problem_key, problems, nodes)
    if meta.get("banned"):
        console.print("[bold red]⛔ BANNED — never offered as a carrier (busywork/quality blacklist)[/bold red]")
    if meta.get("note"):
        console.print(f"[yellow]⚠ {meta['note']}[/yellow]")

    table = Table(title=f"Preflight: {problem_key}. {title}")
    table.add_column("Move")
    table.add_column("Status")
    table.add_column("Last evidence")

    weak = []
    for move in moves:
        if move not in nodes:
            console.print(f"[red]Unknown node id in problems.json: {move}[/red]")
            continue
        status, when = node_status(move, evidence)
        if status != SOLID:
            weak.append((move, status))
        carrier = latest_carrier(move, evidence)
        last = f"{carrier[2] or carrier[1]} ({when})" if carrier and when else "—"
        table.add_row(move, f"[{STATUS_STYLE[status]}]{status}[/{STATUS_STYLE[status]}]", last)

    console.print(table)

    is_hard = meta.get("difficulty") == "Hard"
    tolerance = 0 if is_hard else 1
    if len(weak) <= tolerance:
        console.print("\n[bold green]Verdict: READY[/bold green]")
        if weak:
            console.print(f"Training target: [bold]{weak[0][0]}[/bold] ({weak[0][1]})")
        elif is_hard:
            console.print("[dim]Walk is all green — summit is a pure combination rep at altitude.[/dim]")
        else:
            console.print("[dim]No new moves — this is a pure combination/consolidation rep.[/dim]")
        return

    if is_hard:
        console.print("\n[bold red]Verdict: PREP FIRST[/bold red] — summits demand an all-SOLID walk"
                      f" (rusty gear stays at basecamp; `make hard {problem_key}` plans the route).\n")
    else:
        console.print("\n[bold red]Verdict: PREP FIRST[/bold red] — more than one non-SOLID move.\n")
    step = 1
    for move, status in weak:
        node = nodes[move]
        if status == STALE:
            carrier = latest_carrier(move, evidence)
            src = f"problem {carrier[2]} ({carrier[1]})" if carrier else "a past carrier problem"
            console.print(f"{step}. [yellow]{move}[/yellow] is stale — spaced re-solve of {src}")
        else:
            console.print(f"{step}. [orange3]{move}[/orange3] ({status}) — micro-drill: {node.get('drill', 'improvise a <5min drill')}")
        step += 1


if __name__ == "__main__":
    main()
