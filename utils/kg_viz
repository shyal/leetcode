#!/usr/bin/env python3

# kg_viz — draw the whole technique graph as an actual graph.
#
#   utils/kg_viz               # render + show inline in the terminal (iTerm2)
#   utils/kg_viz --open        # render + open the SVG in the browser (hover tooltips)
#   utils/kg_viz --no-show     # render only
#
# Nodes are colored by derived mastery (kg_lib.node_status), edges are
# prerequisites from nodes.json, families are drawn as clusters.

import argparse
import os
import subprocess
from collections import defaultdict
from rich.console import Console

from kg_lib import GRAPH_DIR, load_nodes, load_evidence, node_status
from kg_render import make_digraph, status_node, add_legend, render, display

console = Console()


def main():
    parser = argparse.ArgumentParser(description="Render the technique graph.")
    parser.add_argument("--open", action="store_true", help="open the SVG in the browser instead")
    parser.add_argument("--no-show", "--no-open", action="store_true", help="render only, display nothing")
    args = parser.parse_args()

    nodes = load_nodes()
    evidence = load_evidence()
    dot = make_digraph("technique-graph")

    groups = defaultdict(list)
    for node_id, node in nodes.items():
        groups[node["group"]].append(node_id)

    for group, members in groups.items():
        with dot.subgraph(name=f"cluster_{group}") as c:
            c.attr(label=group, fontcolor="#8b949e", color="#30363d", style="rounded", fontname="Helvetica")
            for node_id in members:
                status, when = node_status(node_id, evidence)
                status_node(c, node_id, nodes[node_id], status, when)

    for node_id, node in nodes.items():
        for prereq in node.get("prereqs", []):
            if prereq in nodes:
                dot.edge(prereq, node_id)

    add_legend(dot)
    logical_width = render(dot, "kg")
    console.print(f"Rendered [bold]{GRAPH_DIR}/kg.svg[/bold] and kg.png")

    if args.no_show:
        return
    if args.open:
        subprocess.run(["open", os.path.join(GRAPH_DIR, "kg.svg")], check=False)
    else:
        display("kg", logical_width)


if __name__ == "__main__":
    main()
