#!/usr/bin/env python3

# kg_elo_svg - an Elo rating over the solve history, scored on a contest
# clock, rendered into graph/elo.svg (the curve) and graph/elo_badge.svg
# (the current number) for the README pipeline.
#
# Problem ratings are zerotrac's, fitted from LeetCode contest results
# (https://github.com/zerotrac/leetcode_problem_rating, copied to
# data/leetcode_ratings.tsv). A problem that never ran in a contest gets
# the median contest rating of its difficulty. Each attempt is one game
# against the problem: solved unaided inside the budget for its difficulty
# is a win, a hint inside the budget is a draw, a fail or a solve over
# budget is a loss. A solve the judge marked as meeting the statement's
# follow-up (the sub-linear bound, the O(1) space, the iterative form) is
# a harder problem than its label and plays on the next difficulty's clock.
# A walkthrough or learning rep is a loss, timed or not: the answer was on
# the page, so the attempt says nothing about solving the problem cold.
# Untimed solves are otherwise skipped. Standard Elo, K=32, from 1200.
#
# Only first sights are games: the attempts on the day of a problem's first
# evidenced attempt. A re-solve of a known problem is rehearsal, and part
# of that win is remembering the answer, so it says nothing about solving
# cold. Every Elo on the README comes from this list. The picker, the
# curve fit and the simulations keep their own Elo over every timed
# attempt in kg_lib; that one is not read here (settled 2026-09-12).
#
# The cutoffs drawn are LeetCode's badge cutoffs: Knight is the top 25% of
# contest users, Guardian the top 5%. Both are percentile ranks, so the
# rating each one sits at drifts; the numbers here are the usual ones.

import json
import os
from collections import defaultdict
from datetime import date, timedelta
from statistics import median

from kg.kg_lib import GRAPH_DIR, REPO_ROOT, load_evidence, scored_games

OUT = os.path.join(GRAPH_DIR, "elo.svg")
BADGE = os.path.join(GRAPH_DIR, "elo_badge.svg")
RATINGS = os.path.join(REPO_ROOT, "data", "leetcode_ratings.tsv")
META = os.path.join(REPO_ROOT, "data", "problems_metadata.json")

K, START = 32, 1200.0
RANKS = ((2200, "guardian", "#d29922"), (1850, "knight", "#58a6ff"))

W, H = 1200, 400
BG = "#0d1117"
INK = "#c9d1d9"
MUTED = "#8b949e"
GRID = "#21262d"
LINE = "#3fb950"
MA_LINE = "#e3b341"
MA = 60
ML, MR, MT, MB = 62, 24, 44, 40


def load_ratings():
    r = {}
    with open(RATINGS) as f:
        next(f)
        for line in f:
            rating, pid, _ = line.rstrip("\n").split("\t")
            r[pid] = float(rating)
    return r


def first_dates():
    """problem -> date of its first evidenced attempt, timed or not."""
    first: dict[str, str] = {}
    for fname, rec in sorted(
        load_evidence().items(), key=lambda kv: (kv[1]["date"], kv[0])
    ):
        first.setdefault(str(rec.get("problem", "")), rec["date"])
    return first


def games():
    """[(date, problem rating, score)] oldest first, one per scored first-sight
    attempt. Scoring lives in kg_lib.scored_games; here each game is priced
    by its problem's rating, with an unrated problem taking the median rating
    of its difficulty."""
    ratings = load_ratings()
    with open(META) as f:
        meta = json.load(f)
    by_diff = defaultdict(list)
    for pid, rt in ratings.items():
        if pid in meta:
            by_diff[meta[pid]["difficulty"]].append(rt)
    imputed = {d: median(v) for d, v in by_diff.items()}
    first = first_dates()
    return [
        (
            date.fromisoformat(g["date"]),
            ratings.get(g["problem"], imputed[g["difficulty"]]),
            g["score"],
        )
        for g in scored_games()
        if g["date"] == first.get(g["problem"])
    ]


def elo(gs):
    """[(date, rating after the day's last game)] one per day with a game."""
    r, by_day = START, {}
    for d, rp, s in gs:
        e = 1 / (1 + 10 ** ((rp - r) / 400))
        r += K * (s - e)
        by_day[d] = r
    return sorted(by_day.items())


def elo_ma(gs, n=MA):
    """[(date, mean of the Elo after each of the last n games)] one per day
    with a game, once n games exist. Elo after a game is the value one game's
    K*(s-e) step past the previous; here the steps are replayed and averaged
    over a window of n games, not n days."""
    r, after = START, []
    for d, rp, s in gs:
        r += K * (s - 1 / (1 + 10 ** ((rp - r) / 400)))
        after.append((d, r))
    out = {}
    for i in range(n - 1, len(after)):
        out[after[i][0]] = sum(r for _, r in after[i - n + 1 : i + 1]) / n
    return sorted(out.items())


def rank_of(r):
    for cut, name, color in RANKS:
        if r >= cut:
            return name, color
    return f"{RANKS[-1][0] - round(r)} to knight", MUTED


def badge(r):
    name, color = rank_of(r)
    left, right = "elo", f"{r:.0f} · {name}"
    lw, rw = 6 * len(left) + 12, 6.2 * len(right) + 12
    w = lw + rw
    return (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{w:.0f}" height="20" '
        f'font-family="Verdana,DejaVu Sans,sans-serif" font-size="11">'
        f'<rect rx="3" width="{w:.0f}" height="20" fill="#555"/>'
        f'<rect rx="3" x="{lw:.0f}" width="{rw:.0f}" height="20" fill="{color}"/>'
        f'<rect x="{lw:.0f}" width="4" height="20" fill="{color}"/>'
        f'<text x="{lw / 2:.1f}" y="14" fill="#fff" text-anchor="middle">{left}</text>'
        f'<text x="{lw + rw / 2:.1f}" y="14" fill="#fff" text-anchor="middle">{right}</text>'
        f"</svg>\n"
    )


def main():
    gs = games()
    if not gs:
        print("no scored attempts")
        return
    hist = elo(gs)
    d0, d1 = hist[0][0], hist[-1][0]
    span = max((d1 - d0).days, 1)
    top, bottom = MT, H - MB
    vals = [r for _, r in hist]
    lo = min(min(vals), RANKS[-1][0]) - 100
    hi = max(max(vals), RANKS[0][0]) + 100
    lo, hi = int(lo // 100 * 100), int(-(-hi // 100) * 100)

    def x_of(d):
        return ML + (d - d0).days / span * (W - ML - MR)

    def y_of(v):
        return bottom - (v - lo) / (hi - lo) * (bottom - top)

    n_win = sum(1 for _, _, s in gs if s == 1.0)
    n_draw = sum(1 for _, _, s in gs if s == 0.5)
    svg = [
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" '
        f'font-family="Helvetica,sans-serif">',
        f'<rect width="{W}" height="{H}" fill="{BG}"/>',
        f'<text x="{W / 2:.0f}" y="26" text-anchor="middle" font-size="11" fill="{MUTED}">'
        f"{len(gs)} games, {n_win} wins, {n_draw} draws, {len(gs) - n_win - n_draw} losses</text>",
    ]
    for cut, name, color in RANKS:
        y = y_of(cut)
        svg.append(
            f'<rect x="{ML}" y="{top}" width="{W - ML - MR}" height="{y - top:.1f}" '
            f'fill="{color}" fill-opacity="0.06"/>'
        )
        svg.append(
            f'<line x1="{ML}" y1="{y:.1f}" x2="{W - MR}" y2="{y:.1f}" '
            f'stroke="{color}" stroke-width="1" stroke-dasharray="4 4"/>'
        )
        svg.append(
            f'<text x="{W - MR - 4}" y="{y - 5:.1f}" text-anchor="end" font-size="11" '
            f'fill="{color}">{name} {cut}</text>'
        )
    for g in range(lo, hi + 1, 100):
        y = y_of(g)
        svg.append(
            f'<line x1="{ML}" y1="{y:.1f}" x2="{W - MR}" y2="{y:.1f}" '
            f'stroke="{GRID}" stroke-width="1"/>'
        )
        svg.append(
            f'<text x="{ML - 8}" y="{y + 4:.1f}" text-anchor="end" font-size="11" '
            f'fill="{MUTED}">{g}</text>'
        )
    d = date(d0.year, d0.month, 1)
    while d <= d1:
        if d >= d0:
            x = x_of(d)
            svg.append(
                f'<line x1="{x:.1f}" y1="{top}" x2="{x:.1f}" y2="{bottom}" '
                f'stroke="{GRID}" stroke-width="1"/>'
            )
            svg.append(
                f'<text x="{x:.1f}" y="{bottom + 18}" text-anchor="middle" font-size="11" '
                f'fill="{MUTED}">{d.strftime("%b %y")}</text>'
            )
        d = (d.replace(day=28) + timedelta(days=4)).replace(day=1)

    # one polyline per run of games; a gap over a month is drawn as a gap
    def runs(series):
        out: list[list] = [[]]
        prev = None
        for dd, r in series:
            if prev and (dd - prev).days > 31:
                out.append([])
            out[-1].append((dd, r))
            prev = dd
        return out

    for series, color, opacity in ((hist, LINE, 0.3), (elo_ma(gs), MA_LINE, 1)):
        for run in runs(series):
            pts = " ".join(f"{x_of(dd):.1f},{y_of(r):.1f}" for dd, r in run)
            svg.append(
                f'<polyline points="{pts}" fill="none" stroke="{color}" '
                f'stroke-width="2" stroke-opacity="{opacity}"/>'
            )
    y = MT - 18
    x = ML
    for color, label in ((LINE, "elo"), (MA_LINE, f"{MA} game moving average")):
        svg.append(
            f'<line x1="{x}" y1="{y}" x2="{x + 16}" y2="{y}" stroke="{color}" stroke-width="2"/>'
        )
        svg.append(
            f'<text x="{x + 22}" y="{y + 4}" font-size="11" fill="{MUTED}">{label}</text>'
        )
        x += 34 + 6.2 * len(label)
    last = hist[-1][1]
    svg.append(
        f'<circle cx="{x_of(d1):.1f}" cy="{y_of(last):.1f}" r="4" fill="{LINE}"/>'
    )
    svg.append(
        f'<text x="{x_of(d1):.1f}" y="{y_of(last) - 12:.1f}" text-anchor="end" '
        f'font-size="12" fill="{LINE}">{last:.0f}</text>'
    )
    svg.append("</svg>")
    with open(OUT, "w") as f:
        f.write("\n".join(svg) + "\n")
    with open(BADGE, "w") as f:
        f.write(badge(last))
    name, _ = rank_of(last)
    print(f"wrote {OUT} and {BADGE} ({len(gs)} games, elo {last:.0f}, {name})")


if __name__ == "__main__":
    main()
