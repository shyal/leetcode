#!/usr/bin/env python3

# kg_gaps - what the taxonomy is still blind to, ranked.
#
#   utils/kg_gaps            # top 25
#   utils/kg_gaps --all
#
# Reads the missing-move suggestions the walk drafter emitted into
# graph/predicted.json (phase 3 of PLAN.md). For each suggested move:
# mentions = how many predicted walks asked for it; sole blocker = problems
# whose known moves are all SOLID today and which are blocked ONLY by this
# one absent node - the unlock count if it entered the taxonomy and got
# trained. Suggestions starting with 'brute-force' are one bucket: they mean
# 'no technique needed', not a node.

import argparse
import json
import os
import sys
from collections import defaultdict

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from kg_lib import GRAPH_DIR, SOLID, load_evidence, load_nodes, node_status


def norm(name):
    name = name.strip().lower().replace(" ", "-")
    return "brute-force" if name.startswith("brute-force") else name


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--all", action="store_true", help="Print every suggestion.")
    args = parser.parse_args()

    predicted = json.load(open(os.path.join(GRAPH_DIR, "predicted.json")))["problems"]
    nodes = load_nodes()
    evidence = load_evidence()
    statuses = {nid: node_status(nid, evidence)[0] for nid in nodes}

    mentions = defaultdict(int)
    sole = defaultdict(list)
    for num, prob in predicted.items():
        for walk in prob["walks"]:
            missing = sorted({norm(m) for m in walk.get("missing", [])})
            for m in missing:
                mentions[m] += 1
            if len(missing) == 1 and walk["moves"] and \
                    all(statuses.get(mv) == SOLID for mv in walk["moves"]):
                sole[missing[0]].append((num, prob["title"]))

    ranked = sorted(mentions, key=lambda m: (-len(sole[m]), -mentions[m], m))
    if not args.all:
        ranked = ranked[:25]
    print(f"{'suggested move':<34} {'unlocks':>7} {'mentions':>8}  examples")
    for m in ranked:
        ex = ", ".join(num for num, _ in sole[m][:5])
        print(f"{m:<34} {len(sole[m]):>7} {mentions[m]:>8}  {ex}")
    total = sum(len(v) for v in sole.values())
    print(f"\n{len(mentions)} distinct suggestions; {total} problems blocked by "
          "exactly one absent node with everything else solid")


if __name__ == "__main__":
    main()
