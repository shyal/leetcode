#!/usr/bin/env python3

# kg_mock — estimate today's pass rate on a random mock set (2E + 2M + 2H),
# then simulate practice forward — INCLUDING growth of the graph itself —
# until the trajectory flattens for real, not by construction.
#
#   make mock 2                # 2 hours/day of practice in the forward sim
#
# Per-problem model:  P(solve) = rec × off-graph survival × Π moves have × in-time
#   have        — the fitted curve's predicted recall for that node
#   rec         — cold-recognition, per problem; the one parameter evidence
#                 cannot identify (every recorded solve had scaffolding), so
#                 it is carried as scenarios until real mocks measure it
#   off-graph   — P(the problem needs an idea outside the taxonomy). NOT
#                 frozen: every practiced hard that meets an unknown idea
#                 converts it to a new node at your MEASURED first-contact
#                 absorption rate (84% of first encounters were clean), the
#                 way fission has always grown this graph. New nodes join
#                 the maintenance pool and pay upkeep like any other.
#   in-time     — measured from git history at 15m/35m/60m budgets
#
# Regime simulated (matches the current make-today reality): mediums daily
# from day 1; hards enter at day 45, ~3/week; mocks deferred to day ~90
# (premium + they should motivate, not punish) — recognition only starts
# consolidating then. Measured inputs: solve times, first-contact rate,
# fitted forgetting curve. Assumed (priors, labeled): unknown-idea pool
# sizes, off-graph floors, recognition scenarios, the day-90 mock start.

import json
import math
import os
import random
import re
import statistics
import subprocess
import sys
from collections import Counter
from datetime import date, timedelta

from rich.console import Console

from kg_lib import GRAPH_DIR, load_nodes, load_problems, load_evidence, \
    node_status, FRAGILE, MISSING

console = Console(highlight=False)


def prob_style(v):
    return "red" if v < 0.25 else "yellow" if v < 0.5 else \
        "green" if v < 0.75 else "bold green"


def risk_style(v):
    return "green" if v <= 0.20 else "yellow" if v <= 0.35 else "red"


def tint(text, style):
    return f"[{style}]{text}[/{style}]"

WALK_LEN = {"E": (1, 2), "M": (2, 4), "H": (4, 6)}
OFF_GRAPH0 = {"E": 0.02, "M": 0.10, "H": 0.45}  # today's off-taxonomy rates
OFF_FLOOR = {"E": 0.01, "M": 0.04, "H": 0.15}   # the genuinely exotic tail
UNKNOWN_POOL = {"M": 12, "H": 35}               # distinct learnable ideas out there
REC_POWER = {"E": 0.5, "M": 1.0, "H": 1.6}
SCENARIOS = {"cautious": 0.75, "central": 0.85, "optimistic": 0.95}
HARDS_START, MOCKS_START = 45, 90               # sim days
MOCKS_PER_WEEK, HARDS_PER_WEEK = 2, 3
N_MC = 20000


def recognition(base, mocks_done):
    return base + (0.98 - base) * (1 - math.exp(-mocks_done / 8))


def pass_rates(node_recall, move_freq, off, r_base, practice, rng, n_mc=N_MC):
    """(full clear, onsite 2E+2M+>=1H, screen both-M, single-hard P)."""
    mediums, mocks, hards = practice
    grow = 1 - math.exp(-mediums / 120)
    time_f = {"E": 0.88 + 0.07 * grow, "M": 0.87 + 0.07 * grow,
              "H": 0.40 + 0.42 * (1 - math.exp(-hards / 15))}
    derive = 0.25 + 0.20 * (1 - math.exp(-(mocks + hards) / 30))
    rec = recognition(r_base, mocks)
    moves, weights = zip(*move_freq.items())
    full = onsite = screen = h_solved = 0
    for _ in range(n_mc):
        solved = {"E": 0, "M": 0, "H": 0}
        for dif in ("E", "E", "M", "M", "H", "H"):
            p = time_f[dif] * rec ** REC_POWER[dif]
            if rng.random() < off[dif]:
                p *= derive
            for mv in rng.choices(moves, weights, k=rng.randint(*WALK_LEN[dif])):
                p *= node_recall.get(mv, derive)
            solved[dif] += rng.random() < p
        full += solved["E"] == 2 and solved["M"] == 2 and solved["H"] == 2
        onsite += solved["E"] == 2 and solved["M"] == 2 and solved["H"] >= 1
        screen += solved["M"] == 2
        h_solved += solved["H"]
    return full / n_mc, onsite / n_mc, screen / n_mc, h_solved / (2 * n_mc)


def measured_first_contact(evidence):
    """Fraction of moves whose very first recorded encounter was clean."""
    first = {}
    for fname, rec in sorted(evidence.items()):
        m = re.search(r"\d{4}_\d{2}_\d{2}T[\d_]+", fname)
        key = (rec["date"], m.group(0) if m else "")
        for node, v in rec.get("moves", {}).items():
            if node not in first or key < first[node][0]:
                first[node] = (key, v)
    if not first:
        return 0.7
    return sum(1 for _, v in first.values() if v == "clean") / len(first)


def current_recall(nodes, evidence, curve, today=None):
    """Predicted recall per node. Pass `today` (and evidence filtered to
    entries on or before it) to replay a historical snapshot."""
    today = today or date.today()
    p = curve["params"]
    out = {}
    for nid in nodes:
        status, last = node_status(nid, evidence, today=today)
        cleans = sum(1 for r in evidence.values()
                     if r.get("moves", {}).get(nid) == "clean")
        if status == MISSING or not last:
            out[nid] = 0.25
            continue
        s = min(max(math.exp(p["a"] + p["b"] * cleans), 7), 3650)
        rec = (1 + (today - last).days / s) ** (-p["beta"])
        out[nid] = rec * 0.5 if status == FRAGILE else rec
    return out


def main():
    hours = float(sys.argv[1]) if len(sys.argv) > 1 else 2.0
    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()
    curve = json.load(open(os.path.join(GRAPH_DIR, "curve.json")))
    p = curve["params"]

    move_freq = Counter(mv for v in problems.values() if isinstance(v, dict)
                        for mv in v.get("moves", []))
    median_w = statistics.median(move_freq.values())
    recall = current_recall(nodes, evidence, curve)
    teach = min(0.85, measured_first_contact(evidence) * 0.8)

    console.print("[bold]today, cold, on a random 2E+2M+2H set:[/bold]")
    console.print("  scenario     screen (both M)   onsite (2E+2M+>=1H)   P(one hard)")
    for name, r in SCENARIOS.items():
        _, onsite, screen, ph = pass_rates(recall, move_freq, OFF_GRAPH0, r,
                                           (0, 0, 0), random.Random(42))
        console.print(f"  {name:10s}      "
                      + tint(f"{screen:5.1%}", prob_style(screen)) + "             "
                      + tint(f"{onsite:5.1%}", prob_style(onsite)) + "           "
                      + tint(f"{ph:5.1%}", prob_style(ph)))
    console.print(f"  [dim]measured: first-contact absorption {teach / 0.8:.0%} -> "
                  f"miss-to-node conversion {teach:.0%}[/dim]")

    # forward: practice within the graph AND growth of the graph itself
    reps = {n: max(1, sum(1 for r in evidence.values()
                          if r.get("moves", {}).get(n) == "clean")) for n in nodes}
    gaps = {}
    for n in nodes:
        _, last = node_status(n, evidence)
        gaps[n] = (date.today() - last).days if last else 0
    off = dict(OFF_GRAPH0)
    unknown = dict(UNKNOWN_POOL)
    freq_now = Counter(move_freq)
    mediums_done = mocks_done = hards_done = syn = 0
    rows, milestones, day = [], {}, 0
    # frontier cadence scales with the day (sublinearly — absorption needs
    # spacing): 2h -> 3 hards/wk, 3h -> ~4.5, capped at 6
    hards_per_week = min(6.0, HARDS_PER_WEEK * hours / 2)

    def learn_ideas(dif, encounters):
        nonlocal syn
        learned = teach * off[dif] * encounters
        unknown[dif] = max(0.0, unknown[dif] - learned)
        off[dif] = OFF_FLOOR[dif] + (OFF_GRAPH0[dif] - OFF_FLOOR[dif]) \
            * unknown[dif] / UNKNOWN_POOL[dif]
        while syn < UNKNOWN_POOL["M"] + UNKNOWN_POOL["H"] - unknown["M"] - unknown["H"] - 0.5:
            syn += 1
            nid = f"syn-{syn}"
            reps[nid], gaps[nid] = 1, 0
            freq_now[nid] = median_w

    while day < 540:
        day += 1
        budget = hours * 60
        for n in gaps:
            gaps[n] += 1
        for n in sorted(gaps, key=lambda n: gaps[n], reverse=True):
            s = min(max(math.exp(p["a"] + p["b"] * reps[n]), 7), 3650)
            if (1 + gaps[n] / s) ** (-p["beta"]) < curve["target_retention"] \
                    and budget >= 10:
                budget -= 10
                gaps[n], reps[n] = 0, reps[n] + 1
        while budget >= 23:
            if day > HARDS_START and hards_done < (day - HARDS_START) / 7 * hards_per_week:
                budget -= 40
                hards_done += 1
                learn_ideas("H", 1)
            elif day > MOCKS_START and mocks_done < (day - MOCKS_START) / 7 * MOCKS_PER_WEEK:
                budget -= 90
                mocks_done += 1
            else:
                budget -= 23
                mediums_done += 1
                learn_ideas("M", 1)
            for n in sorted(gaps, key=lambda n: (reps[n], -gaps[n]))[:3]:
                gaps[n], reps[n] = 0, reps[n] + 1
        if day % 30 == 0:
            rec_now = {n: (1 + gaps[n] / min(max(math.exp(p["a"] + p["b"] * reps[n]), 7), 3650))
                       ** (-p["beta"]) for n in gaps}
            practice = (mediums_done, mocks_done, hards_done)
            spread = [pass_rates(rec_now, freq_now, off, r, practice,
                                 random.Random(42), 6000)
                      for r in SCENARIOS.values()]
            rows.append((day, practice, len(gaps), off["H"], spread))
            ph_c = spread[1][3]
            for lvl, tag in ((0.25, "hards workable"), (0.5, "hard-competent")):
                if ph_c >= lvl and tag not in milestones:
                    milestones[tag] = day

    console.print(f"\n[bold]forward at {hours:g}h/day[/bold] [dim](hards from day "
                  f"{HARDS_START}, mocks deferred to day {MOCKS_START})[/dim]")
    console.print("  [bold]month     practice (M/mk/H)  nodes  offH   P(hard)"
                  "   P(screen)     P(onsite)[/bold]")
    for day, (md, mk, hd), n_nodes, offh, spread in rows:
        scr = sorted(s[2] for s in spread)
        ons = sorted(s[1] for s in spread)
        ph = spread[1][3]
        when = (date.today() + timedelta(days=day)).strftime("%-d %b %y")
        console.print(
            f"  [bold]{when:9s}[/bold] [dim]{md:4d}/{mk:3d}/{hd:4d}[/dim]   "
            f"[cyan]{n_nodes:3d}[/cyan]   "
            + tint(f"{offh:4.0%}", risk_style(offh)) + "   "
            + tint(f"{ph:5.0%}", prob_style(ph)) + "     "
            + tint(f"{scr[0]:3.0%}–{scr[2]:3.0%}", prob_style((scr[0] + scr[2]) / 2))
            + "      "
            + tint(f"{ons[0]:3.0%}–{ons[1]:3.0%}–{ons[2]:3.0%}", prob_style(ons[1])))
    for tag in ("hards workable", "hard-competent"):
        if tag in milestones:
            when = (date.today() + timedelta(days=milestones[tag])).strftime("%-d %b %Y")
            console.print(f"  [bold green]{tag}[/bold green] "
                          f"(P {'>=25%' if 'workable' in tag else '>=50%'}) ~ "
                          f"[bold]{when}[/bold]")
    console.print("[dim]measured: solve times, forgetting curve, 84% first-contact "
                  "absorption. assumed: unknown-idea pools (M 12, H 35), off-graph "
                  "floors, recognition scenarios, mock start day. The band collapses "
                  "as real data arrives.[/dim]")


if __name__ == "__main__":
    main()
