console = Console()


def run_git(cmd):
    """Run a git command and return its output."""
    try:
        return (
            subprocess.check_output(["git"] + cmd, stderr=subprocess.STDOUT)
            .decode()
            .strip()
        )
    except subprocess.CalledProcessError as e:
        print(f"Git command failed: {' '.join(cmd)}\nOutput: {e.output.decode()}")
        sys.exit(1)


def get_problem_content(num: int, title: str, dt: datetime) -> str:
    """Get the content of the solved problem file based on number."""
    solved_dir = "./solved"
    for filename in os.listdir(solved_dir):
        if filename.startswith(f"p{num}_") and filename.endswith(".py"):
            filepath = os.path.join(solved_dir, filename)
            with open(filepath, "r") as f:
                return f.read()
    return ""


api_key = os.getenv("GROK_API_KEY")
if not api_key:
    raise ValueError("GROK_API_KEY environment variable not set")

client = Client(api_key=api_key)


def main():
    solved_problems = get_solved_problems()

    if not solved_problems:
        history_str = "No previous solves recorded."
    else:
        manila_tz = timezone(timedelta(hours=8))

        history_str = "\n".join(
            [
                f"{p[2].astimezone(manila_tz).strftime('%Y-%m-%d %H:%M')}: {p[0]}. {p[1]}{f' (time: {p[3]})' if p[3] else ''}:"
                + f"\n\n"
                + (
                    lambda content: (
                        lambda notes, code: code + (f"\n\n{notes}" if notes else "")
                    )(*parse_content(content))
                )(get_problem_content(p[0], p[1], p[2]))
                + f"\n"
                for p in solved_problems
            ]
        )

    system_prompt = (
        input("system prompt: ").strip()
        or """You are an expert LeetCode coach specializing in assessing candidate readiness.

Based on the user's solve history, provide him with some feedback:

1. Provide a brief overview of readiness in a variety of topics, as percentage complete to be considered strong / contest / fang ready.

Pay special attention to problems attempted, solutions, solve dates, solve times, repeats etc.

Think carefully about the candidates cognitive strenghts, and weaknesses. Provide short but detailed feedback on strengths, and what
needs further improvements.

Assume the candidate will continue solving daily at their similar average pace.
"""
    )

    user_prompt = (
        f"""Here is my LeetCode solve history (most recent last):\n\n{history_str}\n."""
    )

    try:
        chat = client.chat.create(
            model="grok-4-0709",
            messages=[
                system(system_prompt),
                user(user_prompt),
            ],
        )
        response = chat.sample()
        recommendation = response.content.strip()
        estimates = json.loads(recommendation)
    except json.JSONDecodeError as e:
        print(f"Failed to parse JSON from API response: {e}")
        print(f"Response: {recommendation}")
        sys.exit(1)
    except Exception as e:
        print(f"Error calling xAI API: {e}")
        sys.exit(1)

    rich_print(estimates)


if __name__ == "__main__":
    main()
