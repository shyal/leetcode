#!/usr/bin/env python3

# estimate — append a readiness snapshot to data/readiness.json.
#
# Topic scores are DERIVED from the technique graph (no LLM): per node group,
# SOLID = 1.0, STALE = 0.5, FRAGILE = 0.25, MISSING = 0, averaged.
# The two date projections come from ONE small claude call fed the graph
# summary and recent velocity — never the raw solve history (see utils/preflight
# for the same architecture).

import json
import os
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone, date
from rich.console import Console
from rich.table import Table

from kg_lib import load_nodes, load_evidence, node_status, claude_json, SOLID, STALE, FRAGILE, MISSING

console = Console()

WEIGHT = {SOLID: 1.0, STALE: 0.5, FRAGILE: 0.25, MISSING: 0.0}


def main():
    nodes = load_nodes()
    evidence = load_evidence()

    statuses = {n: node_status(n, evidence) for n in nodes}
    group_scores = defaultdict(list)
    counts = defaultdict(int)
    for node_id, node in nodes.items():
        s, _ = statuses[node_id]
        group_scores[node["group"]].append(WEIGHT[s])
        counts[s] += 1
    topics = {g: round(sum(v) / len(v), 2) for g, v in group_scores.items()}

    today = date.today()
    recent = defaultdict(int)
    for rec in evidence.values():
        try:
            d = datetime.strptime(rec["date"], "%Y-%m-%d").date()
        except (KeyError, ValueError):
            continue
        age = (today - d).days
        if age <= 7:
            recent["last_7_days"] += 1
        if age <= 30:
            recent["last_30_days"] += 1

    summary = "\n".join(f"{g}: {score}" for g, score in sorted(topics.items(), key=lambda kv: -kv[1]))
    status_line = f"{counts[SOLID]} SOLID, {counts[STALE]} STALE, {counts[FRAGILE]} FRAGILE, {counts[MISSING]} MISSING (of {len(nodes)} technique nodes)"

    system_prompt = """You are an expert LeetCode coach estimating candidate readiness.

You are given a technique-graph summary: per-topic readiness scores (0-1, derived
from evidence recency: solid moves score 1.0, stale 0.5, fragile 0.25, missing 0)
plus current practice velocity. The user practices daily when active, but has a
history of multi-week lapses; project realistically for consistent daily practice.

Output ONLY a JSON object: {"contest_readiness": "YYYY-MM-DD", "faang_interview": "YYYY-MM-DD"}
- contest_readiness: ready to perform in the top 50% of a LeetCode contest
- faang_interview: ready to pass FAANG-level interviews"""

    user_prompt = f"""Today's date: {today}

Overall node statuses: {status_line}
Evidence entries recorded in the last 7 days: {recent['last_7_days']}
Evidence entries recorded in the last 30 days: {recent['last_30_days']}

Per-topic readiness (0-1):
{summary}

Estimate the two readiness dates."""

    manila_tz = timezone(timedelta(hours=8))
    run_date = datetime.now(manila_tz).strftime("%Y-%m-%d")

    data = []
    if os.path.exists("data/readiness.json"):
        try:
            with open("data/readiness.json") as f:
                data = json.load(f)
            if not isinstance(data, list):
                data = []
        except json.JSONDecodeError:
            data = []

    # the LLM dates are a coarse guess; one call per day is plenty. Same-day
    # reruns reuse them (--fresh forces a new call); the simulator below still
    # recomputes every run.
    cached = next((e for e in data if e.get("run_date") == run_date), None)
    if cached and "--fresh" not in sys.argv:
        estimates = {
            "contest_readiness": cached["contest_readiness"],
            "faang_interview": cached["faang_interview"],
        }
        llm_note = " (cached)"
    else:
        estimates = claude_json(user_prompt, system_prompt)
        llm_note = ""

    # deterministic date from the curve simulator (utils/kg_predict), recorded
    # alongside the LLM guess so both variance series accumulate
    predict = None
    try:
        out = subprocess.run(
            [sys.executable, os.path.join(os.path.dirname(__file__), "kg_predict"), "--json"],
            capture_output=True, text=True, check=True,
            env={**os.environ, "PYTHONPATH": os.path.dirname(__file__)},
        ).stdout
        predict = json.loads(out)
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        console.print(f"[yellow]kg_predict failed, no faang_predict recorded: {e}[/yellow]")

    data = [e for e in data if e.get("run_date") != run_date]  # same-day rerun replaces
    entry = {
        "run_date": run_date,
        "contest_readiness": estimates["contest_readiness"],
        "faang_interview": estimates["faang_interview"],
        "contest_topics_readiness": topics,
    }
    if predict:
        entry["faang_predict"] = predict["ready"]
        entry["faang_predict_hours"] = predict["hours"]
    data.append(entry)
    with open("data/readiness.json", "w") as f:
        json.dump(data, f, indent=2)

    table = Table(show_header=False, box=None, padding=(0, 2))
    table.add_row("Run date", run_date)
    table.add_row("Node statuses", status_line)
    table.add_row("Contest readiness", str(estimates["contest_readiness"]) + llm_note)
    table.add_row("FAANG interview (LLM)", str(estimates["faang_interview"]) + llm_note)
    if predict:
        table.add_row("FAANG interview (simulated)", f"{predict['ready']} at {predict['hours']:g}h/day")
    console.print(table)


if __name__ == "__main__":
    main()
