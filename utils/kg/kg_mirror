#!/usr/bin/env python3
"""Mirror the graph JSON into graph/leet.db (sqlite) for ad-hoc SQL.

Read-only, rebuilt from scratch on every run - nothing reads it back.
The JSON stays the source of truth; this is a playground.

    make mirror
    sqlite3 graph/leet.db

Tables
    nodes(id, name, "group", added, desc, hint, drill)
    prereqs(node_id, prereq_id)               node_id needs prereq_id first
    node_refs(node_id, path)                  dsa/ files the node points at
    problems(num, title, difficulty, source, note, banned)
    steps(num, pos, node_id)                  the nodes a problem uses, in order
    alt_steps(num, walk, pos, node_id)        alternative orderings, walk = which one
    problem_after(num, after_id)              serve `after_id` before `num`
    drills(id, title, path, node)             one bank drill (drills/<node>/*.py), id = d14
    drill_trains(id, node_id)                 the nodes a drill evidences (TRAINS)
    drill_after(id, after_id)                 serve `after_id` before the drill
    problem_unmapped(num, text)               moves no node names yet
    solves(file, date, problem, assist, note)     one solve or drill file (evidence.json)
    verdicts(file, node_id, verdict)          one node's verdict inside one solve
    solve_unmapped(file, text)

`assist` is always filled: 'none' when the record has no assist field.
`problem` is 'drill' for drill files, else the LeetCode number as text.
An `after_id` is a problem number, a drill id, or a node id (one relation,
kg_lib.warm decides when it is met).
"""

import glob
import os
import sqlite3
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from kg.kg_lib import (GRAPH_DIR, DRILLS_DIR, assist_of, load_evidence, load_nodes,  # noqa: E402
                       load_problems, load_drills, drill_title, drill_trains, drill_id)

DB = os.path.join(GRAPH_DIR, "leet.db")

SCHEMA = """
CREATE TABLE nodes (
    id TEXT PRIMARY KEY, name TEXT, "group" TEXT, added TEXT,
    desc TEXT, hint TEXT, drill TEXT);
CREATE TABLE prereqs (node_id TEXT, prereq_id TEXT, PRIMARY KEY (node_id, prereq_id));
CREATE TABLE node_refs (node_id TEXT, path TEXT);
CREATE TABLE problems (
    num TEXT PRIMARY KEY, title TEXT, difficulty TEXT, source TEXT,
    note TEXT, banned INTEGER NOT NULL DEFAULT 0);
CREATE TABLE steps (num TEXT, pos INTEGER, node_id TEXT, PRIMARY KEY (num, pos));
CREATE TABLE alt_steps (num TEXT, walk INTEGER, pos INTEGER, node_id TEXT, PRIMARY KEY (num, walk, pos));
CREATE TABLE problem_after (num TEXT, after_id TEXT, PRIMARY KEY (num, after_id));
CREATE TABLE drills (id TEXT PRIMARY KEY, title TEXT, path TEXT, node TEXT);
CREATE TABLE drill_trains (id TEXT, node_id TEXT, PRIMARY KEY (id, node_id));
CREATE TABLE drill_after (id TEXT, after_id TEXT, PRIMARY KEY (id, after_id));
CREATE TABLE problem_unmapped (num TEXT, text TEXT);
CREATE TABLE solves (file TEXT PRIMARY KEY, date TEXT, problem TEXT, assist TEXT, note TEXT);
CREATE TABLE verdicts (file TEXT, node_id TEXT, verdict TEXT, PRIMARY KEY (file, node_id));
CREATE TABLE solve_unmapped (file TEXT, text TEXT);
CREATE INDEX verdicts_node ON verdicts (node_id);
CREATE INDEX solves_date ON solves (date);
CREATE INDEX steps_node ON steps (node_id);
"""


def main():
    nodes, problems, evidence = load_nodes(), load_problems(), load_evidence()
    if os.path.exists(DB):
        os.remove(DB)
    con = sqlite3.connect(DB)
    con.executescript(SCHEMA)

    for nid, n in nodes.items():
        con.execute(
            "INSERT INTO nodes VALUES (?,?,?,?,?,?,?)",
            (nid, n.get("name"), n.get("group"), n.get("added"),
             n.get("desc"), n.get("hint"), n.get("drill")),
        )
        con.executemany("INSERT INTO prereqs VALUES (?,?)",
                        [(nid, p) for p in n.get("prereqs", [])])
        con.executemany("INSERT INTO node_refs VALUES (?,?)",
                        [(nid, r) for r in n.get("refs", [])])

    for num, p in problems.items():
        con.execute(
            "INSERT INTO problems VALUES (?,?,?,?,?,?)",
            (num, p.get("title"), p.get("difficulty"), p.get("source"),
             p.get("note"), int(bool(p.get("banned")))),
        )
        con.executemany("INSERT INTO steps VALUES (?,?,?)",
                        [(num, i, m) for i, m in enumerate(p.get("moves", []))])
        con.executemany(
            "INSERT INTO alt_steps VALUES (?,?,?,?)",
            [(num, w, i, m)
             for w, walk in enumerate(p.get("alt_steps", []))
             for i, m in enumerate(walk)],
        )
        con.executemany("INSERT INTO problem_after VALUES (?,?)",
                        [(num, a) for a in p.get("after", [])])
        con.executemany("INSERT INTO problem_unmapped VALUES (?,?)",
                        [(num, t) for t in p.get("unmapped", [])])

    edges = load_drills()
    for path in sorted(glob.glob(os.path.join(DRILLS_DIR, "*", "*.py"))):
        title = drill_title(path)
        if title is None:
            continue
        did = drill_id(path)
        if did is None:
            continue
        rel = os.path.relpath(path, os.path.dirname(GRAPH_DIR))
        con.execute("INSERT OR IGNORE INTO drills VALUES (?,?,?,?)",
                    (did, title, rel, os.path.basename(os.path.dirname(path))))
        con.executemany("INSERT OR IGNORE INTO drill_trains VALUES (?,?)",
                        [(did, n) for n in drill_trains(path)])
        con.executemany("INSERT OR IGNORE INTO drill_after VALUES (?,?)",
                        [(did, a) for a in edges.get(did, {}).get("after", [])])

    for fname, rec in evidence.items():
        con.execute(
            "INSERT INTO solves VALUES (?,?,?,?,?)",
            (fname, rec.get("date"), rec.get("problem"), assist_of(rec), rec.get("note")),
        )
        con.executemany("INSERT INTO verdicts VALUES (?,?,?)",
                        [(fname, m, v) for m, v in rec.get("moves", {}).items()])
        con.executemany("INSERT INTO solve_unmapped VALUES (?,?)",
                        [(fname, t) for t in rec.get("unmapped", [])])

    con.commit()
    counts = {t: con.execute(f'SELECT count(*) FROM "{t}"').fetchone()[0]
              for t in ("nodes", "prereqs", "problems", "steps",
                        "solves", "verdicts")}
    con.close()
    print(f"{os.path.relpath(DB)}: " + ", ".join(f"{v} {k}" for k, v in counts.items()))
    print(f"sqlite3 {os.path.relpath(DB)}")


if __name__ == "__main__":
    main()
