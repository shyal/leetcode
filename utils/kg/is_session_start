#!/usr/bin/env python3

# is_session_start — predicate: is this the start of the session?
#
# True when fewer than NEXT_WARMUP_COUNT (env, default 2; 0 turns the
# warmup off) solves have been authored since local
# midnight (Asia/Manila — git stamps are UTC, and the evidence-folding
# amend rewrites commit dates, so it counts by AUTHOR date of commits
# that ADD files under solved/ or drills/; meta and tooling commits
# never count).
#
# Prints true/false; exit code 0/1 to match.
#
#   make is_session_start

import os
import re
import subprocess
import sys
from datetime import datetime
from zoneinfo import ZoneInfo

from kg.kg_lib import GRAPH_DIR

MANILA = ZoneInfo("Asia/Manila")
# how many warmups open a session; set in .envrc, read through kg_lib.load_envrc
THRESHOLD = int(os.environ.get("NEXT_WARMUP_COUNT", 2))


def solves_today():
    """Solve files authored since local midnight (added, not just touched).
    Author date, not commit date: a solve committed or amended hours later
    still belongs to the sitting where it was actually solved."""
    midnight = datetime.now(tz=MANILA).replace(hour=0, minute=0, second=0,
                                               microsecond=0)
    out = subprocess.run(
        ["git", "log", "--since=3.days", "--diff-filter=A", "--format=@%at",
         "--name-only", "--", "solved/", "drills/"],
        capture_output=True, text=True,
        cwd=os.path.dirname(GRAPH_DIR)).stdout.split()
    solves, today = set(), False
    for tok in out:
        if tok.startswith("@"):
            authored = datetime.fromtimestamp(int(tok[1:]), tz=MANILA)
            today = authored >= midnight
        elif today:
            solves.add(tok)
    return sorted(solves)


def solve_seconds_today():
    """Total seconds of recorded solving since local midnight, from the
    'solve time: Xm Ys' trailer `make solved` writes into each solve commit.
    Same commit set as solves_today: author date, adds under solved/drills."""
    midnight = datetime.now(tz=MANILA).replace(hour=0, minute=0, second=0,
                                               microsecond=0)
    out = subprocess.run(
        ["git", "log", "--since=3.days", "--diff-filter=A",
         "--format=%x01%at%x01%B", "--", "solved/", "drills/"],
        capture_output=True, text=True,
        cwd=os.path.dirname(GRAPH_DIR)).stdout
    parts = out.split("\x01")[1:]
    total = 0
    for ts, body in zip(parts[::2], parts[1::2]):
        authored = datetime.fromtimestamp(int(ts), tz=MANILA)
        if authored < midnight:
            continue
        m = re.search(r"solve time: (\d+)m (\d+)s", body)
        if m:
            total += int(m.group(1)) * 60 + int(m.group(2))
    return total


def main():
    start = len(solves_today()) < THRESHOLD
    print("true" if start else "false")
    sys.exit(0 if start else 1)


if __name__ == "__main__":
    main()
