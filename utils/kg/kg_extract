#!/usr/bin/env python3

# kg_extract — populate graph/evidence.json (and problems.json) from solved/ files.
#
# For each solve file not already in evidence.json: ONE small claude call
# (taxonomy + that file's code — no history) extracting which moves the
# actual code exercised, with verdicts. Incremental and resumable: results
# are written back after every file, so interrupting is always safe.
#
#   utils/kg/kg_extract --limit 5          # trial run on the 5 newest unprocessed
#   utils/kg/kg_extract                    # process everything unprocessed
#   utils/kg/kg_extract --model sonnet     # default is haiku (cheap/fast)

import argparse
import glob
import json
import os
import re
import subprocess
import sys
import threading
from concurrent.futures import ThreadPoolExecutor, as_completed
from rich.console import Console

from history.history_builder import parse_content
from kg.kg_lib import (
    load_nodes, load_problems, load_evidence,
    save_problems, save_evidence, claude_json, taxonomy_summary, node_status,
    manila_date_from_filename, load_predicted, unlocks,
    HARNESS_ENV_NOTE, SOLID, apply_assist_floor, assist_tag, normalise_assist,
    notes_assist_level,
)
from kg import recognition as rc

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
VENV_PY = os.path.join(REPO_ROOT, ".venv", "bin", "python3")
RUN_TIMEOUT = 30


def strip_statement(code):
    """Drop the leading problem statement, keep the code AND the candidate's
    notes. `make prepare` writes the statement as a module docstring and the
    candidate appends notes to it below a `---` rule, so a blanket docstring
    strip silently discarded every note ever written — the one place a peek,
    a hint, or a TLE is ever recorded. Notes are split out by the AST parser
    in history_builder (tested by utils/tests/test_history_builder.py) rather than
    by a second, private regex; the body stays raw so inline comments — also
    candidate notes — survive into the judge's prompt."""
    body = re.sub(r'^""".*?"""\s*', "", code, count=1, flags=re.S)
    try:
        notes, _ = parse_content(code)
    except SyntaxError:  # abandoned attempt / half-typed file
        return body
    return f"{notes}\n\n{body}" if notes.strip() else body


def lookup_difficulty(pnum):
    """Difficulty from the repo's data/problems_metadata.json cache (the same file
    the readme updater reads); empty string when the cache lacks the problem."""
    try:
        with open(os.path.join(REPO_ROOT, "data/problems_metadata.json")) as f:
            return json.load(f).get(str(pnum), {}).get("difficulty", "")
    except OSError:
        return ""


def run_solve(path):
    """Execute a solve file the way the candidate does and report what actually
    happened. Static reading alone mistakes passing negative assertions
    (`assert f(x) is False`) for failures and harness builtins for NameErrors —
    the interpreter is the only authority on whether the solve works."""
    env = dict(os.environ)
    # REPO_ROOT must be importable too: python puts the SCRIPT's dir (solved/)
    # at sys.path[0], not the cwd, so without this `from dsa...` imports that
    # pass under `make` blow up only here and read as false struggles.
    env["PYTHONPATH"] = os.pathsep.join(
        [REPO_ROOT, os.path.join(REPO_ROOT, "utils"), os.path.join(REPO_ROOT, "utils", "harness"), env.get("PYTHONPATH", "")])
    py = VENV_PY if os.path.exists(VENV_PY) else sys.executable
    try:
        p = subprocess.run(
            [py, os.path.abspath(path)], cwd=REPO_ROOT, env=env,
            capture_output=True, text=True, timeout=RUN_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return {"status": "timeout", "detail": f"exceeded {RUN_TIMEOUT}s — likely TLE or an infinite loop"}
    except Exception as e:  # interpreter missing, unreadable file, ...
        return {"status": "unknown", "detail": f"could not execute: {str(e)[:200]}"}
    if p.returncode == 0:
        return {"status": "passed", "detail": (p.stdout or "").strip()[-600:]}
    return {"status": "failed", "detail": (p.stderr or p.stdout or "").strip()[-800:]}


def runtime_note(res):
    """One authoritative paragraph about the run, for the judge's prompt."""
    if res["status"] == "passed":
        return (
            "RUNTIME RESULT (authoritative): the file was EXECUTED and exited 0 — every "
            "active assertion passed and no exception was raised. The solution WORKS. Do "
            "NOT report bugs, failing assertions, or undefined names; if you think you see "
            "one, you have misread the code. Note that `assert f(x) is False` PASSES when "
            "f(x) returns False — a negative expectation is not a failure. Judge only "
            "WHICH technique moves the working code exercises."
            + (f"\nProgram output:\n{res['detail']}" if res["detail"] else "")
        )
    if res["status"] == "failed":
        return (
            "RUNTIME RESULT (authoritative): the file was EXECUTED and exited NON-ZERO. "
            "It genuinely fails. Use the traceback below as the evidence for any "
            "'struggled' verdict, and quote the real error in the note.\n"
            f"{res['detail']}"
        )
    if res["status"] == "timeout":
        return (
            "RUNTIME RESULT (authoritative): the file was EXECUTED and TIMED OUT "
            f"({res['detail']}). Treat the move responsible for the complexity blowup as "
            "'struggled'."
        )
    return (
        "RUNTIME RESULT: the file could not be executed, so judge statically — but "
        f"assume the code works unless a bug is unmistakable. ({res['detail']})"
    )


def record_alt_walk(problems, pnum, moves, skipped):
    """Record the walk this solve actually took as an alt walk on the problem,
    when it routed around a mapped move. True if problems changed.

    The walk may legitimately be EMPTY: the solve sidestepped the mapped move
    and used nothing else in the taxonomy either (a plain nested loop where
    the map claims a technique). That is the single most informative case —
    it is the map being contradicted outright — and guarding the write on a
    non-empty walk silently dropped exactly those, so a bad edge survived
    every solve that disproved it. dodgeable() reads `target not in walk`,
    which an empty walk satisfies, and the other two readers skip it.
    """
    taken = sorted(mv for mv, v in moves.items() if v == "clean")
    pentry = problems.get(pnum)
    if pentry is None or not skipped or taken in pentry.get("alt_walks", []):
        return False
    pentry.setdefault("alt_walks", []).append(taken)
    return True


VERDICT_STYLE = {"clean": "green", "struggled": "red", "avoided": "yellow"}

console = Console()

FNAME_RE = re.compile(r"p(\d+)_(.+?)_\d{4}_\d{2}_\d{2}T")
TRAINS_RE = re.compile(r"TRAINS:\s*([a-z0-9\-, ]+)")


def serve_receipt(pnum, moves, pre_moves, was_mapped, nodes, problems,
                  evidence, before_ev, predicted=None):
    """Rich-markup lines explaining what this solve meant to the graph.

    What the problem was serving is derived, never stored (the same way
    mastery is): the non-solid moves, before this solve, of its mapped walk
    plus any drafted walk. For each such move: did it get its rep, and what
    did that do to its status — plus the reachability payoff when it went
    SOLID. For a promoted problem, how the evidenced walk corrected the
    draft. Facts only: an alternative walk is stated as what happened,
    never as a verdict on the candidate."""
    if predicted is None:
        predicted = load_predicted()
    drafted = [w.get("moves", []) for w in
               predicted.get(pnum, {}).get("walks", [])]
    expected = list(dict.fromkeys(pre_moves + [m for w in drafted for m in w]))
    targets = [m for m in expected if m in nodes
               and node_status(m, before_ev)[0] != SOLID]
    lines = []
    for t in targets:
        b, _ = node_status(t, before_ev)
        a, _ = node_status(t, evidence)
        if t in moves:
            line = (f"served for [bold]{t}[/bold]: {b} → {a}" if a != b
                    else f"served for [bold]{t}[/bold]: got its rep, stays {a}")
            if a == SOLID and b != SOLID:
                statuses_before = {n: node_status(n, before_ev) for n in nodes}
                gained = unlocks(statuses_before, problems, predicted).get(t, 0)
                if gained:
                    line += (f" — brings {gained} drafted problem"
                             f"{'s' if gained != 1 else ''} into reach")
        elif moves:
            line = (f"served for [bold]{t}[/bold] — the code went "
                    f"{', '.join(moves)} instead; {t} stays {a}")
        else:
            line = (f"served for [bold]{t}[/bold] — the solve evidenced "
                    f"no moves; {t} stays {a}")
        lines.append(line)
    if not was_mapped and drafted and moves:
        # parentheses, not square brackets: these lines go through rich
        # console.print, which eats [ ... ] as markup tags
        guess = ", ".join(dict.fromkeys(m for w in drafted for m in w))
        lines.append(f"draft guessed ({guess}) → evidenced ({', '.join(moves)})")
    return lines


def main():
    parser = argparse.ArgumentParser(description="Extract move evidence from solved files.")
    parser.add_argument("--limit", type=int, default=0, help="max files this run (0 = all)")
    parser.add_argument("--model", default="haiku", help="model for extraction calls")
    parser.add_argument("--workers", type=int, default=8, help="concurrent extraction calls")
    args = parser.parse_args()

    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()
    recog = rc.load_recognition()
    taxonomy = taxonomy_summary(nodes)

    files = sorted(glob.glob("solved/*.py"), key=os.path.getmtime, reverse=True)
    todo = [f for f in files if f not in evidence]
    if args.limit:
        todo = todo[: args.limit]
    console.print(f"{len(files)} solve files, {len(todo)} to process this run.\n")

    system = f"""You judge which atomic technique moves a candidate's LeetCode solution ACTUALLY exercised.

Taxonomy (use ONLY these ids):
{taxonomy}

Rules:
- {HARNESS_ENV_NOTE}
- Every file is EXECUTED for you before you see it, and the result is stated in the prompt. That result OUTWEIGHS your reading of the source in every case. If the run passed, the code is correct — no "struggled" for suspected bugs, and no note claiming a failure. Only a non-zero exit, a timeout, or the candidate's own notes (looked-up/hints/TLE/failed) justify "struggled".
- Judge the code as written, not the problem's canonical solution. Batch math on a streaming-carrier problem means the streaming move was NOT exercised — if the canonical solution's central move was sidestepped by an alternative approach, record that move as "avoided".
- Verdicts: "clean" (executed correctly), "struggled" (bugs/confusion visible in code or notes, e.g. notes saying looked-up/hints/TLE/failed), "avoided" (canonical move sidestepped).
- A drill file (DRILL: header) is a rung written to train exactly its TRAINS node. If it ran and its REQUIRED line is met, that node is "clean", whatever API spelling the code used: select("a", "b") trains a column-expression rung as well as select(F.col("a")) does. "avoided" is for a leetcode carrier whose central move was sidestepped, never for a drill that passed.
- "assist" is a SEPARATE axis from the verdict, read ONLY from the candidate's own notes — never inferred from how the code looks. A confident-looking solve with a note saying it was walked through is "walkthrough"; a messy solve with no note is "none". Levels: "none" (no note claiming help), "hint" (a nudge, a question, a pointer at the wrong branch), "walkthrough" (the approach/recurrence was talked through before the code existed), "learning" (the solution was given and copied). An explicit `ASSIST: <level>` line in the notes overrides your reading. Assist is PER MOVE: when the notes say what the help was on ("assisted on the window bookkeeping, the prefix sums were mine"), put the level on that move only and leave the others out, because a level on a move says the candidate could not recall THAT move unaided. When the notes claim help without saying where, put the level on every move in "moves". Omit the key, or use {{}}, when there was no help.
- Only include moves with real evidence in this code. 1-6 moves is typical.
- If a required move has no taxonomy node, put a 3-8 word description in "unmapped".
- If the file has no working solution (skeleton body, abandoned attempt), still return the JSON with "moves": {{}} and a note like "abandoned attempt" — never prose.
- "recognition": read ONLY from the candidate's own notes, like assist. When the notes say a move was not seen from the statement ("recognition failure", "failed to see it was binary search on the answer", "didn't recognise the monotonic stack"), list that move's id under "missed". A move being wrong or slow is not a recognition miss; only the notes saying it was not recognised is. Omit the key when the notes say nothing of the kind.
- "summary": 2-4 sentences of plain english for the candidate to read after filing: what the code does and how, which moves it exercised, and what the notes say happened (hints, look-ups, TLEs, dead ends) if anything. Facts only: no praise, no grading, no advice, no adjectives about the candidate. Refer to the code by its real names (its variables, clauses, functions).

Output STRICT JSON only:
{{"problem": "<number>", "title": "<title>", "moves": {{"<node-id>": "clean|struggled|avoided"}}, "assist": {{"<node-id>": "hint|walkthrough|learning"}}, "recognition": {{"missed": ["<node-id>"]}}, "unmapped": [], "note": "<one line, only if noteworthy>", "summary": "<2-4 sentences>"}}"""

    def extract_one(path):
        """Read + claude call only — no shared state touched here."""
        code = open(path).read()
        # a drill is a drill even when its filename lacks the d_ prefix
        # (p1_read_the_operator): the DRILL: header is authoritative —
        # without this, the p<digit> prefix reads as a leetcode number and
        # the drill's evidence and alt_walks land on that problem (Two Sum
        # once grew a recursive-descent alt walk this way)
        is_drill = os.path.basename(path).startswith("d_") \
            or bool(re.search(r"^\s*\**DRILL:", code, flags=re.M))
        trains = []
        if is_drill:
            m = TRAINS_RE.search(code)
            trains = [t.strip() for t in m.group(1).split(",")] if m else []
        # strip the problem statement to keep the prompt small — but the
        # candidate's notes live INSIDE that docstring, below a `---` rule,
        # and they are the only source for struggles and assist. Keep them.
        body = strip_statement(code)[:6000]
        prompt = f"File: {os.path.basename(path)}\n\n{runtime_note(run_solve(path))}\n\n{body}"
        if is_drill:
            prompt = (
                f"This is a DRILL file targeting these taxonomy nodes: {', '.join(trains) or 'unknown'}. "
                f"Judge at least those moves.\n\n{prompt}"
            )
        else:
            # tell the judge what the canonical walk IS, so avoidance is
            # detected against the map instead of by luck
            fm = FNAME_RE.search(os.path.basename(path))
            canon = problems.get(fm.group(1), {}).get("moves") if fm else None
            if canon:
                prompt = (
                    f"This problem's canonical walk in our curated map: {', '.join(canon)}. "
                    f"Judge EVERY one of those moves explicitly: 'clean' or 'struggled' if the "
                    f"code exercises it, 'avoided' if the solution routes around it. Also add "
                    f"any other moves the code actually exercises.\n\n{prompt}"
                )
        try:
            notes, _ = parse_content(code)
        except SyntaxError:
            notes = ""
        return claude_json(prompt, system, model=args.model), is_drill, trains, notes

    lock = threading.Lock()
    done = failed = 0
    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = {pool.submit(extract_one, path): path for path in todo}
        for fut in as_completed(futures):
            path = futures[fut]
            try:
                result, is_drill, trains, notes = fut.result()
            except Exception as e:
                failed += 1
                console.print(f"[red]FAIL {path}: {str(e)[:200]}[/red]")
                continue

            m = FNAME_RE.search(os.path.basename(path))
            # Manila day, not the raw UTC digits in the name — a solve after
            # Manila midnight (16:00Z) otherwise lands a day behind and its
            # drill gets re-offered as un-drilled the same night.
            solve_date = manila_date_from_filename(path) or "1970-01-01"
            judged = {k: v for k, v in result.get("moves", {}).items() if k in nodes}
            rejected = [k for k in result.get("moves", {}) if k not in nodes]
            # free-mode evidence discipline: record only what the code DID
            # (clean/struggled). A mapped move the solve routed around is not
            # a verdict on the candidate — it only marks this problem as
            # having an alternative walk. Style is enforced by `make force`,
            # before the merge, never here.
            moves = {k: v for k, v in judged.items() if v != "avoided"}
            skipped = {k for k, v in judged.items() if v == "avoided"}
            if not is_drill and m:
                for mv in problems.get(m.group(1), {}).get("moves", []):
                    if mv in nodes and mv not in judged:
                        skipped.add(mv)
            entry = {
                "date": solve_date,
                "problem": "drill" if is_drill else (result.get("problem") or (m.group(1) if m else "?")),
                "moves": moves,
            }
            assist = normalise_assist(result.get("assist"), moves)
            # the level word in the candidate's notes ("asked for a
            # walkthrough") is the mark, whatever the judge made of it: on a
            # drill it lands on the TRAINS node, on a problem on every move
            floor = notes_assist_level(notes)
            targets = [t for t in trains if t in moves] if is_drill else []
            assist = apply_assist_floor(assist, floor, targets or list(moves))
            # a problem whose statement was served as a spot rep and MISSED
            # had its walk revealed after the answer: a later solve of it is
            # not unaided. After a hit it is - the reveal showed nothing the
            # candidate had not produced (settled 2026-09-01)
            spotted = None if is_drill else rc.spotted_before(
                entry["problem"], solve_date, recog)
            if spotted and spotted[1] == rc.MISSED:
                assist = apply_assist_floor(assist, "hint", list(moves))
            if assist:
                entry["assist"] = assist
            # the recognition axis: a miss the notes name (the judge's
            # reading, or the words themselves on the canonical entry move)
            missed = [n for n in (result.get("recognition") or {}).get("missed", [])
                      if n in nodes]
            if not missed and not is_drill and rc.notes_say_missed(notes):
                missed = rc.entry_nodes(entry["problem"], problems)[:1]
            if result.get("note"):
                entry["note"] = result["note"]
            # read back by `solved --commit`, the last step of `make solved`
            if result.get("summary"):
                entry["summary"] = str(result["summary"]).strip()
            if result.get("unmapped") or rejected:
                entry["unmapped"] = result.get("unmapped", []) + rejected

            with lock:
                evidence[path] = entry
                save_evidence(evidence)
                pnum = entry["problem"]
                if missed:
                    recog[path] = {
                        "date": solve_date, "problem": pnum, "kind": "solve",
                        "moves": {n: rc.MISSED for n in missed},
                        "note": "the notes say the move was not recognised",
                    }
                    rc.save_recognition(recog)
                    console.print(f"    [red]recognition miss on [bold]{', '.join(missed)}[/bold][/red] (from the notes)")
                if spotted:
                    d, v = spotted
                    console.print(f"    [dim]spotted {d} ({v})"
                                  f"{': assist floored to hint' if v == rc.MISSED else ''}[/dim]")
                was_mapped = pnum in problems
                pre_moves = list(problems.get(pnum, {}).get("moves", []))
                # a skipped mapped move IS a discovered alt walk — record it so
                # the picker knows this carrier is escapable and routes around it
                if not is_drill and record_alt_walk(problems, pnum, moves, skipped):
                    save_problems(problems)
                if not is_drill and pnum not in problems and moves:
                    problems[pnum] = {
                        "title": result.get("title", (m.group(2).replace("_", " ") if m else "")),
                        "difficulty": lookup_difficulty(pnum),
                        "moves": list(moves.keys()),
                        "source": "extracted",
                    }
                    save_problems(problems)
                done += 1
                painted = ", ".join(
                    f"[{VERDICT_STYLE.get(v, 'white')}]{mv}[/{VERDICT_STYLE.get(v, 'white')}]"
                    for mv, v in moves.items())
                tag = (f" [yellow](assist: {assist_tag(entry['assist'])})[/yellow]"
                       if "assist" in entry else "")
                console.print(
                    f"[green]{done}/{len(todo)}[/green] {os.path.basename(path)[:60]} → {painted or '—'}{tag}"
                )
                # the receipt: struggles change the graph — say so
                before_ev = {k: v for k, v in evidence.items() if k != path}
                for mv, verdict in moves.items():
                    if verdict != "struggled":
                        continue
                    b, _ = node_status(mv, before_ev)
                    a, _ = node_status(mv, evidence)
                    change = f"[red]{b} → {a}[/red]" if a != b else f"stays {a}"
                    console.print(f"    [red]⚠ struggled on [bold]{mv}[/bold][/red] ({change})")
                if not is_drill:
                    for line in serve_receipt(pnum, list(moves), pre_moves,
                                              was_mapped, nodes, problems,
                                              evidence, before_ev):
                        console.print(f"    [dim]{line}[/dim]")

    console.print(
        f"\nDone: {done} processed, {failed} failed (re-run to retry), "
        f"evidence.json now has {len(evidence)} entries."
    )
    judge_spots(nodes, problems, recog, args.model)


def judge_spots(nodes, problems, recog, model):
    """Score every recognition/*.md not yet in recognition.json: one small
    claude call maps the free-text answer onto node ids, the verdict is
    computed against the walk's entry moves (kg.recognition.score). A
    problem with no walk in problems.json gets the mapping call first."""
    for path in rc.pending_spots(recog):
        text = open(path).read()
        foot = rc.read_footer(text)
        m = rc.SPOT_FNAME_RE.search(os.path.basename(path))
        pnum = str(foot.get("problem") or (m.group(1) if m else "?"))
        statement, answer = rc.split_answer(text)
        title = problems.get(pnum, {}).get("title", "")
        if not problems.get(pnum, {}).get("moves"):
            console.print(f"[dim]{pnum} has no walk - one claude call to map it (cached after)...[/dim]")
            try:
                if not title:
                    title = rc.fetch_content(pnum).get("title", "")
                rc.map_problem(pnum, title, nodes, problems)
                save_problems(problems)
                title = problems[pnum].get("title", title)
            except Exception as e:
                console.print(f"[red]FAIL {path}: could not map {pnum}: {str(e)[:200]}[/red]")
                continue
        try:
            named, summary = rc.judge_answer(statement, answer, nodes, model=model)
        except Exception as e:
            console.print(f"[red]FAIL {path}: {str(e)[:200]}[/red]")
            continue
        moves, false = rc.score(named, pnum, problems)
        rec = {
            "date": manila_date_from_filename(path) or "1970-01-01",
            "problem": pnum, "kind": "spot", "title": title,
            "target": foot.get("target"), "reason": foot.get("reason"),
            "seconds": foot.get("seconds", 0),
            "named": named, "walk": list(problems[pnum].get("moves", [])),
            "moves": moves, "false": false, "summary": summary,
        }
        if answer:
            rec["answer"] = answer[:1000]
        # rule 3 for recognition: a valid route the map does not have is
        # never a miss on the candidate. One call on the stronger model
        # decides validity; the hit is marked as an alternative (no code
        # ran) and the walk is filed under spotted_walks, not alt_walks
        if rc.MISSED in moves.values() and named and named == false:
            try:
                valid, why = rc.judge_alternative(statement, answer, named, nodes)
            except Exception as e:
                valid, why = False, f"alternative not judged: {str(e)[:120]}"
            if valid:
                rc.apply_alternative(rec, named, problems, why)
                save_problems(problems)
            else:
                rec["why"] = why
        recog[path] = rec
        rc.save_recognition(recog)
        verdict = ", ".join(f"{n}={v}" for n, v in rec["moves"].items()) or "unscored"
        console.print(f"[green]spot[/green] {os.path.basename(path)[:60]} → {verdict}")


if __name__ == "__main__":
    main()
