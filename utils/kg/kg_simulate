class PassExpectation:
    """The pass model of kg_lib.pass_rates in closed form. A set draws each
    problem uniformly from its difficulty pool and solves it with
    p = time_f[dif] * rec ** REC_POWER[dif] * (best walk's recall product),
    draws independent, so P(both Easies) is the pool mean of p squared,
    and P(onsite) = E^2 * M^2 * (1 - (1 - H)^2). Walks are flattened into
    index arrays once; a day's rates are two reduceats per pool."""

    def __init__(self, pools, node_order, mass):
        self.index = {n: i for i, n in enumerate(node_order)}
        self.derive_slot = len(node_order)  # every off-taxonomy move
        self.beta, self.ref = mass["beta"], mass["ref"]
        self.pools = {}
        for dif, probs in pools.items():
            idx, walk_starts, prob_starts, walk_prob, xs, pos = [], [], [], [], [], 0
            for pi, walks in enumerate(probs):
                prob_starts.append(len(walk_starts))
                for wi, w in enumerate(walks):
                    walk_starts.append(pos)
                    walk_prob.append(pi)
                    xs.append(mass["x"][dif][pi][wi])
                    for m in w:
                        idx.append(self.index.get(m, self.derive_slot))
                    pos += len(w)
            self.pools[dif] = (np.array(idx), np.array(walk_starts),
                               np.array(prob_starts), len(probs),
                               np.array(walk_prob), np.array(xs))

    def rates(self, recall, practice, r_base):
        """(full, onsite, screen, single-hard) as pass_rates returns."""
        time_f, rec, derive = practice_factors(practice, r_base)
        r = np.empty(self.derive_slot + 1)
        for n, i in self.index.items():
            r[i] = recall[n]
        r[self.derive_slot] = derive
        logs = np.log(r)
        p = {}
        for dif, (idx, ws, ps, n, wp, xs) in self.pools.items():
            if not n:
                p[dif] = 0.0
                continue
            walk = np.exp(np.add.reduceat(logs[idx], ws))
            best = np.maximum.reduceat(walk, ps)
            pp = time_f[dif] * rec ** REC_POWER[dif] * best
            if self.beta:
                # the best walk's x (first walk reaching the max, as the draws)
                hit = np.flatnonzero(walk == best[wp])
                _, first = np.unique(wp[hit], return_index=True)
                x = xs[hit[first]]
                pp = np.clip(pp, 1e-9, 1 - 1e-9)
                pp = 1 / (1 + np.exp(-(np.log(pp / (1 - pp))
                                       + self.beta * (x - self.ref[dif]))))
            p[dif] = pp.mean()
        e2, m2 = p["E"] ** 2, p["M"] ** 2
        h1 = 1 - (1 - p["H"]) ** 2
        return e2 * m2 * p["H"] ** 2, e2 * m2 * h1, m2, p["H"]
PACE_WINDOW = 28  # calendar days the pace is averaged over (kg_mock_rs week_pace)


def timed_attempts(evidence, problems, mined):
    """[(date, minutes, kind, verdict)] per timed attempt in the git log:
    kind Easy/Medium/Hard/drill, verdict clean (every move clean, no
    assist) or struggled. The same trailers make mock paces itself by."""
    out = []
    for key, d, secs, fname in mined:
        rec = evidence.get(fname)
        if rec is None:
            continue
        kind = "drill" if key.startswith("d:") else problem_difficulty(key, problems)
        if kind not in ("Easy", "Medium", "Hard", "drill"):
            continue
        clean = all(v == "clean" for v in rec.get("moves", {}).values()) \
            and assist_of(rec) == "none"
        out.append((d, secs / 60, kind, "clean" if clean else "struggled"))
    return out


def week_pace(attempts, today):
    """Hours per calendar day over the last PACE_WINDOW days, cut at the
    first dead week walking back from today (the days before a week-long
    lapse are another streak). Port of kg_mock_rs week_pace."""
    mins = [0.0] * PACE_WINDOW
    for d, m, _, _ in attempts:
        i = (today - d).days
        if 0 <= i < PACE_WINDOW:
            mins[i] += m
    window, run = PACE_WINDOW, 0
    for i, m in enumerate(mins):
        run = run + 1 if m == 0 else 0
        if run == 7:
            window = i + 1 - run
            break
    window = max(window, 7)
    return round(sum(mins[:window]) / window / 60, 1)


def price_table(attempts):
    """(kind, verdict) -> median minutes, with the kind's median as the
    fallback for a verdict never timed, and the overall median for a kind
    never timed."""
    by, by_kind = {}, {}
    for _, m, kind, verdict in attempts:
        by.setdefault((kind, verdict), []).append(m)
        by_kind.setdefault(kind, []).append(m)
    overall = median(m for _, m, _, _ in attempts) if attempts else 15.0
    table = {}
    for kind in ("Easy", "Medium", "Hard", "drill"):
        for verdict in ("clean", "struggled"):
            table[(kind, verdict)] = median(
                by.get((kind, verdict)) or by_kind.get(kind) or [overall])
    return table


AUTHOR_WINDOW = PACE_WINDOW  # calendar days the authoring rate is averaged over


def bank_history(today, drills_dir=None):
    """({node: date its first bank file landed}, {node: files on disk}) from
    the git log of drills/. Only files still on disk count (spark's bank
    was ripped out); an untracked file counts as landed today."""
    drills_dir = drills_dir or kg_lib.DRILLS_DIR
    root = os.path.dirname(drills_dir)
    out = subprocess.run(
        ["git", "log", "--diff-filter=A", "--format=%x00%ad", "--date=short",
         "--name-only", "--", "drills/*/*.py"],
        capture_output=True, text=True, cwd=root).stdout
    first, d = {}, None
    for line in out.splitlines():
        if line.startswith("\x00"):
            d = date.fromisoformat(line[1:])
        elif line.startswith("drills/") and os.path.exists(os.path.join(root, line)):
            first[line] = min(first.get(line, d), d)
    for path in glob.glob(os.path.join(drills_dir, "*", "*.py")):
        first.setdefault(os.path.relpath(path, root), today)
    banked, sizes = {}, {}
    for rel, d in first.items():
        node = rel.split(os.sep)[1]
        banked[node] = min(banked.get(node, d), d)
        sizes[node] = sizes.get(node, 0) + 1
    return banked, sizes


def measured_bank_rate(banked, today):
    """New banks per calendar day over the last AUTHOR_WINDOW days."""
    n = sum(1 for d in banked.values() if 0 <= (today - d).days < AUTHOR_WINDOW)
    return round(n / AUTHOR_WINDOW, 2)


class ScratchBank:
    """A scratch copy of drills/ the run authors into: every real bank file
    linked in, virtual files written beside them. kg_lib and kg_next read
    DRILLS_DIR at call time, so the run points both at the copy and puts
    them back after."""

    def __init__(self, real):
        self.real = real
        self.root = tempfile.mkdtemp(prefix="kg_simulate_bank_")
        for path in glob.glob(os.path.join(real, "*", "*.py")):
            node = os.path.basename(os.path.dirname(path))
            os.makedirs(os.path.join(self.root, node), exist_ok=True)
            os.symlink(path, os.path.join(self.root, node, os.path.basename(path)))
        self.authored = {}  # node -> virtual files written

    def author(self, node, files):
        """Write `files` virtual bank files for node: a DRILL title and a
        TRAINS line, nothing else. No drills.json entry, so the file comes
        after nothing; TRAINS only its node, so it holds on no other."""
        d = os.path.join(self.root, node)
        os.makedirs(d, exist_ok=True)
        for _ in range(files):
            k = self.authored.get(node, 0) + 1
            self.authored[node] = k
            with open(os.path.join(d, f"sim_{k}.py"), "w") as f:
                f.write(f'"""\nDRILL: Sim {node} {k}\nTRAINS: {node}\n"""\n')

    def close(self):
        shutil.rmtree(self.root, ignore_errors=True)


def freeze_clock(day):
    """Every date.today() in kg_lib and kg_next answers `day`."""
    class SimDate(date):
        @classmethod
        def today(cls):
            return day
    kg_lib.date = SimDate
    kg_next.date = SimDate


def first_contact(evidence):
    """Measured first-contact absorption: the share of nodes whose first
    ever rep was clean (kg_mock_rs measured_first_contact). The teach rate
    for a simulated first exposure is 0.8 of it, capped at 0.85."""
    first = {}
    for fname in sorted(evidence):
        rec = evidence[fname]
        for node, v in rec.get("moves", {}).items():
            key = (rec["date"], fname)
            if node not in first or key < first[node][0]:
                first[node] = (key, v)
    if not first:
        return 0.7
    return sum(1 for _, v in first.values() if v == "clean") / len(first)


def build_pools(problems, predicted, nodes):
    """{"E"/"M"/"H": [problem, ...]}, each problem a list of walks, as
    kg_mock_rs Bank::build reads them: evidenced walks plus drafted ones,
    missing-move names folded in as off-taxonomy moves."""
    meta = kg_lib._metadata()
    pools = {"E": [], "M": [], "H": []}
    raw = {}

    def dif_of(num, obj):
        d = obj.get("difficulty") or meta.get(str(num), {}).get("difficulty")
        return {"Easy": "E", "Medium": "M", "Hard": "H"}.get(d)

    def walk_of(v):
        w = list(v.get("moves", []))
        for m in v.get("missing", []) or []:
            name = m.strip().lower().replace(" ", "-")
            if name and not name.startswith("brute-force"):
                w.append(name)
        return w

    for num, p in problems.items():
        d = dif_of(num, p)
        w = walk_of(p)
        if d and w:
            raw.setdefault(num, (d, []))[1].append(w)
    for num, p in predicted.items():
        d = dif_of(num, p)
        if not d:
            continue
        for wv in p.get("walks", []):
            w = walk_of(wv)
            if w:
                raw.setdefault(num, (d, []))[1].append(w)
    for d, walks in raw.values():
        pools[d].append(walks)
    return pools


STARVED_DAYS = kg_lib.STARVED_DAYS  # a node rusty this long with no pick aimed at it is starved


def run(hours=None, seed=1, days=MAX_DAYS, every=7, hard_sat=None,
        mock_sat=None, cold_per_mock=None, draft_error=0.0, log=print,
        bank_rate=None):
    """The simulation. Prints the rows through `log` (pass a no-op for a
    silent run) and returns a dict: day (the last day run), onsite, hours,
    source ("given"/"measured"), per_kind, dry_days, short_days, rusty (per
    day: (day_no, stale, fragile, missing) at the first pick of the day),
    and starved: {node: days} for every node that was STALE or FRAGILE on
    STARVED_DAYS or more consecutive days with no pick aimed at it - the
    longest such run; and series: one dict per simulated day (day, solves
    per kind that day, stale/fragile/missing counts at the end of the day,
    onsite/screen/hard rates) for the README forecast chart; and authored:
    {nodes, files, rate, source} - the virtual banks the run wrote
    (bank_rate None = the measured rate, 0 = none). The picker's rules make a rusty node servable within
    days, so such a run is a hold nothing clears. A node picked and failed
    over and over is not starved: that is the draw, not the picker.
    kg_lib's date, HARD_SAT, MOCK_SAT,
    COLD_SOLVES_PER_MOCK, load_predicted and mined_solve_times are patched
    for the run and restored after."""
    saved = (kg_lib.date, kg_next.date, kg_lib.HARD_SAT, kg_lib.MOCK_SAT,
             kg_lib.COLD_SOLVES_PER_MOCK, kg_lib.load_predicted,
             kg_lib.mined_solve_times, kg_lib.slept_branches,
             kg_lib.branch_events, kg_lib.DRILLS_DIR, kg_next.DRILLS_DIR)
    # the -slept branches do not move during a run, but sleep_records
    # (via the recognition axis, every ready_hards call) would shell out
    # to git for them on every pick: read each once
    branches = memo(kg_lib.slept_branches)
    events = memo(kg_lib.branch_events)
    kg_lib.slept_branches = branches
    kg_lib.branch_events = events
    bank = ScratchBank(kg_lib.DRILLS_DIR)
    kg_lib.DRILLS_DIR = kg_next.DRILLS_DIR = bank.root
    try:
        return _run(hours, seed, days, every, hard_sat, mock_sat,
                    cold_per_mock, draft_error, log, bank, bank_rate)
    finally:
        (kg_lib.date, kg_next.date, kg_lib.HARD_SAT, kg_lib.MOCK_SAT,
         kg_lib.COLD_SOLVES_PER_MOCK, kg_lib.load_predicted,
         kg_lib.mined_solve_times, kg_lib.slept_branches,
         kg_lib.branch_events, kg_lib.DRILLS_DIR, kg_next.DRILLS_DIR) = saved
        bank.close()


def memo(fn):
    cache = {}

    def wrapped(*args):
        if args not in cache:
            cache[args] = fn(*args)
        return cache[args]
    return wrapped


def _run(hours, seed, days, every, hard_sat, mock_sat, cold_per_mock,
         draft_error, log, bank, bank_rate):
    if hard_sat is not None:
        kg_lib.HARD_SAT = hard_sat
    if mock_sat is not None:
        kg_lib.MOCK_SAT = mock_sat
    if cold_per_mock is not None:
        kg_lib.COLD_SOLVES_PER_MOCK = cold_per_mock

    rng = random.Random(seed)
    nodes = load_nodes()
    problems = load_problems()
    evidence = dict(load_evidence())
    predicted = load_predicted()
    curve = kg_lib._load_curve()
    if not curve:
        sys.exit("graph/curve.json missing - run make curve first")
    kg_lib.load_predicted = lambda: predicted
    mined = kg_lib.mined_solve_times(with_file=True)
    kg_lib.mined_solve_times = lambda with_file=False: [r[:3] for r in mined]

    pools = build_pools(problems, predicted, nodes)
    mass = mass_term(pools, problems, curve)
    expect = PassExpectation(pools, list(nodes), mass)
    teach = min(first_contact(evidence) * 0.8, 0.85)
    asleep, _ = sleep_state(nodes, problems, evidence)
    r_base = SCENARIOS["central"]
    start = date.today()
    attempts = timed_attempts(evidence, problems, mined)
    prices = price_table(attempts)
    measured = week_pace(attempts, start)
    given = hours is not None
    hours = hours if given else measured
    if hours <= 0:
        sys.exit("measured pace is 0h/day - pass hours explicitly")
    banked, sizes = bank_history(start, bank.real)
    measured_rate = measured_bank_rate(banked, start)
    rate = measured_rate if bank_rate is None else bank_rate
    size_pool = sorted(sizes.values()) or [1]
    author_budget = 0.0
    authored_files = 0
    rate_src = "given" if bank_rate is not None else (
        f"measured: {sum(1 for d in banked.values() if 0 <= (start - d).days < AUTHOR_WINDOW)}"
        f" nodes banked in the last {AUTHOR_WINDOW} days")

    def rates(day, practice, recall=None):
        if recall is None:
            recall = current_recall(nodes, evidence, curve, today=day)
        return expect.rates(recall, practice, r_base)

    def price(kind, clean):
        return prices[(kind, "clean" if clean else "struggled")]

    mediums = hards = cold = 0
    seen = {str(r.get("problem")) for r in evidence.values()}
    per_kind = {"Easy": 0, "Medium": 0, "Hard": 0, "drill": 0}
    seq = 0
    dry_days = 0      # days the picker served nothing at all
    short_days = 0    # days it ran out before half the hours were used
    rusty = []        # (day_no, stale, fragile, missing) at the first pick
    streak = {n: 0 for n in nodes}  # consecutive rusty days, no pick aimed
    starved = {}      # node -> longest such run
    series = []       # per day, for the README forecast chart
    src = "given" if given else \
        f"measured: avg of the current streak, {measured:g}h"
    knobs = []
    if kg_lib.HARD_SAT != 15: knobs.append(f"hard-sat {kg_lib.HARD_SAT:g}")
    if kg_lib.MOCK_SAT != 8: knobs.append(f"mock-sat {kg_lib.MOCK_SAT:g}")
    if kg_lib.COLD_SOLVES_PER_MOCK != 6:
        knobs.append(f"cold-per-mock {kg_lib.COLD_SOLVES_PER_MOCK}")
    if draft_error: knobs.append(f"draft-error {draft_error:g}")
    if knobs:
        log("model knobs off their defaults: " + ", ".join(knobs))
    log(f"policy: kg_next.pick at {hours:g}h/day ({src}), seed {seed}; "
        f"teach {teach:.2f}, curve {os.path.basename(GRAPH_DIR)}/curve.json")
    log(f"rehearsal-mass term: beta {mass['beta']:+.2f} per unit of ln(1+mass) "
        f"(curve.json; 0 = unfitted)")
    log(f"drill authoring: {rate:g} new banks/day ({rate_src}), size drawn from "
        f"the {len(size_pool)} banks on disk (median {median(size_pool):g} files); "
        f"{sum(1 for n in nodes if n not in banked)} of {len(nodes)} nodes bankless today")
    log("price per attempt, measured medians (clean / struggled): "
        + ", ".join(f"{k} {prices[(k, 'clean')]:.0f}/{prices[(k, 'struggled')]:.0f}m"
                    for k in ("Easy", "Medium", "Hard", "drill")))
    log(f"{'day':>4}  {'date':10}  {'solves':>6}  {'solid':>5}  {'young':>5}  "
        f"{'reach':>9}  {'P(hard)':>7}  {'P(screen)':>9}  {'P(onsite)':>9}")

    def report(day_no, day, practice, solves_today, statuses=None, recall=None):
        if statuses is None:
            statuses = {n: node_status(n, evidence, today=day) for n in nodes}
        imm = immature_nodes(nodes, evidence, problems)
        gain = unlocks(statuses, problems, immature=imm)
        blocked = sum(1 for p in predicted if p not in problems
                      and not any(all(statuses[m][0] == SOLID and m not in imm
                                      for m in w["moves"] if m in nodes)
                                  and all(m in nodes for m in w["moves"])
                                  and not w.get("missing")
                                  for w in predicted[p]["walks"]))
        _, onsite, screen, phard = rates(day, practice, recall)
        solid = sum(1 for s in statuses.values() if s[0] == SOLID)
        log(f"{day_no:>4}  {day.isoformat():10}  {solves_today:>6}  {solid:>5}  "
            f"{len(imm):>5}  {len(predicted) - blocked:>4}/{len(predicted):<4}  "
            f"{phard:>6.0%}  {screen:>8.0%}  {onsite:>8.0%}")
        return onsite

    def close_streak(n):
        if streak[n] >= STARVED_DAYS and streak[n] > starved.get(n, 0):
            starved[n] = streak[n]
        streak[n] = 0

    onsite = report(0, start, (0, 0, 0), 0)
    for day_no in range(1, days + 1):
        day = start + timedelta(days=day_no)
        freeze_clock(day)
        budget = hours * 60
        exclude = set()
        solves_today = 0
        touched = {}     # node -> (target?, struggled?) over the day's picks
        today_kind = {k: 0 for k in per_kind}
        # statuses and recall once per day; after a solve only its moves change
        statuses = {n: node_status(n, evidence, today=day) for n in nodes}
        recall = current_recall(nodes, evidence, curve, today=day)
        counts = {s: 0 for s in (SOLID, STALE, FRAGILE, MISSING)}
        for n, s in statuses.items():
            counts[s[0]] += 1
            if s[0] in (STALE, FRAGILE):
                streak[n] += 1
            else:
                close_streak(n)
        rusty.append((day_no, counts[STALE], counts[FRAGILE], counts[MISSING]))
        while budget > 0:
            choice = kg_next.pick(nodes, problems, evidence, statuses,
                                  asleep=asleep, exclude=exclude)
            if not choice:
                break
            target, _, pnum, _ = choice
            close_streak(target)
            seq += 1
            stamp = f"{day.isoformat()}T{seq:06d}_00_00Z"
            if str(pnum).startswith("drill:"):
                path = kg_lib.due_drill(target, evidence, today=day)
                if not path:
                    break
                kind = "drill"
                moves = drill_trains(path) or [target]
                stem = kg_lib.drill_solved_stem(path)
                fname = f"solved/d_{stem}_{stamp}.py"
                problem = "drill"
                exclude.add(pnum)
            else:
                p = problems[pnum]
                kind = p.get("difficulty") or problem_difficulty(pnum, problems)
                moves = list(p["moves"])
                fname = f"solved/p{pnum}_sim_{stamp}.py"
                problem = str(pnum)
                exclude.add(pnum)
            verdict = {}
            for m in moves:
                if m not in nodes:
                    continue
                p_clean = teach if statuses[m][0] == MISSING else recall[m]
                verdict[m] = "clean" if rng.random() < p_clean else "struggled"
            if problem != "drill" and problem not in seen and verdict:
                # a cold problem: the pass model's own odds on top of recall
                dif = {"Easy": "E", "Medium": "M", "Hard": "H"}.get(kind, "M")
                time_f, rec, derive = practice_factors(
                    (mediums, recognition_practice(0, cold), hards), r_base)
                p_cold = time_f[dif] * rec ** REC_POWER[dif]
                if rng.random() < draft_error:
                    p_cold *= derive  # the walk missed a move: derive it or fail
                p_cold = mass_adjust(p_cold, walk_mass(moves, carrier_counts(problems)),
                                     mass["ref"][dif], mass["beta"])
                if rng.random() >= p_cold:
                    weakest = min(verdict, key=lambda m: recall[m])
                    verdict[weakest] = "struggled"
            clean = all(v == "clean" for v in verdict.values())
            for m, v in verdict.items():
                was = touched.get(m, (False, False))
                touched[m] = (was[0] or m == target, was[1] or v == "struggled")
            budget -= price(kind if kind in per_kind else "Medium", clean)
            evidence[fname] = {"date": day.isoformat(), "problem": problem,
                               "moves": verdict}
            for m in verdict:
                statuses[m] = node_status(m, evidence, today=day)
                recall[m] = node_curve_recall(m, evidence, curve, day)
            solves_today += 1
            per_kind[kind if kind in per_kind else "Medium"] += 1
            today_kind[kind if kind in per_kind else "Medium"] += 1
            if clean:
                if kind == "Medium":
                    mediums += 1
                elif kind == "Hard":
                    hards += 1
                if problem != "drill" and problem not in seen:
                    cold += 1  # a cold first solve: recognition practice
            seen.add(problem)
        dry_days += solves_today == 0
        short_days += budget > hours * 30
        author_budget += rate
        while author_budget >= 1:
            cands = [n for n in touched if not kg_lib.has_drill_bank(n)]
            cands.sort(key=lambda n: (not touched[n][0], not touched[n][1], recall[n]))
            if not cands:
                cands = sorted((n for n in nodes if not kg_lib.has_drill_bank(n)),
                               key=lambda n: recall[n])
            if not cands:
                break  # every node has a bank
            files = rng.choice(size_pool)
            bank.author(cands[0], files)
            authored_files += files
            author_budget -= 1
        practice = (mediums, recognition_practice(0, cold), hards)
        _, onsite, screen, phard = rates(day, practice, recall)
        end = {s: 0 for s in (SOLID, STALE, FRAGILE, MISSING)}
        for s in statuses.values():
            end[s[0]] += 1
        series.append({"day": day, "solves": today_kind, "stale": end[STALE],
                       "fragile": end[FRAGILE], "missing": end[MISSING],
                       "onsite": onsite, "screen": screen, "hard": phard})
        if day_no % every == 0 or day_no == days or onsite >= TARGET_ONSITE:
            onsite = report(day_no, day, practice, solves_today, statuses, recall)
            if onsite >= TARGET_ONSITE:
                break
    else:
        day_no = days
    for n in nodes:
        close_streak(n)
    freeze_clock(start)
    return {"day": day_no, "start": start, "onsite": onsite, "hours": hours,
            "source": src, "per_kind": per_kind, "dry_days": dry_days,
            "short_days": short_days, "rusty": rusty, "starved": starved,
            "series": series,
            "authored": {"nodes": len(bank.authored), "files": authored_files,
                         "rate": rate, "source": rate_src}}


def main():
    parser = argparse.ArgumentParser(
        description="Run the real picker forward until P(onsite) reaches 50%.")
    parser.add_argument("hours", type=float, nargs="?", default=None,
                        help="hours per day; default: the measured pace")
    parser.add_argument("--seed", type=int, default=1)
    parser.add_argument("--days", type=int, default=MAX_DAYS)
    parser.add_argument("--every", type=int, default=7,
                        help="print a row every N days")
    parser.add_argument("--hard-sat", type=float, default=kg_lib.HARD_SAT,
                        help="Hards after which 63%% of the Hard headroom is "
                        f"earned (model: {kg_lib.HARD_SAT})")
    parser.add_argument("--mock-sat", type=float, default=kg_lib.MOCK_SAT,
                        help="mock-equivalents after which 63%% of recognition "
                        f"headroom is earned (model: {kg_lib.MOCK_SAT})")
    parser.add_argument("--cold-per-mock", type=int, default=kg_lib.COLD_SOLVES_PER_MOCK,
                        help="cold first solves worth one mock; 0 = no credit "
                        f"(model: {kg_lib.COLD_SOLVES_PER_MOCK})")
    parser.add_argument("--draft-error", type=float, default=0.0,
                        help="share of drafted walks that are wrong: such a cold "
                        "problem needs a move the walk did not name, at the "
                        "derive rate (drafts score P 0.80 vs evidenced walks)")
    parser.add_argument("--bank-rate", type=float, default=None,
                        help="new drill banks authored per day; default: the "
                        "measured rate over the last 28 days, 0 = the bank as it is")
    args = parser.parse_args()
    r = run(args.hours, args.seed, args.days, args.every, args.hard_sat,
            args.mock_sat, args.cold_per_mock, args.draft_error,
            bank_rate=args.bank_rate)
    day_no, onsite, hours = r["day"], r["onsite"], r["hours"]
    print()
    if onsite >= TARGET_ONSITE:
        print(f"central P(onsite) >= {TARGET_ONSITE:.0%} on day {day_no}: "
              f"{(r['start'] + timedelta(days=day_no)).isoformat()}")
    else:
        print(f"not reached in {day_no} days (P(onsite) {onsite:.0%})")
    print("solves: " + ", ".join(f"{k} {v}" for k, v in r["per_kind"].items())
          + f"; {sum(r['per_kind'].values())} in {day_no} days at {hours:g}h/day")
    a = r["authored"]
    print(f"drills authored: {a['files']} files for {a['nodes']} nodes "
          f"at {a['rate']:g} banks/day ({a['source']})")
    print(f"picker dry: {r['dry_days']} days served nothing, {r['short_days']} "
          f"days ran out before half the hours were used")
    worst = max(s + f for _, s, f, _ in r["rusty"]) if r["rusty"] else 0
    print(f"rusty: at most {worst} nodes STALE or FRAGILE at the start of a day")
    if r["starved"]:
        print(f"picker starved ({STARVED_DAYS}+ days rusty in a row, nothing aimed at it):")
        for n, k in sorted(r["starved"].items(), key=lambda x: -x[1]):
            print(f"  {n}: {k} days")


if __name__ == "__main__":
    main()
