#!/usr/bin/env python3

# kg_residuals — residual diagnostic for the global forgetting curve.
#
#   make residuals             # observed - predicted, grouped by wing and node
#
# For every recall trial (same construction as kg_curve.extract_trials, but
# keeping the node), compute observed - predicted under graph/curve.json.
# If the one-global-law assumption is right, every wing hovers near zero.
# A wing significantly negative at long gaps decays faster than the global
# curve says; a NODE significantly negative while its wing is fine is a
# fission or interference suspect, not a curve problem (README rule 4).
# z per group is sum(obs - p) / sqrt(sum p(1-p)).

import json
import math
import os
import re
from collections import defaultdict
from datetime import date

from kg.kg_lib import ASSIST_WEIGHT, GRAPH_DIR, assist_of, load_evidence

NODE_Z_FLAG = 1.5   # per-node report threshold
NODE_N_MIN = 5
GAP_SPLIT = 21      # days: short vs long bucket


def trials_by_node(evidence):
    """[(node, gap_days, success, prior_cleans, prior_struggles, prior_assist)]"""
    events = defaultdict(list)
    for fname, rec in evidence.items():
        m = re.search(r"\d{4}_\d{2}_\d{2}T[\d_]+", fname)
        ts = m.group(0) if m else ""
        for node, verdict in rec.get("moves", {}).items():
            events[node].append((rec["date"], ts, verdict, assist_of(rec, node)))

    out = []
    for node, evs in events.items():
        evs.sort()
        days = defaultdict(list)
        for d, _, v, a in evs:
            days[d].append((v, a))
        last_clean, cleans, struggles, assisted = None, 0, 0, 0.0
        for d in sorted(days):
            verdict, assist = days[d][0]
            if (last_clean is not None and verdict in ("clean", "struggled")
                    and assist != "spoiled"):
                gap = (date.fromisoformat(d) - date.fromisoformat(last_clean)).days
                if gap >= 1:
                    success = int(verdict == "clean" and assist == "none")
                    out.append((node, gap, success, cleans, struggles, assisted))
            for v, a in days[d]:
                if v == "clean" and a != "spoiled":
                    cleans += 1
                    last_clean = d
                elif v == "struggled":
                    struggles += 1
                assisted += ASSIST_WEIGHT[a]
    return out


def main():
    with open(os.path.join(GRAPH_DIR, "curve.json")) as f:
        P = json.load(f)["params"]
    with open(os.path.join(GRAPH_DIR, "nodes.json")) as f:
        wing = {n["id"]: n["group"] for n in json.load(f)["nodes"]}

    trials = trials_by_node(load_evidence())

    def predict(gap, k, m, x):
        s = math.exp(P["a"] + P["b"] * k - P["c"] * m - P["d"] * x)
        return (1 - P["slip"]) * (1 + gap / s) ** (-P["beta"])

    def bucket(gap):
        return f"short (<={GAP_SPLIT}d)" if gap <= GAP_SPLIT else f"long (>{GAP_SPLIT}d)"

    agg = defaultdict(lambda: defaultdict(list))   # wing -> bucket -> [(obs, p)]
    per_node = defaultdict(list)
    for node, gap, sf, k, m, x in trials:
        p = predict(gap, k, m, x)
        agg[wing.get(node, "?")][bucket(gap)].append((sf, p))
        per_node[node].append((sf, p))

    def stats(pairs):
        n = len(pairs)
        obs = sum(s for s, _ in pairs) / n
        exp = sum(p for _, p in pairs) / n
        var = sum(p * (1 - p) for _, p in pairs)
        z = (sum(s - p for s, p in pairs) / math.sqrt(var)) if var > 0 else 0.0
        return n, obs, exp, z

    print(f"{len(trials)} trials against curve.json\n")
    print(f"{'wing':<18}{'bucket':<15}{'n':>4}{'obs':>7}{'model':>7}{'z':>7}")
    buckets = (f"short (<={GAP_SPLIT}d)", f"long (>{GAP_SPLIT}d)")
    for w in sorted(agg, key=lambda w: min(stats(ps)[3] for ps in agg[w].values())):
        for b in buckets:
            if agg[w].get(b):
                n, obs, exp, z = stats(agg[w][b])
                flag = "  <--" if abs(z) >= 2 else ""
                print(f"{w:<18}{b:<15}{n:>4}{obs:>7.0%}{exp:>7.0%}{z:>7.2f}{flag}")

    flagged = [(node, stats(pairs)) for node, pairs in per_node.items()
               if len(pairs) >= NODE_N_MIN and abs(stats(pairs)[3]) >= NODE_Z_FLAG]
    if flagged:
        print(f"\nnodes with |z| >= {NODE_Z_FLAG} and n >= {NODE_N_MIN}"
              " (fission / interference suspects):")
        for node, (n, obs, exp, z) in sorted(flagged, key=lambda kv: kv[1][3]):
            print(f"  {node:<28}{wing.get(node, '?'):<17}"
                  f"n={n:<4}obs={obs:<5.0%}model={exp:<5.0%}z={z:+.2f}")


if __name__ == "__main__":
    main()
