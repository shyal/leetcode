# Session-start juice: a problem solved this recently is muscle memory, not a
# warmup. Recent ones sink below the rest; they only surface if the cool pool
# is empty.
WARMUP_COOLDOWN_DAYS = 14


def is_session_start():
    """Exit code of the is_session_start script: 0 = still in the window."""
    return (
        subprocess.run(
            [sys.executable, os.path.join(UTILS, "is_session_start")],
            capture_output=True,
        ).returncode
        == 0
    )


def _iss():
    from importlib.machinery import SourceFileLoader

    return SourceFileLoader(
        "_iss", os.path.join(UTILS, "is_session_start")
    ).load_module()


def solved_today_pnums():
    """Problems already solved today — never re-offered, whatever the rule."""
    mod = _iss()
    pnums = set()
    for f in mod.solves_today():
        name = os.path.basename(f)
        num = name[1:].split("_", 1)[0]
        if name.startswith("p") and num.isdigit():
            pnums.add(num)
    return pnums


def _warmup_hot(pnum, evidence, today=None):
    """True if this problem was solved inside the warmup cooldown."""
    last = last_solved(pnum, evidence)
    if not last:
        return False
    today = today or date.today()
    return (today - date.fromisoformat(last)).days < WARMUP_COOLDOWN_DAYS


def trivial_easies(problems, nodes, evidence, statuses):
    """The gentlest all-SOLID easies: tiny walks, high acceptance, not done
    in the last WARMUP_COOLDOWN_DAYS. Session-start picks — juice, not
    training, so nothing rusty, nothing new, and nothing from Thursday."""
    cands = []
    for pnum, p in problems.items():
        moves = p.get("moves", [])
        if p.get("banned") or p.get("difficulty") != "Easy" or not moves:
            continue
        if not all(m in nodes and statuses[m][0] == SOLID for m in moves):
            continue
        # Hot (recently solved) sorts after cool. Size and acceptance only
        # rank inside that band, so 0.8% acceptance cannot beat a 2-day gap.
        cands.append(
            (
                int(_warmup_hot(pnum, evidence)),
                tree_size(pnum, problems, nodes),
                -acceptance(pnum),
                last_solved(pnum, evidence),
                pnum,
            )
        )
    cands.sort()
    return [c[-1] for c in cands]


def drill_title(path):
    """The DRILL: header of a bank drill file (falls back to the filename)."""
    import re

    for line in open(path):
        m = re.match(r"\s*DRILL:\s*(.+)", line)
        if m:
            return m.group(1).strip()
    return os.path.splitext(os.path.basename(path))[0]


def problem_url(pnum):
    meta_path = os.path.join(os.path.dirname(GRAPH_DIR), "data/problems_metadata.json")
    try:
        slug = json.load(open(meta_path))[str(pnum)]["slug"]
        return f"https://leetcode.com/problems/{slug}/"
    except Exception:
        return f"https://leetcode.com/problemset/?search={pnum}"


def drill_clock_reason(path, evidence, today=None):
    """The reason line for a drill served on its own clock (kg_lib.anki_due):
    the interval it had and how many days past it the file is."""
    today = today or date.today()
    due = anki_due(path, evidence) if path else None
    if not due:
        return "drill never done - on its own clock"
    late = (today - due[0]).days
    return (f"drill due on its own clock - {due[1]}d interval"
            + (f", {late}d overdue" if late > 0 else ""))


def pick(
    nodes,
    problems,
    evidence,
    statuses,
    asleep=(),
    woken=(),
    exclude=(),
    session_start=False,
    group=None,
    cram=False,
    early=False,
    assisted=False,
):
    """Return (target, status, pnum, reason) or None. With `group`, only
    nodes of that curated group are candidates (rules 1-3); the sleep
    warm-up and the summit fallback are skipped, since neither is about
    the group. With `cram`, the cross-bank hold is off: a prereq
    that is SOLID through an assisted rep is enough to serve the drill
    above it, so a group can be walked in one sitting instead of one
    unaided rep per day. With `early` (implies cram), the curve is off
    too: every node in scope with a drill left is served in prereq order,
    prereqs before dependents, whatever its status - the whole group
    reviewed ahead of schedule, SOLID prereqs jogged before a new move.
    With `assisted` (implies early), the same walk restricted to drills
    whose latest rep was assisted: the unaided rep each is waiting for."""
    early = early or assisted
    cram = cram or early

    # rule 0e: a group at its daily cap (KG_GROUP_CAP) is out of the default
    # frontier, the clock included; naming the group (`make next sql`) or a
    # cram walk is the override
    caps = {} if group or cram else group_caps()
    capped = {g for g, c in caps.items()
              if group_reps(g, nodes, evidence, date.today()) >= c}

    # the clock: a bank file due on its own clock outranks every rule below
    if drill_scheduler() == "anki":
        scope = [n for n in nodes if group is None or nodes[n].get("group") == group]
        for path, node in anki_frontier(evidence, nodes=nodes, node_ids=scope,
                                        assisted=assisted):
            drill_id = f"drill:{node}"
            if drill_id in exclude or node not in statuses:
                continue
            if nodes[node].get("group") in capped:
                continue
            return (node, statuses[node][0], drill_id,
                    drill_clock_reason(path, evidence))

    immature = immature_nodes(nodes, evidence, problems)

    def in_scope(n):
        if group is not None:
            return nodes[n].get("group") == group
        return nodes[n].get("group") not in capped

    def due(target):
        """The drill pseudo-pick for a node, or None if none is due. A drill
        held behind a rusty banked prereq is not due - the prereq trains
        first, and the carrier stays held with it."""
        if not cram and drill_held(
                target, nodes, statuses, evidence, has_bank=has_drill_bank):
            return None
        if early and not assisted and any(
                in_scope(p) and has_drill_bank(p) and drills_left(p, evidence, early=True)
                for p in nodes[target].get("prereqs", [])):
            return None  # the early walk is depth first: atoms under it unseen
                         # (not under assisted: an untouched drill under a
                         # prereq is not a candidate there, so holding the
                         # dependent behind it served nothing - 2026-08-31,
                         # "spent" with two assisted sql drills waiting)
        drill_id = f"drill:{target}"
        return (
            drill_id
            if drill_id not in exclude
            and due_drill(target, evidence, early=early, assisted=assisted)
            else None
        )

    def promote(target, mapped):
        """The frontier mover (PLAN.md phase 4): NO evidenced problem can
        carry target — not "none today": a mapped carrier that is merely
        warm, asleep, or spent outranks a drafted guess, so the node waits
        for it instead. Only genuinely uncarried moves promote. The entry
        is inserted in memory so rendering and forecasting see a normal
        problem; problems.json is untouched — kg_extract maps the problem
        from the actual solve."""
        if mapped or drafts_falsified(target, evidence, nodes):
            return None
        promo = predicted_carrier(target, problems, statuses, nodes,
                                  skip=set(asleep) | set(exclude))
        if promo:
            problems[promo[0]] = promo[1]
        return promo

    def unhold(target):
        """No carrier of target can fire because each waits on a
        predecessor ("after", held_behind). Serve the root of that chain
        instead: a predecessor problem whose moves are all SOLID is
        re-solved so it warms (nothing else re-solves a problem with no
        rusty move: 310 after 210 after 207 sat 47 simulated days,
        2026-08-31); a predecessor drill trains its node. A rusty
        predecessor is left to rules 1-3, a Hard is a summit, a hold with
        no root is a deadlock and serves nothing."""
        for pnum, p in sorted(problems.items(), key=lambda kv: pnum_key(kv[0])):
            moves = p.get("moves", [])
            if (target not in moves or p.get("banned")
                    or p.get("difficulty") == "Hard"
                    or not all(m in nodes for m in moves)
                    or any(statuses[m][0] != SOLID for m in moves if m != target)):
                continue
            pred, seen = held_behind(pnum, problems, evidence), set()
            while pred and pred not in seen:
                seen.add(pred)
                kind = vertex_kind(pred, problems)
                if kind == "problem":
                    up = held_behind(pred, problems, evidence)
                    if up:
                        pred = up
                        continue
                    pm = problems[pred].get("moves", [])
                    if (problems[pred].get("difficulty") == "Hard"
                            or pred in asleep or pred in exclude
                            or not cooled(pred, evidence)
                            or not pm or not all(m in nodes for m in pm)):
                        break
                    t2 = next((m for m in pm if statuses[m][0] != SOLID), pm[0])
                    return (t2, statuses[t2][0], pred,
                            f"{pnum} carries {target} but waits on {pred} - {pred} first")
                node = pred
                if kind == "drill":
                    path = drill_path(pred)
                    node = os.path.basename(os.path.dirname(path)) if path else None
                    # the drill is itself held behind an id not yet warm:
                    # climb to that id, as a problem's chain is climbed
                    # (Install Order waited on Shake Hands, whose node read
                    # owned, so neither was ever served - 2026-09-06)
                    up = next((a for a in drill_after(path)
                               if warm(a, problems, evidence) is False), None) if path else None
                    if up and (node == target or not due(node)):
                        pred = up
                        continue
                if node in nodes and node != target and due(node):
                    return (node, statuses[node][0], due(node),
                            f"{pnum} carries {target} but waits on {pred} - drill {node} first")
                break
        return None

    # rule -1: inside the session-start window, a trivial easy comes first
    if session_start:
        for pnum in trivial_easies(problems, nodes, evidence, statuses):
            if pnum not in asleep and pnum not in exclude:
                return (
                    problems[pnum]["moves"][0],
                    SOLID,
                    pnum,
                    "session start — trivial easy to get the juices flowing",
                )

    # rule 0a: a woken problem jumps the queue for a fresh attempt
    for pnum in woken:
        if pnum in exclude:
            continue
        moves = problems[pnum]["moves"]
        target = next((m for m in moves if statuses[m][0] != SOLID), moves[0])
        return (
            target,
            statuses[target][0],
            pnum,
            f"woken from sleep — the ground is ready; make wake {pnum} to resume",
        )

    # rule 0b: while a problem sleeps, warm the rusty ground under it
    for pnum in () if group else asleep:
        closure = input_tree(problems[pnum]["moves"], nodes)
        rusty = sorted(
            (n for n in closure if statuses[n][0] != SOLID),
            key=lambda n: (statuses[n][1] is not None, statuses[n][1]),
        )
        for target in rusty:
            if drill_gated(target, *statuses[target]):
                if due(target):
                    return (
                        target,
                        statuses[target][0],
                        due(target),
                        f"warm the ground under sleeping {pnum} — drill {target} first",
                    )
                continue  # drilled today, still not clean — carrier stays held
            cands = [
                c
                for c in carriers_for(target, problems, statuses, nodes, evidence)
                if c not in asleep and c not in exclude and cooled(c, evidence)
            ]
            if cands:
                cands.sort(
                    key=lambda p: (
                        last_solved(p, evidence),
                        tree_size(p, problems, nodes),
                        pnum_key(p),
                    )
                )
                return (
                    target,
                    statuses[target][0],
                    cands[0],
                    f"warm the ground under sleeping {pnum} ({target})",
                )
            if due(target):
                return (
                    target,
                    statuses[target][0],
                    due(target),
                    f"warm the ground under sleeping {pnum} — no READY carrier, drill {target}",
                )

    # rule 0d: the early review (`make next sql cram early`). The operator
    # asked for the whole group regardless of the curve, so the group is
    # walked prereqs before dependents (smallest input tree
    # first), depth first: a node is held while an in-scope banked prereq
    # still has an unseen drill, so every atom under a composition is met
    # before the composition is. Status does not jump the queue - a MISSING
    # dependent comes after the review of the SOLID prereqs under it, which
    # is the point: the prereqs are jogged before the new move is met.
    if early:
        review = sorted(
            (n for n in nodes if in_scope(n)),
            key=lambda n: (len(input_tree([n], nodes)), n),
        )
        for target in review:
            if due(target):
                return (
                    target,
                    statuses[target][0],
                    due(target),
                    "assisted review - the unaided rep this drill is waiting for"
                    if assisted else
                    "early review - next drill, atoms first",
                )

    # ------------------------------------------------------------------
    # The frontier (rules 0b, 0c, 1, 1b, 2 and 3 of the header): one list
    # of due moves, one way to serve a move. A due move is served the same
    # way whatever made it due - its own drill when one is due, else the
    # drill of the banked prereq holding it, else a carrier problem, else
    # a drafted carrier, else the predecessor its carriers wait on - and
    # the rules are only the order of the list. Before 2026-09-02 each
    # rule carried its own copy of "due" and "how to get past a hold", and
    # three holds in one evening each broke a rule that did not know them.
    # ------------------------------------------------------------------
    carr = carrier_counts(problems)
    unl = unlocks(statuses, problems)
    dodged = dodged_nodes(evidence)
    today = date.today()
    FLOOR = "floor"
    DRILL = "drill"  # a SOLID move whose bank file is due on its own clock
    ORDER = {FRAGILE: 0, FLOOR: 1, DRILL: 2, STALE: 3, MISSING: 4}
    anki = drill_scheduler() == "anki"

    def floor(n):
        """(due date, floor days) when n is a young SOLID move whose ladder
        rep is due today (kg_lib.graduation_due), else None."""
        g = graduation_due(n, evidence, carr.get(n, 0))
        return g if g and g[0] <= today else None

    def kind(n):
        """Why n is due, or None. MISSING only once every prereq is SOLID
        (the one-new-move rule); SOLID only on the graduating floor."""
        status = statuses[n][0]
        if status == MISSING:
            return MISSING if all(
                statuses[p][0] == SOLID for p in nodes[n].get("prereqs", [])) else None
        if status == SOLID:
            if floor(n):
                return FLOOR
            return DRILL if anki and due(n) else None
        return status

    # the rusty ground under a sleeping problem comes first, freshest
    # carrier first, so the problem is woken onto warm moves
    under = {}
    if not group:
        for pnum in asleep:
            for n in input_tree(problems[pnum]["moves"], nodes):
                if statuses[n][0] != SOLID:
                    under.setdefault(n, pnum)

    def holding(n):
        """The banked prereq drill_held parks n behind, or None."""
        return next((p for p in nodes[n].get("prereqs", [])
                     if has_drill_bank(p) and p in statuses
                     and (statuses[p][0] != SOLID or not owned(p, evidence)
                          or drills_left(p, evidence))), None)

    def opener(n):
        """(prereq, drill id) that opens the hold on n: climb the chain of
        banked prereqs to its root and serve that prereq's drill. One
        level was not enough (dedupe siblings waited on start-index,
        start-index on choose-undo, 2026-08-31). A rusty root is a due
        move of its own; a hold nothing above clears is a deadlock and
        opens nothing."""
        if cram or not drill_held(n, nodes, statuses, evidence, has_bank=has_drill_bank):
            return None
        pre, seen = holding(n), set()
        while pre is not None and pre not in seen and drill_held(
                pre, nodes, statuses, evidence, has_bank=has_drill_bank):
            seen.add(pre)
            pre = holding(pre)
        if pre is None or statuses[pre][0] != SOLID:
            return None
        drill_id = f"drill:{pre}"
        if drill_id in exclude or not due_drill(pre, evidence):
            return None
        return pre, drill_id

    def drill_for(n):
        """(node, drill id) - n's own bank drill when one is due, the hold
        honoured, else the drill that opens the hold; None when no drill
        can move n today."""
        d = due(n)
        return (n, d) if d else opener(n)

    def sort_key(n):
        """Sleeping ground first; then by why the move is due; then, within
        a status, moves a drill can serve before moves only a problem can
        (the bank is the asset, and a drill is three minutes to a
        problem's seventeen); then the rule's own order - most overdue
        floor first, else most unlocks, oldest evidence."""
        k = kind(n)
        last = statuses[n][1] or date.min
        sub = (floor(n)[0], -unl.get(n, 0), n) if k == FLOOR \
            else (-unl.get(n, 0), last, n)
        return (n not in under, ORDER[k], drill_for(n) is None, sub)

    due_list = sorted((n for n in nodes if in_scope(n) and kind(n)), key=sort_key)

    def serve(n):
        """The pick that gives n its rep today, or None (drilled today and
        still not clean, or nothing can fire)."""
        k = kind(n)
        status, last = statuses[n]
        age = (today - last).days if last else None
        deep = k == STALE and age > DEEP_STALE_DAYS
        sleeper = under.get(n)
        d = drill_for(n)
        if d:
            node, drill_id = d
            if node != n:  # the hold opener: a prereq's drill first
                why = "next undone drill" if owned(node, evidence) else "own it unaided"
                held = sum(1 for m in due_list if (opener(m) or (None,))[0] == node)
                return (node, SOLID, drill_id,
                        f"{why} - {held} held move{'s' if held > 1 else ''} "
                        f"wait{'' if held > 1 else 's'} on it")
            reason = (
                f"warm the ground under sleeping {sleeper} — drill {n} first" if sleeper
                else "fragile move — drill until clean, carrier after" if k == FRAGILE
                else f"graduating rep - young move at its {floor(n)[1]}d floor"
                     " - drill first, carrier after" if k == FLOOR
                else drill_clock_reason(due_drill(n, evidence), evidence) if k == DRILL
                else f"re-enter a deep-stale move ({age}d since clean)"
                     " — drill until clean, carrier after" if deep
                else f"stale move ({age}d since clean) - drill first, carrier after"
                if k == STALE
                else "new move — drill until clean, carrier after")
            return n, status, drill_id, reason
        if drill_gated(n, status, last):
            return None  # drilled today, still not clean - the carrier stays held
        mapped = carriers_for(n, problems, statuses, nodes, evidence)
        cands = [c for c in mapped
                 if c not in asleep and c not in exclude and cooled(c, evidence)]
        if cands:
            if sleeper:
                cands.sort(key=lambda p: (last_solved(p, evidence),
                                          tree_size(p, problems, nodes), pnum_key(p)))
                return n, status, cands[0], f"warm the ground under sleeping {sleeper} ({n})"
            if k == FRAGILE and n in dodged:
                # anti-dodge: prefer carriers with no recorded escape route and
                # short walks (the target is load-bearing, not optional)
                cands.sort(key=lambda p: (dodgeable(p, n, problems),
                                          tree_size(p, problems, nodes),
                                          last_solved(p, evidence), pnum_key(p)))
                return (n, status, cands[0],
                        f"you dodged this move on {dodged[n]} — carrier chosen to resist the dodge")
            if k == STALE and not deep:  # the spaced re-solve of its latest carrier
                carrier = latest_carrier(n, evidence)
                pnum = carrier[2] if carrier and carrier[2] in cands else sorted(
                    cands, key=lambda p: last_solved(p, evidence), reverse=True)[0]
                return n, status, pnum, "spaced re-solve of a stale move's carrier"
            cands.sort(key=lambda p: (gentleness(p, problems, nodes),
                                      last_solved(p, evidence), -acceptance(p), pnum_key(p)))
            reason = (
                "consolidate a fragile move on a fresh carrier" if k == FRAGILE
                else f"graduating rep - young move at its {floor(n)[1]}d floor" if k == FLOOR
                else f"re-enter a deep-stale move ({age}d since clean) on a gentle fresh carrier"
                if deep
                else "one genuinely new move, prereqs all solid")
            return n, status, cands[0], reason
        if k != FLOOR:
            promo = promote(n, mapped)
            if promo:
                return (n, status, promo[0],
                        "no mapped carrier — promoted a drafted one (predicted walk)")
        return unhold(n)

    for n in due_list:
        choice = serve(n)
        if choice and nodes.get(choice[0], {}).get("group") in capped:
            continue  # the hold opener sits in a capped group
        if choice:
            return choice

    # rule 4: nothing rusty and nothing new — take a summit. A Hard is never a
    # CARRIER (it is not where a rusty move gets its rep), but once its walk is
    # gap-free it is exactly what to work on next, so it belongs in the same
    # pick as everything else rather than behind a second command.
    summits = [] if group else [
        p
        for p in ready_hards(problems, nodes, evidence, statuses, immature)
        if p not in asleep and p not in exclude
    ]
    if summits:
        pnum = rank_summits(summits, problems, nodes, statuses)[0]
        return (
            problems[pnum]["moves"][0],
            SOLID,
            pnum,
            "summit — its walk has no gaps left",
        )

    # rule 5: nothing rusty, nothing new, no summit ready - widen reach.
    # Reach is counted against the drafted catalog, and a node is in reach
    # only when it is mature (SOLID and proven on a real problem at its
    # bar, kg_lib.mature). The young node blocking the most unsolved drafted
    # problems is served first, on a proving carrier: an evidenced problem
    # that carries it at the bar, else a drafted one at the bar. Each rep
    # is one step toward maturity, so the count is the payoff of the rep.
    gain = unlocks(statuses, problems, immature=immature)
    young = sorted(
        (n for n in immature if in_scope(n) and gain.get(n, 0)
         and statuses[n][0] == SOLID),
        key=lambda n: (-gain[n], n),
    )
    for target in young:
        why = f"widen reach - prove {target} on a real problem; " \
              f"{gain[target]} drafted problems wait on it"
        cands = [
            c for c in proving_carriers(target, problems, statuses, nodes, evidence)
            if c not in asleep and c not in exclude and cooled(c, evidence)
        ]
        cands.sort(
            key=lambda p: (
                gentleness(p, problems, nodes),
                last_solved(p, evidence),
                -acceptance(p),
                pnum_key(p),
            )
        )
        # a carrier already counted toward the bar (a clean rep of target
        # on it) proves memory of that problem, not carry: 102 was served
        # for its second rep while 18 drafted Mediums waited (2026-09-01).
        # Fresh evidenced carriers first, then a draft, then the re-solve.
        fresh = [c for c in cands if not counted_toward_bar(c, target, evidence)]
        if fresh:
            return target, SOLID, fresh[0], why
        if not drafts_falsified(target, evidence, nodes):
            kind, _ = carry_bar(target, problems)
            promo = predicted_carrier(
                target, problems, statuses, nodes,
                skip=set(asleep) | set(exclude),
                difficulties=("Medium",) if kind == "medium" else ("Easy", "Medium"),
            )
            if promo:
                problems[promo[0]] = promo[1]
                return target, SOLID, promo[0], why + " (drafted carrier)"
        if cands:
            return target, SOLID, cands[0], why + " (re-solve: no fresh carrier)"

    # rule 6: the graph is solid and no young move has a carrier today.
    # What is left is leetcode itself: an unsolved drafted problem whose
    # every move is SOLID and mature, Hards first. The pass model prices
    # the onsite by Hards solved, and the summit rule only sees the Hards
    # of problems.json - the 2026-08-31 simulation (make simulate) ran the
    # picker 180 days and it served one Hard, P(onsite) flat at 16%.
    if not group:
        today = date.today().isoformat()
        solved_today = sorted(
            (k, r) for k, r in ev_index(evidence).by_date.get(today, ())
            if str(r.get("problem", ""))[:1].isdigit())
        last = solved_today[-1][1]["problem"] if solved_today else None
        first = "Medium" if last and problem_difficulty(last, problems) == "Hard" \
            else "Hard"
        for num, entry in drafted_in_reach(
                problems, statuses, nodes, immature,
                skip=set(asleep) | set(exclude), first=first):
            problems[num] = entry
            return (
                entry["moves"][0],
                SOLID,
                num,
                "in reach - unsolved drafted problem, every move solid and mature",
            )

    return None

EXPLORE_REASONS = ("summit", "widen reach", "in reach")  # rules 4, 5, 6


def counted_toward_bar(pnum, target, evidence):
    """True when this problem already gave `target` a clean rep: a second
    rep of it counts toward maturity (kg_lib._mature_from counts reps),
    but a different problem is the proof rule 5 is after."""
    return any(str(rec.get("problem")) == str(pnum) and v == "clean"
               for _, v, _, _, rec in
               kg_lib.ev_index(evidence).by_node.get(target, ()))


def exploratory(status, reason):
    """True when a pick is new ground rather than review: a MISSING move
    (rule 3, drill or carrier) or an all-solid problem (rules 4-6)."""
    return status == MISSING or reason.startswith(EXPLORE_REASONS)


def withheld(choice, asleep):
    """Rule 0b: True when the park is full and this pick is new ground.
    Review picks pass; only a pick that would open something new is held
    back until one parked problem is faced."""
    if not choice or len(asleep) < MAX_ASLEEP:
        return False
    return exploratory(choice[1], choice[3])


def park_full_lines(asleep, problems):
    """The refusal, as lines: the count and the three ways out. The parked
    problems themselves are on the footer every make next prints."""
    return [f"{len(asleep)} asleep (cap {MAX_ASLEEP}) - new ground is withheld "
            "until you face one (make wake <n>), then: keep going (make solved) "
            "/ learn it (notes say \"learning\", make solved) / fail it (make failed)"]


def review_ahead(nodes, problems, evidence, asleep=(), exclude=(), group=None,
                 days=14, cap=200):
    """(drills, problems, reached): the review picks between now and the
    first exploratory one. The picker is replayed on a copy of the
    evidence; every pick is granted a clean unaided rep dated the replay
    day, so a cleared node stops being served and a newly owned prereq
    releases what it held. When a day has nothing left (drills once a day,
    carriers cooled) the clock moves to the next day, up to `days`. The
    plan and the session-start warmup are ignored. Best case by
    construction: a struggled rep costs at least one more pick."""
    ev = dict(evidence)
    problems = dict(problems)  # promotion inserts drafted entries in memory
    exclude = set(exclude)
    drills = solves = seq = 0
    real = kg_lib.date, globals()["date"]
    start = date.today()

    def freeze(day):
        class Frozen(date):
            @classmethod
            def today(cls):
                return day
        kg_lib.date = Frozen
        globals()["date"] = Frozen

    try:
        for day_no in range(days):
            day = start + timedelta(days=day_no)
            freeze(day)
            statuses = {n: node_status(n, ev, today=day) for n in nodes}
            while drills + solves < cap:
                choice = pick(nodes, problems, ev, statuses, asleep=asleep,
                              exclude=exclude, group=group)
                if choice is None:
                    break
                target, status, pnum, reason = choice
                if exploratory(status, reason):
                    return drills, solves, True
                seq += 1
                stamp = day.strftime("%Y_%m_%dT") + f"{seq:06d}_00_00Z"
                if str(pnum).startswith("drill:"):
                    path = due_drill(target, ev, today=day)
                    if not path:
                        break
                    moves = drill_trains(path) or [target]
                    fname = f"solved/d_{drill_solved_stem(path)}_{stamp}.py"
                    problem = "drill"
                    drills += 1
                else:
                    moves = list(problems[pnum]["moves"])
                    fname = f"solved/p{pnum}_{stamp}.py"
                    problem = str(pnum)
                    solves += 1
                exclude.add(pnum)
                ev[fname] = {"date": day.isoformat(), "problem": problem,
                             "moves": {m: "clean" for m in moves if m in nodes}}
                for m in moves:
                    if m in nodes:
                        statuses[m] = node_status(m, ev, today=day)
            else:
                break
            exclude = set()  # a new day: nothing is spent yet
        return drills, solves, False
    finally:
        kg_lib.date, globals()["date"] = real


def review_line(drills, solves, reached):
    """The one line `make next` prints under the pick."""
    if not drills and not solves:
        return ("review ahead: none - this pick is new ground" if reached
                else "review ahead: none, and nothing new to serve either")
    parts = []
    if drills:
        parts.append(f"{drills} drill{'s' if drills != 1 else ''}")
    if solves:
        parts.append(f"{solves} problem{'s' if solves != 1 else ''}")
    tail = "then new ground" if reached else "and still nothing new"
    return f"review ahead: {', '.join(parts)}, {tail} (if every rep is clean)"


def ready_hards(problems, nodes, evidence, statuses, immature=None, recog=None):
    """Unsolved Hards with no gaps left in their route: every node in the
    transitive input tree SOLID — and mature (kg_lib.mature: a young badge
    from one burst of drills is not yet load-bearing) — and no `unmapped`
    move (a trick the taxonomy has no node for yet — unroutable new ground,
    so the walk is farther away than its mapped moves suggest). A Hard
    with a move that is FAILED_TO_RECOGNIZE on the recognition axis
    (kg.recognition: the last time a statement was served for that move
    it was not named) is not ready either: a summit is a pure combination rep only if the
    walk is seen, and the spot rep is what clears the miss.

    Classics come first, and the whole list is ranked by kg_lib.rank_summits,
    so `make next` and `make hard` cannot name different summits."""
    solved = solved_problems(evidence)
    if immature is None:
        immature = immature_nodes(nodes, evidence, problems)
    if recog is None:
        recog = rc.derived(rc.load_recognition(), evidence, problems, statuses)
    out = []
    for pnum, p in problems.items():
        if (
            p.get("difficulty") != "Hard"
            or p.get("banned")
            or pnum in solved
            or not p.get("moves")
        ):
            continue
        if any(rc.recognition_status(m, recog)[0] == rc.FAILED_TO_RECOGNIZE
               for m in p["moves"]):
            continue
        if route_gaps(pnum, problems, nodes, statuses, immature)[1] == 0:
            out.append(pnum)
    classics = [p for p in out if p in CLASSICS]
    pool = classics or out
    return rank_summits(pool, problems, nodes, statuses, immature)


def blocked_frontier(nodes, problems, evidence, statuses, asleep=(), exclude=()):
    """The frontier nodes pick() had to walk past, each with the reason it
    could not be served: [(node, status, why, dry), ...].

    pick() returning None is two different answers wearing the same face -
    "nothing is due" and "something is due but the bank cannot carry it" -
    and only the second one is a to-do. `dry` separates them: True means no
    mapped, drilled, or drafted problem can EVER carry the node as things
    stand (bank maintenance); False means the node is merely waiting - a
    carrier cooling, a prereq not yet owned, a drill done for today - and
    the reason names what it waits for. The filters here mirror pick()'s
    exactly (cooled, asleep, exclude, drill_held, drill_gated): a node this
    function calls servable is one pick() would have served."""
    out = []
    for nid in nodes:
        status, last = statuses[nid]
        if status == SOLID:
            continue
        prereqs = [p for p in nodes[nid].get("prereqs", []) if p in statuses]
        if status == MISSING and not all(statuses[p][0] == SOLID for p in prereqs):
            continue  # a prereq is still rusty - not on the frontier yet

        # the cross-bank hold: waits on an unaided rep of a banked prereq (rule 0c
        # serves that rep, so this is never dry)
        if drill_held(nid, nodes, statuses, evidence, has_bank=has_drill_bank):
            holders = [
                p for p in prereqs
                if has_drill_bank(p)
                and (statuses[p][0] != SOLID or not owned(p, evidence)
                     or drills_left(p, evidence))
            ]
            out.append((
                nid, status,
                f"held behind {', '.join(holders)} (unaided clean rep or undone drills)",
                False,
            ))
            continue

        # the drill gate: trains on the drill only, and it is done for today
        if drill_gated(nid, status, last) and not due_drill(nid, evidence):
            out.append((nid, status, "drilled today, still not clean - holds until a clean rep", False))
            continue

        ready = carriers_for(nid, problems, statuses, nodes, evidence)
        live = [c for c in ready if c not in asleep and c not in exclude]
        if [c for c in live if cooled(c, evidence)]:
            continue  # servable - pick() just preferred something else
        if due_drill(nid, evidence):
            continue  # its drill is available and pick() would offer it
        misses = draft_misses(nid, evidence, nodes)
        falsified = drafts_falsified(nid, evidence, nodes)
        if (not ready and not falsified
                and predicted_carrier(nid, problems, statuses, nodes,
                                      skip=set(asleep) | set(exclude))):
            continue  # uncarried but servable - pick() promotes a draft

        if live:
            # every live carrier is inside the review cooldown
            soonest = min(live, key=lambda c: last_solved(c, evidence))
            cools = date.fromisoformat(last_solved(soonest, evidence)) + timedelta(
                days=CARRIER_COOLDOWN_DAYS)
            why = f"carrier {soonest} cools {cools.isoformat()}"
            if has_drill_bank(nid):
                why += ", and its drill is done for today"
            out.append((nid, status, why, False))
            continue

        walks = [p for p, v in problems.items() if nid in v.get("moves", [])]
        usable = [
            p
            for p in walks
            if not problems[p].get("banned") and problems[p].get("difficulty") != "Hard"
        ]
        listed = ", ".join(sorted(walks, key=pnum_key))
        dry = True
        if not walks:
            why = "no problem in the graph uses this move"
        elif not usable:
            why = (
                f"the only problem using it is {listed}, a Hard or banned one "
                "(hards are summits, never used to introduce a move)"
                if len(walks) == 1
                else f"every problem using it ({listed}) is a Hard or banned"
            )
        elif not ready:
            why = (
                "every problem using it also needs a second rusty move made solid first"
            )
            dry = False
        else:
            parked = [c for c in ready if c in asleep]
            why = (
                f"its carrier {', '.join(parked)} is asleep (make wake)"
                if parked
                else "every problem using it is already solved today"
            )
            dry = False
        if has_drill_bank(nid):
            why += ", and its drill is done for today"
        else:
            why += ", and no drill exists for it"
        if falsified:
            listed = ", ".join(misses)
            why += (
                f", and {len(misses)} drafted carriers ({listed}) were solved "
                "without the move - the drafts are wrong about how you solve, "
                "so no more are promoted"
            )
        else:
            why += ", and no drafted walk can carry it alone"
        out.append((nid, status, why, dry))
    return out


def due_on(n, nodes, evidence, carr, day):
    """True when move n is due on `day`, by pick()'s own kind(): STALE or
    FRAGILE; SOLID at its graduating floor; MISSING with every prereq
    SOLID. The caller only asks about days after n's latest rep, so n's
    own evidence reads as it did then; a prereq's is cut at `day`."""
    status, _ = node_status(n, evidence, today=day)
    if status in (STALE, FRAGILE):
        return True
    if status == SOLID:
        g = graduation_due(n, evidence, carr.get(n, 0))
        return bool(g) and g[0] <= day
    prereqs = nodes[n].get("prereqs", [])
    if not prereqs:
        return True
    cut = day.isoformat()
    seen = {f: r for f, r in evidence.items() if r["date"] <= cut}
    return all(node_status(p, seen, today=day)[0] == SOLID for p in prereqs)


def starved(nodes, problems, evidence, today=None):
    """{move: days} for every move due today that has been due STARVED_DAYS
    or more days in a row with no rep aimed at it in all that time. This
    is the simulator's starvation (kg_simulate) measured on the real run:
    the picker's rules make a due move servable within days, so a run
    this long is a hold nothing clears. A rep of the move on any day,
    clean or not, ends the run - a move picked and failed is the draw,
    not the picker."""
    today = today or date.today()
    carr = carrier_counts(problems)
    idx = ev_index(evidence)
    out = {}
    for n in nodes:
        last = max((d for d, *_ in idx.by_node.get(n, ())), default=None)
        days, day = 0, today
        while (last is None or day > last) and days < 365 \
                and due_on(n, nodes, evidence, carr, day):
            days += 1
            day -= timedelta(days=1)
        if days >= STARVED_DAYS:
            out[n] = days
    return out


def routed_around(nodes, problems, evidence, today=None):
    """{move: carrier} for every starved move (starved above) that had a
    carrier solved during its starvation run without the move in the
    record: the solve went another way and left the move where it was.
    Free-mode evidence records only what the code did, so a move solved
    around on every carrier is served again and again and never lands a
    rep. Its next carrier is served forced (`make force`): the solve must
    use the move or `make solved` rejects it. One alternative walk while
    the move is not yet starved is still just an alternative walk."""
    today = today or date.today()
    idx = ev_index(evidence)
    out = {}
    for n, days in starved(nodes, problems, evidence, today).items():
        since = today - timedelta(days=days)
        for pnum, p in problems.items():
            if n not in p.get("moves", []):
                continue
            for d, _, rec in idx.by_problem.get(pnum, ()):
                if date.fromisoformat(d) >= since and n not in rec.get("moves", {}):
                    out[n] = pnum
                    break
            if n in out:
                break
    return out


def parked_summits(problems, nodes, evidence, statuses, asleep):
    """Ready summits (rule 4 would serve them) that are asleep - the empty
    serve must name them, since only `make wake` can bring them back."""
    return [p for p in ready_hards(problems, nodes, evidence, statuses) if p in asleep]


def unmapped_summits(problems, nodes, evidence, statuses):
    """Unsolved Hards whose only gaps are unmapped proposals: all-green on
    the map, unroutable off it. These are the "needs new problems mapped"
    case - a node has to be added before the summit can be served."""
    solved = solved_problems(evidence)
    immature = immature_nodes(nodes, evidence, problems)
    out = []
    for pnum, p in problems.items():
        if (p.get("difficulty") != "Hard" or p.get("banned")
                or pnum in solved or not p.get("moves") or not p.get("unmapped")):
            continue
        gaps, count, _ = route_gaps(pnum, problems, nodes, statuses, immature)
        if not gaps and count:
            out.append(pnum)
    return sorted(out, key=pnum_key)


def load_plan():
    """Today's frozen study plan (data/study_plan/<date>.json). On the first
    run of a new day the file does not exist yet, so build it — kg_today is
    idempotent, and freezing at first serve keeps the determinism boundary:
    judgment runs once, then serving is a pure function of (plan, evidence).
    KG_NO_PLAN=1 disables the plan altogether (nothing is frozen either)."""
    if os.environ.get("KG_NO_PLAN", "").strip() not in ("", "0"):
        return None
    path = os.path.join(
        os.path.dirname(GRAPH_DIR), "data", "study_plan", f"{date.today().isoformat()}.json"
    )
    if not os.path.exists(path):
        console.print("[dim]new day — freezing today's plan...[/dim]")
        subprocess.run(
            [sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "kg_today")]
        )
    try:
        with open(path) as f:
            return json.load(f)
    except OSError:
        return None


def plan_item_done(item, evidence, plan):
    """Self-clearing, the way sleep entries resolve: a matching rep on or
    after the plan date marks the item done. create-drill clears when a new
    bank file lands after the plan was generated."""
    kind = item["kind"]
    if kind == "create-drill":
        import glob

        gen = datetime.fromisoformat(plan["generated"]).timestamp()
        return any(
            os.path.getmtime(p) >= gen
            for p in glob.glob(os.path.join(DRILLS_DIR, item["node"], "*.py"))
        )
    if kind == "drill":
        return any(
            r["date"] >= plan["date"] and item["node"] in r.get("moves", {})
            for r in evidence.values()
        )
    return any(
        r.get("problem") == str(item["problem"]) and r["date"] >= plan["date"]
        for r in evidence.values()
    )


def gated_label(h, problems, evidence, labeled):
    """What a gated problem or drill is called: its number and title, or
    its drill title, under `graph`; otherwise a status word and a face,
    like the nodes above it (no names leak from the default output)."""
    if labeled:
        return f"{h}. {problems[h]['title'] if h in problems else drills()[h]['title']}"
    st = vertex_status(h, problems, evidence)
    return f"{st} {random.choice(STATUS_FACE[st])}"


def add_gated(dot, from_node, vid, problems, evidence, labeled):
    """Draw what `vid` holds behind it under its box: one outlined box per
    problem or drill whose "after" names it, with an edge from `from_node`.
    The reverse of the input tree above the box."""
    for h in gates(vid, problems):
        gid = f"gated_{h}"
        dot.node(gid, label=gated_label(h, problems, evidence, labeled), shape="box",
                 style="rounded", color="#8b949e", fontcolor="#c9d1d9",
                 margin="0.15,0.08")
        dot.edge(from_node, gid, color="#8b949e", style="dashed")


def print_gates(vid, problems, evidence, labeled):
    """One dim line for what this problem or drill holds behind it: names
    under `graph`, faces otherwise. Nothing is printed when nothing does."""
    held = gates(vid, problems)
    if not held:
        return
    names = [gated_label(h, problems, evidence, labeled) for h in held]
    console.print(f"[dim]gates: {' · '.join(names)}[/dim]")


def main():
    """Serve the pick, then the park. The footer is printed on every way
    out of _main (a pick, a refusal, nothing to serve) so the parked
    problems are seen every day."""
    footer = []
    try:
        _main(footer)
    finally:
        if footer:
            console.print()
            for line in footer:
                console.print(f"[dim]{line}[/dim]")


def _main(footer):
    parser = argparse.ArgumentParser(
        description="Pick the next problem and draw its input tree."
    )
    parser.add_argument(
        "words",
        nargs="*",
        metavar="WORD",
        help="an integer N (show the Nth recommendation, skipping the first "
        "N-1) and/or a group name (sql, trees, graphs, ...) to restrict the "
        "pick to; makefile form: `make next sql 2`",
    )
    parser.add_argument(
        "--graph",
        action="store_true",
        help="label tree nodes with move names (default: shape only)",
    )
    parser.add_argument("--no-show", action="store_true", help="skip the drawing")
    parser.add_argument(
        "--why",
        action="store_true",
        help="when there is nothing to serve, name the frontier "
        "nodes the bank cannot carry, and why",
    )
    parser.add_argument(
        "--group",
        default=None,
        help="restrict the pick to one curated group of nodes (e.g. sql); "
        "makefile form: `make next sql`",
    )
    parser.add_argument(
        "--cram",
        action="store_true",
        help="ignore the cross-bank hold (prereq owned by an unaided rep); "
        "makefile form: `make next sql cram`",
    )
    parser.add_argument(
        "--early",
        action="store_true",
        help="review the group ahead of the curve: every node gets its next "
        "drill, prereqs before dependents regardless of status; skips today's "
        "plan; implies --cram; "
        "makefile form: `make next sql cram early`",
    )
    parser.add_argument(
        "--assisted",
        action="store_true",
        help="review only the drills whose latest rep was assisted (hint, "
        "walkthrough, learning): the unaided rep each is waiting for; "
        "implies --early; makefile form: `make next sql assisted`",
    )
    parser.add_argument(
        "--prepare",
        action="store_true",
        help="run `make prepare` on the pick (stub + branch — the solve clock starts)",
    )
    args = parser.parse_intermixed_args()
    args.n = 1
    groups = {n.get("group") for n in load_nodes().values()} - {None}
    for w in args.words:
        if w.isdigit():
            args.n = int(w)
        elif w in groups:
            args.group = w
        else:
            parser.error(f"{w!r} is not a number or a group "
                         f"({', '.join(sorted(groups))})")
    labeled = args.graph

    def prepare(target, force=False):
        if not args.prepare:
            return
        cur = os.path.join(REPO_ROOT, "current.py")
        if os.path.exists(cur) and open(cur).read().strip():
            console.print(
                "[yellow]current.py is not empty — record it (make solved) before preparing the next one.[/yellow]"
            )
            sys.exit(1)
        # a forced pick arms the style judge as well (kg_force runs prepare)
        tool = "kg_force" if force else "prepare"
        subprocess.run(
            [sys.executable, os.path.join(UTILS, tool), str(target)],
            cwd=REPO_ROOT,
        )

    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()
    statuses = {n: node_status(n, evidence) for n in nodes}
    immature = immature_nodes(nodes, evidence, problems)

    def maturity_cell(n):
        # the simmer rule made visible: SOLID says you can recall it today,
        # mature says the badge survived a gap and a real problem
        return "[yellow]young[/yellow]" if n in immature else "[dim]mature[/dim]"

    asleep, woken = sleep_state(nodes, problems, evidence)
    if asleep:
        footer.extend(sleep_lines(nodes, problems, evidence, statuses))
    for g, c in sorted(group_caps().items()):
        k = group_reps(g, nodes, evidence)
        footer.append(f"{g}: {k}/{c} reps today"
                      + (" - at the daily cap, make next {g} to go past it".format(g=g)
                         if k >= c else " (KG_GROUP_CAP)"))

    session_start = is_session_start()

    secs = _iss().solve_seconds_today()
    if secs:
        h, m = divmod(secs // 60, 60)
        clock = f"{h}h {m:02d}m" if h else f"{m}m"
        console.print(f"[dim]today: {clock} solving[/dim]")

    # the recognition axis (kg.recognition): a statement to read before the
    # solve, three minutes, when a node's trigger is missing or untested.
    # Which node is not said - the emoji is decodable and the rep would
    # test nothing. Group walks (sql, ...) are about their group, so no.
    if not (args.group or args.early or args.assisted) and rc.due_spot(
            nodes, problems, evidence,
            rc.derived(rc.load_recognition(), evidence, problems, statuses),
            statuses, skip=set(asleep)):
        console.print("[bold]spot rep due[/bold] - make prepare spot (read the statement, "
                      "name the move, no code; before the solve)")

    exclude = set(solved_today_pnums())
    choice = None
    shown = 0
    refused = False  # rule 0b: a new-ground pick withheld by a full park
    plan_note = None

    def warn_dry(served):
        """Starvation, surfaced without asking. The failure mode this kills:
        two weeks of Aug 2026 the picker silently fell through to warmups
        and summits while due moves expired, and it only showed in the
        solve stats.

        Scanned with an empty exclude so today's transient state (a carrier
        solved today, the pick being served right now) reads as servable.
        Only the structurally dry warn - moves no mapped, drilled, or
        drafted problem can EVER carry as things stand (blocked_frontier's
        dry flag); a node that is merely waiting is not a to-do. Nodes with
        a drill bank stay quiet - their drill re-offers tomorrow.

        The second warning is measured, not structural: a move due for
        STARVED_DAYS in a row with no rep aimed at it (starved), whatever
        the reason. The picker promising to serve it is not the same as
        having served it."""
        hungry = starved(nodes, problems, evidence)
        if hungry:
            names = ", ".join(
                f"{n} ({k}d)" for n, k in sorted(hungry.items(), key=lambda x: -x[1]))
            console.print(
                f"[yellow]⚠ starved: {names} - due that long with nothing "
                f"aimed at {'it' if len(hungry) == 1 else 'them'}[/yellow]")
        dry = [
            nid for nid, _, why, is_dry in blocked_frontier(
                nodes, problems, evidence, statuses, asleep, ())
            if is_dry and not has_drill_bank(nid)
        ]
        if dry:
            names = ", ".join(dry)
            console.print(
                f"[yellow]⚠ dry on {names} — nothing can serve "
                f"{'this move' if len(dry) == 1 else 'these moves'} "
                f"(make next --why)[/yellow]")

    # Today's frozen plan comes first: serve its pending items in order,
    # transparently — same rendering, same commands. Items self-clear from
    # evidence; an exhausted or absent plan falls through to the normal rules.
    # the clock, announced: how many files are due and of what kind. A
    # starved bank must show in the default output, not in an audit.
    clock = []
    if drill_scheduler() == "anki":
        scope = [n for n in nodes
                 if args.group is None or nodes[n].get("group") == args.group]
        clock = anki_frontier(evidence, nodes=nodes, node_ids=scope,
                              assisted=args.assisted)
        reviews = sum(1 for path, _ in clock if anki_due(path, evidence) is not None)
        console.print(f"[dim]drill clock: {len(clock)} due - {reviews} review, "
                      f"{len(clock) - reviews} never done[/dim]")
    plan = None if args.early or args.assisted or clock else load_plan()
    if plan:
        pending = [
            it
            for it in plan["items"]
            if not plan_item_done(it, evidence, plan)
            and str(it.get("problem", "")) not in exclude
            and it.get("problem") not in asleep
        ]
        # a drill item waits while a prereq's own drill is pending in the
        # same plan (or the prereq is rusty with a bank) - plan order is
        # judgment output, not a dependency order, so the hold is applied
        # here. Self-clearing: the prereq's rep clears its item and the hold.
        plan_drills = {it["node"] for it in pending if it["kind"] == "drill"}
        pending = [
            it
            for it in pending
            if it["kind"] != "drill"
            or (
                # the curve outranks the flag: a SOLID, owned node's drill
                # item is satisfied, whatever prescribed it
                not (statuses[it["node"]][0] == SOLID
                     and owned(it["node"], evidence))
                and not drill_held(it["node"], nodes, statuses, evidence,
                                   has_bank=has_drill_bank,
                                   pending=plan_drills - {it["node"]})
            )
        ]
        idx = max(1, args.n) - 1
        if idx < len(pending):
            item = pending[idx]
            if item["kind"] == "create-drill":
                with console.capture() as cap:
                    console.print(f"\n[bold]create drill: {item['node']}[/bold]")
                    if item.get("spec"):
                        console.print(item["spec"])
                    console.print(
                        "[dim]plan item — clears when a new bank file lands in "
                        f"drills/{item['node']}/[/dim]"
                    )
                animate(cap.get())
                return
            if item["kind"] == "drill":
                if due_drill(item["node"], evidence):
                    choice = (
                        item["node"],
                        statuses[item["node"]][0],
                        f"drill:{item['node']}",
                        f"plan: {item.get('why', '')}",
                    )
            elif str(item.get("problem", "")) in problems:
                pnum = str(item["problem"])
                moves = problems[pnum]["moves"]
                target = next((m for m in moves if statuses[m][0] != SOLID), moves[0])
                plan_note = item.get("note")
                choice = (target, statuses[target][0], pnum, f"plan: {item['kind']}")
            if withheld(choice, asleep):
                choice, refused = None, True
            shown = 1 if choice else 0

    if not choice:
        for _ in range(max(1, args.n)):
            choice = pick(
                nodes,
                problems,
                evidence,
                statuses,
                asleep=asleep,
                woken=woken,
                exclude=exclude,
                session_start=session_start,
                group=args.group,
                cram=args.cram,
                early=args.early,
                assisted=args.assisted,
            )
            if not choice:
                break
            if withheld(choice, asleep):
                choice, refused = None, True
                break
            shown += 1
            exclude.add(choice[2])
    if refused and not choice:
        for line in park_full_lines(asleep, problems):
            console.print(line)
        return
    if not choice:
        # Zero friction: time worked, and what to work on next. Nothing else.
        # Basecamp running dry is the expected end state, not a fault — it
        # means the summits are the only thing left, so say so in one line.
        # The diagnosis of WHY a frontier node could not be served is real
        # but it is bank maintenance, not the answer to "what now": it lives
        # behind --why.
        if shown:
            console.print(f"[yellow]Only {shown} recommendation(s) available.[/yellow]")
        elif args.group:
            held = [] if args.cram or args.early or args.assisted else sorted(
                n for n in nodes
                if nodes[n].get("group") == args.group
                and statuses[n][0] != SOLID
                and drill_held(n, nodes, statuses, evidence, has_bank=has_drill_bank)
            )
            if held:
                console.print(
                    f"\nNothing to serve — {len(held)} {args.group} node(s) are held "
                    "behind a prereq without an unaided clean rep. "
                    f"`make next {args.group} cram` ignores the hold."
                )
            else:
                console.print("\nNothing to serve — the group is spent for today.")
        else:
            # "nothing due" and "the bank is starved" are different answers:
            # say which one this is, and what the wait is on.
            blocked = blocked_frontier(
                nodes, problems, evidence, statuses, asleep, exclude
            )
            dry = [b for b in blocked if b[3]]
            waiting = [b for b in blocked if not b[3]]
            parked = parked_summits(problems, nodes, evidence, statuses, asleep)
            unmapped = unmapped_summits(problems, nodes, evidence, statuses)
            if dry:
                console.print("\nNothing to serve — the graph needs new problems mapped.")
            elif waiting or parked:
                console.print("\nNothing due today.")
            else:
                console.print("\nNothing to serve — every mapped move is solid and every summit is climbed.")
            if waiting:
                n = len(waiting)
                console.print(f"[dim]{n} move{'s' if n > 1 else ''} waiting (make next --why)[/dim]")
            if parked:
                for pnum in parked:
                    console.print(
                        f"⛰  {pnum}. {problems[pnum]['title']} is ready and asleep — "
                        f"`make wake {pnum}`")
            if unmapped:
                console.print(
                    f"[dim]summits blocked only by an unmapped move (needs a node): "
                    f"{', '.join(unmapped)}[/dim]")
            # the reach rule found no carrier for any of these today
            young = sorted(
                ((n, g) for n, g in
                 unlocks(statuses, problems, immature=immature).items()
                 if n in immature and statuses[n][0] == SOLID),
                key=lambda t: (-t[1], t[0]),
            )[:3]
            if young:
                console.print(
                    "[dim]young moves with no proving carrier today, by drafted "
                    "problems waiting: "
                    + ", ".join(f"{n} ({g})" for n, g in young) + "[/dim]")

        if not args.why:
            warn_dry(served=False)
        if args.why:
            blocked = blocked_frontier(
                nodes, problems, evidence, statuses, asleep, exclude
            )
            if blocked:
                table = Table(
                    show_header=True, header_style="bold", box=None, padding=(0, 2)
                )
                table.add_column("Move")
                table.add_column("Status")
                table.add_column("Why it can't be served")
                for nid, status, why, is_dry in blocked:
                    table.add_row(
                        nid,
                        f"[{STATUS_STYLE[status]}]{status}[/{STATUS_STYLE[status]}]",
                        ("[yellow]dry:[/yellow] " if is_dry else "") + why,
                    )
                console.print()
                console.print(table)
        return
    target, target_status, pnum, reason = choice

    # how much review stands between now and the first pick that is new
    # ground; the early and assisted walks review everything by design
    ahead = None if args.early or args.assisted else review_line(
        *review_ahead(nodes, problems, evidence, asleep=asleep,
                      exclude=solved_today_pnums(), group=args.group))

    if str(pnum).startswith("drill:"):
        path = due_drill(target, evidence, early=args.early, assisted=args.assisted)
        title = drill_title(path)
        did = drill_id(path)
        name = f"{did}. {title}" if did else f"drill: {title}"
        s, d = statuses[target]
        table = Table(show_header=True, header_style="bold", box=None, padding=(0, 2))
        table.add_column("Move")
        table.add_column("Status")
        table.add_column("Maturity")
        table.add_column("Last evidence")
        label = target if labeled else random.choice(STATUS_FACE[s])
        table.add_row(
            label,
            f"[{STATUS_STYLE[s]}]{s}[/{STATUS_STYLE[s]}]",
            maturity_cell(target),
            str(d) if d else "—",
        )
        with console.capture() as cap:
            console.print(f"\n[bold]{name}[/bold]")
            console.print(table)
            print_gates(did or title, problems, evidence, labeled)
            fc = drill_forecast(path)
            if fc:
                expect, hint, bail = (f"{round(v):d}m" for v in fc)
                console.print(f"[dim]pace: ~{expect} expected · hint fair game after "
                              f"{hint} · at {bail} stop, mark it, reinforce[/dim]")
            if ahead:
                console.print(f"[dim]{ahead}[/dim]")
            console.print(f"make prepare {did or target}")
        if not args.no_show:
            tree = input_tree([target], nodes)
            dot = make_digraph("input-tree")
            for n in tree:
                s, d = statuses[n]
                status_node(
                    dot, n, nodes[n], s, d, highlight=(n == target), labeled=labeled
                )
            for n in tree:
                for pre in nodes[n].get("prereqs", []):
                    if pre in tree:
                        dot.edge(pre, n)
            dot.node(
                "drill_box",
                label=name,
                shape="box",
                style="filled",
                fillcolor="#1f6feb",
                color="#c9d1d9",
                penwidth="2",
                fontsize="13",
                margin="0.2,0.12",
            )
            dot.edge(target, "drill_box", penwidth="1.4")
            add_gated(dot, "drill_box", did or title, problems, evidence, labeled)
            try:
                logical_width = render(dot, "kg_next")
                display("kg_next", logical_width)
            except Exception as e:
                console.print(f"[dim](tree drawing failed — {type(e).__name__}; cosmetic, pick unaffected)[/dim]")
        animate(cap.get())
        warn_dry(served=True)
        # the exact file the pick chose, not the node: `utils/kg/drill <node>`
        # re-picks with the everyday servable rule (unaided-clean bar), which
        # under `cram early` handed back r1 while the pick said r3
        # (the 2026-08-30 spark-join circle)
        prepare(path)
        return

    p = problems[pnum]
    # the starved move whose carriers keep being solved another way: this
    # rep is held to the move (routed_around), served as `make force`
    around = routed_around(nodes, problems, evidence).get(target)
    forced = around is not None
    force_note = (f"{around} was solved without this move while it was due - "
                  "this rep must use it") if forced else None

    table = Table(show_header=True, header_style="bold", box=None, padding=(0, 2))
    table.add_column("Move")
    table.add_column("Status")
    table.add_column("Maturity")
    table.add_column("Last evidence")
    for m in p["moves"]:
        s, d = statuses[m]
        label = m if labeled else random.choice(STATUS_FACE[s])
        table.add_row(
            label,
            f"[{STATUS_STYLE[s]}]{s}[/{STATUS_STYLE[s]}]",
            maturity_cell(m),
            str(d) if d else "—",
        )

    # A summit reads differently from a basecamp problem — it is a test, taken
    # all-green — so it gets kg_hard's mountain rather than a word of prose.
    summit = "⛰  " if p.get("difficulty") == "Hard" else ""

    with console.capture() as cap:
        console.print(f"\n[bold]{summit}{pnum}. {p['title']}[/bold]")
        console.print(problem_url(pnum))
        if p.get("predicted"):
            console.print("[yellow]⚠ drafted walk, not yet evidenced — "
                          "your solve is what maps this problem[/yellow]")
        if p.get("note"):
            console.print(f"[yellow]⚠ {p['note']}[/yellow]")
        if plan_note:
            console.print(f"[yellow]{plan_note}[/yellow]")
        if force_note:
            console.print(f"[yellow]⚠ {force_note}[/yellow]")
        console.print(table)
        print_gates(pnum, problems, evidence, labeled)
        # pacing forecast from the mined solve-time history: expected time,
        # the point where a hint is fair game, and the point where the rep
        # has become a grind — bank it and reinforce instead
        fc = solve_forecast(pnum, problems)
        if fc:
            expect, hint, bail = (f"{round(v):d}m" for v in fc)
            console.print(f"[dim]pace: ~{expect} expected · hint fair game after "
                          f"{hint} · at {bail} stop, mark it, reinforce[/dim]")
        if ahead:
            console.print(f"[dim]{ahead}[/dim]")
        if forced:
            console.print(f"make force {pnum}")

    if args.no_show:
        animate(cap.get())
        warn_dry(served=True)
        prepare(pnum, force=forced)
        return

    tree = input_tree(p["moves"], nodes)
    dot = make_digraph("input-tree")
    for n in tree:
        s, d = statuses[n]
        status_node(
            dot, n, nodes[n], s, d, highlight=(n in p["moves"]), labeled=labeled
        )
    for n in tree:
        for pre in nodes[n].get("prereqs", []):
            if pre in tree:
                dot.edge(pre, n)
    problem_node = f"problem_{pnum}"
    dot.node(
        problem_node,
        label=f"{pnum}. {p['title']}",
        shape="box",
        style="filled",
        fillcolor="#1f6feb",
        color="#c9d1d9",
        penwidth="2",
        fontsize="13",
        margin="0.2,0.12",
        tooltip=problem_url(pnum),
    )
    for m in p["moves"]:
        dot.edge(m, problem_node, penwidth="1.4")
    add_gated(dot, problem_node, pnum, problems, evidence, labeled)
    # the drawing is cosmetic: a font/graphviz hiccup (transient Pango emoji
    # failures happen) must never kill the pick itself
    try:
        logical_width = render(dot, "kg_next")
        display("kg_next", logical_width)
    except Exception as e:
        console.print(f"[dim](tree drawing failed — {type(e).__name__}; cosmetic, pick unaffected)[/dim]")
    animate(cap.get())
    warn_dry(served=True)
    prepare(pnum, force=forced)


if __name__ == "__main__":
    main()
