#!/usr/bin/env python3

# kg_curve — fit a personal forgetting curve from evidence.json and write
# graph/curve.json, which kg_lib.node_status() uses instead of the flat
# 42-day window (delete curve.json to fall back).
#
#   make curve                 # refit from current evidence + report
#
# Model: power-law forgetting with a slip rate.
#   P(recall after gap Δ) = (1−slip) · (1 + Δ/s)^(−β)
#   s = exp(a + b·cleans − c·struggles − d·assist)   — stability, grows with reps
# Power-law because real forgetting curves have heavy tails (Wixted), and an
# exponential fitted to this data loses to a constant baseline; slip because
# short-gap failures are retrieval noise, not forgetting — no curve pinned to
# P(0)=1 can fit a 95% ceiling. Fit by maximum likelihood on recall trials:
# a trial is the FIRST solve of a node on a day, when the node had at least
# one prior clean — success if clean, failure if struggled. Within-day order
# comes from filename timestamps, so a morning struggle followed by an
# evening consolidation counts as the failure it was. 'avoided' verdicts are
# neither success nor failure (the move went unused). A trial only counts as
# a SUCCESS if the recall was the candidate's own: clean with assist none or
# hint. Walked-through or spoiled solves are failures — the code ran, but no
# retrieval happened. Status uses the memory component only: SOLID while
# (1 + Δ/s)^(−β) >= target_retention.

import json
import math
import os
import re
from collections import defaultdict

from kg.kg_lib import ASSIST_WEIGHT, GRAPH_DIR, assist_of, load_evidence, load_problems, node_conn

TARGET_RETENTION = 0.9   # node_status calls a node SOLID above this


def extract_trials(evidence, with_date=False, with_conn=False):
    """[(gap_days, success, prior_cleans, prior_struggles, prior_assist)] per
    node; with_date=True appends the trial's date as a 6th element,
    with_conn=True appends the node's connectivity (log2 carriers) instead —
    the covariate the fit uses (solve-time analysis 2026-08-25: well-carried
    moves hold on longer than their rep counts alone predict)."""
    events = defaultdict(list)  # node -> [(date, ts, verdict, assist)]
    for fname, rec in evidence.items():
        m = re.search(r"\d{4}_\d{2}_\d{2}T[\d_]+", fname)
        ts = m.group(0) if m else ""
        for node, verdict in rec.get("moves", {}).items():
            events[node].append((rec["date"], ts, verdict, assist_of(rec, node)))

    conn = node_conn(load_problems()) if with_conn else {}
    trials = []
    for node, evs in events.items():
        evs.sort()
        days = defaultdict(list)
        for d, _, v, a in evs:
            days[d].append((v, a))
        last_clean, cleans, struggles, assisted = None, 0, 0, 0.0
        retrieved = False  # an unaided clean so far: the memory exists to test
        for d in sorted(days):
            verdict, assist = days[d][0]
            # a spoiled solve is CENSORED, not failed: the candidate never
            # attempted the recall, so this day says nothing about whether the
            # memory was still there. It earns no rep either way (below).
            # a trial needs a prior UNAIDED clean: after only walked-through
            # or hinted cleans nothing was retrieved yet, so the next attempt
            # is a first attempt, not a recall (2026-08-31: the sql cram walk,
            # copied one day and tried the next, read as 15 recall failures
            # at short gaps, z = -4.7; after an unaided clean the same wing
            # ran 8 of 8)
            if (retrieved and verdict in ("clean", "struggled")
                    and assist != "spoiled"):
                gap = (_date(d) - _date(last_clean)).days
                if gap >= 1:
                    # the trial asks "did you retrieve this unaided?" — needing
                    # a nudge or a walkthrough answers no, however clean the code
                    success = int(verdict == "clean" and assist == "none")
                    row = (gap, success, cleans, struggles, assisted)
                    if with_conn:
                        row += (conn.get(node, 0.0),)
                    trials.append(row + (_date(d),) if with_date else row)
            for v, a in days[d]:
                if v == "clean" and a != "spoiled":
                    cleans += 1
                    last_clean = d
                    retrieved = retrieved or a == "none"
                elif v == "struggled":
                    struggles += 1
                assisted += ASSIST_WEIGHT[a]
    return trials


def _date(s):
    from datetime import date
    return date.fromisoformat(s)


def fit(trials, iters=8000, lr=0.05):
    """MLE for (a, b, c, d, e, conn_mean, beta, slip) in
    P = (1−slip)·(1 + Δ/s)^(−beta), s = exp(a + b·k − c·m − d·x + e·(conn − conn_mean)).
    Trials are 6-tuples (gap, success, cleans, struggles, assist, conn); the
    conn term is centered so a/b/c/d keep their meaning and consumers that
    ignore e are simply assuming average connectivity."""
    try:
        return _fit_numpy(trials, iters, lr)
    except ImportError:
        pass
    n = len(trials)
    conn_mean = sum(t[5] for t in trials) / n
    a, b, c, d, e, beta, slip = math.log(60), 0.05, 0.05, 0.05, 0.0, 0.5, 0.05
    for it in range(iters):
        ga = gb = gc = gd = ge = gbeta = gslip = 0.0
        for gap, sf, k, m, x, cn in trials:
            stab = math.exp(a + b * k - c * m - d * x + e * (cn - conn_mean))
            u = gap / stab
            mem = (1 + u) ** (-beta)
            p = min(1 - 1e-9, max(1e-9, (1 - slip) * mem))
            # E = dLL/dP scaled: success pulls P up, failure pushes it down
            E = sf - (1 - sf) * p / (1 - p)
            dlns = E * beta * u / (1 + u)          # dLL/d(ln stability)
            ga += dlns
            gb += dlns * k
            gc += dlns * (-m)
            gd += dlns * (-x)
            ge += dlns * (cn - conn_mean)
            gbeta += E * (-math.log(1 + u))
            gslip += E * (-1 / (1 - slip))
        step = lr / (1 + it / 2000)
        a += step * ga / n
        b = max(0.0, b + step * gb / n)            # reps should not shorten memory
        c = max(0.0, c + step * gc / n)
        d = max(0.0, d + step * gd / n)            # nor should being helped
        e += step * ge / n
        beta = min(5.0, max(0.02, beta + step * gbeta / n))
        slip = min(0.25, max(0.0, slip + step * gslip / n))
    return a, b, c, d, e, conn_mean, beta, slip


def _fit_numpy(trials, iters, lr):
    import numpy as np

    gap, sf, k, m, x, cn = (np.array(v, dtype=float) for v in zip(*trials))
    n = len(trials)
    conn_mean = float(cn.mean())
    cnc = cn - conn_mean
    a, b, c, d, e, beta, slip = math.log(60), 0.05, 0.05, 0.05, 0.0, 0.5, 0.05
    for it in range(iters):
        u = gap / np.exp(a + b * k - c * m - d * x + e * cnc)
        mem = (1 + u) ** (-beta)
        p = np.clip((1 - slip) * mem, 1e-9, 1 - 1e-9)
        E = sf - (1 - sf) * p / (1 - p)
        dlns = E * beta * u / (1 + u)
        step = lr / (1 + it / 2000) / n
        a += step * dlns.sum()
        b = max(0.0, b + step * (dlns * k).sum())
        c = max(0.0, c + step * (-dlns * m).sum())
        d = max(0.0, d + step * (-dlns * x).sum())
        e += step * (dlns * cnc).sum()
        beta = min(5.0, max(0.02, beta + step * (-E * np.log1p(u)).sum()))
        slip = min(0.25, max(0.0, slip + step * (-E / (1 - slip)).sum()))
    return a, b, c, d, e, conn_mean, beta, slip


def loglik(trials, pred):
    return sum(math.log(max(1e-9, pred(g, k, m, x, cn) if s else 1 - min(1 - 1e-9, pred(g, k, m, x, cn))))
               for g, s, k, m, x, cn in trials) / len(trials)


GAP_BUCKETS = ((1, 7), (8, 21), (22, 42), (43, 90), (91, 180), (181, 400))

# Terminal chart palette: the GitHub-dark tones kg_render already draws the
# trees in. The model/observed pair is validated (dataviz six checks, dark
# surface); the reps ramp is sequential (one blue, darker -> lighter with
# reps) and every series is direct-labeled, never legend-only.
INK, INK2, GRID, SURFACE = "#c9d1d9", "#8b949e", "#21262d", "#0d1117"
BLUE_RAMP = ("#1f6feb", "#388bfd", "#79c0ff")
MODEL_BLUE, OBSERVED_GREEN = "#388bfd", "#2ea043"


def render_chart(stab, pred, trials, beta):
    """graph/curve_report.png — the refit report as three panels: the fitted
    forgetting curves by clean reps, the retention window by assist level,
    and the calibration check (model vs observed per gap bucket). Returns
    the png path, or None when matplotlib is unavailable."""
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except ImportError:
        return None

    fig, axes = plt.subplots(1, 3, figsize=(13.5, 4.0), dpi=200)
    fig.patch.set_facecolor(SURFACE)
    for ax in axes:
        ax.set_facecolor(SURFACE)
        for side in ("top", "right"):
            ax.spines[side].set_visible(False)
        for side in ("left", "bottom"):
            ax.spines[side].set_color(GRID)
        ax.tick_params(colors=INK2, labelsize=8)
        ax.grid(True, color=GRID, linewidth=0.6, alpha=0.6)
        ax.set_axisbelow(True)

    def window(k, x=0.0):
        return stab(k, 0, x) * (TARGET_RETENTION ** (-1 / beta) - 1)

    # panel 1: P(recall) vs gap, one curve per rep count, window marked where
    # each curve crosses the retention target
    ax = axes[0]
    gaps = [g / 2 for g in range(1, 481)]  # 0.5..240d
    for color, k in zip(BLUE_RAMP, (1, 5, 20)):
        ax.plot(gaps, [pred(g, k, 0) for g in gaps], color=color, linewidth=2)
        w = window(k)
        ax.annotate(f"{k} rep{'s' if k > 1 else ''} · {w:.0f}d",
                    xy=(min(w, 235), TARGET_RETENTION), color=color, fontsize=8,
                    xytext=(4, 4 + 11 * (1, 5, 20).index(k)), textcoords="offset points")
        ax.plot([w], [TARGET_RETENTION], "o", color=color, markersize=5)
    ax.axhline(TARGET_RETENTION, color=INK2, linewidth=1, linestyle="--", alpha=0.7)
    ax.annotate(f"SOLID above {TARGET_RETENTION:.0%}", xy=(238, TARGET_RETENTION),
                color=INK2, fontsize=8, ha="right", xytext=(0, -12),
                textcoords="offset points")
    ax.set_xlim(0, 240)
    ax.set_title("P(recall) by clean reps, unaided", color=INK, fontsize=10)
    ax.set_xlabel("days since last clean", color=INK2, fontsize=8)

    # panel 2: what help costs — the 90% window at 5 reps per assist level
    ax = axes[1]
    labels = ("unaided", "one hint", "walkthrough", "spoiled")
    xs = (0.0, 0.5, 1.0, 2.0)
    ws = [window(5, x) for x in xs]
    ys = range(len(labels))[::-1]
    ax.barh(ys, ws, height=0.55, color=MODEL_BLUE)
    for y, w in zip(ys, ws):
        ax.annotate(f"{w:.0f}d", xy=(w, y), color=INK, fontsize=9,
                    va="center", xytext=(4, 0), textcoords="offset points")
    ax.set_yticks(list(ys), labels)
    ax.tick_params(axis="y", colors=INK)
    ax.grid(axis="y", visible=False)
    ax.set_title("90%-retention window at 5 reps", color=INK, fontsize=10)
    ax.set_xlabel("days", color=INK2, fontsize=8)

    # panel 3: calibration — model mean vs observed clean-rate per gap
    # bucket, observed dots sized by evidence mass; y spans the data, not 0..1
    ax = axes[2]
    pts = []
    for lo, hi in GAP_BUCKETS:
        rows = [t for t in trials if lo <= t[0] <= hi]
        if not rows:
            continue
        obs = sum(t[1] for t in rows) / len(rows)
        mod = sum(pred(g, k, m, x, cn) for g, _, k, m, x, cn in rows) / len(rows)
        pts.append(((lo * hi) ** 0.5, mod, obs, len(rows)))
    xs, mods, obss, ns = zip(*pts)
    ax.set_xscale("log")
    ax.plot(xs, mods, color=MODEL_BLUE, linewidth=2, marker="o", markersize=5)
    ax.scatter(xs, obss, color=OBSERVED_GREEN, s=[12 + n / 2 for n in ns], zorder=3)
    for x, o, n in zip(xs, obss, ns):
        ax.annotate(f"n={n}", xy=(x, o), color=INK2, fontsize=7,
                    xytext=(0, 8), textcoords="offset points", ha="center")
    ax.annotate("model", xy=(xs[-1], mods[-1]), color=MODEL_BLUE, fontsize=9,
                xytext=(6, -2), textcoords="offset points")
    ax.annotate("observed", xy=(xs[-1], obss[-1]), color=OBSERVED_GREEN, fontsize=9,
                xytext=(6, 4), textcoords="offset points")
    lo_y = min(min(mods), min(obss))
    ax.set_ylim(max(0.0, lo_y - 0.06), 1.04)
    ax.set_xticks(xs, [f"{lo}-{hi}" for lo, hi in GAP_BUCKETS[:len(xs)]])
    ax.minorticks_off()
    ax.set_title("calibration by gap (model vs observed)", color=INK, fontsize=10)
    ax.set_xlabel("gap, days (log)", color=INK2, fontsize=8)

    fig.tight_layout(pad=1.4)
    out = os.path.join(GRAPH_DIR, "curve_report.png")
    fig.savefig(out, facecolor=SURFACE)
    plt.close(fig)
    return out


def fit_mass(evidence, problems):
    """The rehearsal-mass term of the pass model (kg_lib.pass_rates):
    logistic regression of a cold first attempt being clean and unaided on
    x = log(1 + mass), mass = how many evidenced problems carry the walk's
    rarest move, with one intercept per difficulty. The 2026-08-31 check:
    Medium first attempts go 74% -> 92% clean from the rarest to the most
    rehearsed tercile, Easy 75% -> 95%, and acceptance rate predicts
    nothing. beta is the log-odds per unit of x; consumers apply
    beta * (x - pool mean x), so a uniform draw keeps its average and a
    friendly-first serving order (rule 6) stops biasing the fitted rate.
    Returns {"beta", "se", "n", "by_difficulty": {intercept per class}}."""
    import numpy as np
    from kg.kg_lib import assist_of, problem_difficulty, carrier_counts, walk_mass
    counts = carrier_counts(problems)
    seen, rows = set(), []
    for fname in sorted(evidence, key=lambda k: (evidence[k]["date"], k)):
        rec = evidence[fname]
        pnum = str(rec.get("problem", ""))
        if not pnum[:1].isdigit() or pnum in seen or not rec.get("moves"):
            continue
        seen.add(pnum)
        dif = problem_difficulty(pnum, problems)
        if dif not in ("Easy", "Medium", "Hard"):
            continue
        clean = all(v == "clean" for v in rec["moves"].values()) \
            and assist_of(rec) == "none"
        rows.append((dif, walk_mass(rec["moves"], counts), clean))
    if len(rows) < 30:
        return {"beta": 0.0, "se": 0.0, "n": len(rows), "by_difficulty": {}}
    difs = ["Easy", "Medium", "Hard"]
    X = np.array([[d == dd for dd in difs] + [x] for d, x, _ in rows], dtype=float)
    y = np.array([c for _, _, c in rows], dtype=float)
    w = np.zeros(X.shape[1])
    for _ in range(25):  # Newton's method on the log-likelihood
        pr = 1 / (1 + np.exp(-(X @ w)))
        grad = X.T @ (y - pr)
        hess = (X * (pr * (1 - pr))[:, None]).T @ X + 1e-6 * np.eye(X.shape[1])
        step = np.linalg.solve(hess, grad)
        w += step
        if np.abs(step).max() < 1e-8:
            break
    pr = 1 / (1 + np.exp(-(X @ w)))
    cov = np.linalg.inv((X * (pr * (1 - pr))[:, None]).T @ X + 1e-6 * np.eye(X.shape[1]))
    return {"beta": round(float(w[3]), 4), "se": round(float(np.sqrt(cov[3, 3])), 4),
            "n": len(rows),
            "by_difficulty": {d: round(float(w[i]), 4) for i, d in enumerate(difs)}}


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Fit the personal forgetting curve.")
    parser.add_argument("--if-stale", action="store_true",
                        help="refit only when evidence.json is newer than curve.json")
    args = parser.parse_args()

    curve_path = os.path.join(GRAPH_DIR, "curve.json")
    evidence_path = os.path.join(GRAPH_DIR, "evidence.json")
    if (args.if_stale and os.path.exists(curve_path)
            and os.path.getmtime(curve_path) >= os.path.getmtime(evidence_path)):
        return  # curve already reflects current evidence

    evidence = load_evidence()
    trials = extract_trials(evidence, with_conn=True)
    a, b, c, d, e, conn_mean, beta, slip = fit(trials)
    problems = load_problems()
    conn = node_conn(problems)
    mass = fit_mass(evidence, problems)

    def stab(k, m, x=0.0, cn=None):
        cn = conn_mean if cn is None else cn
        return math.exp(a + b * k - c * m - d * x + e * (cn - conn_mean))

    def pred(gap, k, m, x=0.0, cn=None):
        return (1 - slip) * (1 + gap / stab(k, m, x, cn)) ** (-beta)

    base_rate = sum(t[1] for t in trials) / len(trials)
    ll_model = loglik(trials, pred)
    ll_base = sum(math.log(base_rate if t[1] else 1 - base_rate)
                  for t in trials) / len(trials)

    curve = {
        "_comment": "Personal forgetting curve fitted by utils/kg/kg_curve. "
        "P(recall) = (1-slip)*(1 + gap/s)^(-beta), "
        "s = exp(a + b*cleans - c*struggles - d*assist + e*(conn - conn_mean)). "
        "conn is the node's log2 carrier count, frozen below at fit time; "
        "consumers that ignore e are assuming average connectivity. "
        "node_status() calls a node SOLID while the memory component "
        "(1 + gap/s)^(-beta) >= target_retention; delete this file to fall "
        "back to the flat 42-day window.",
        "model": "power-law-slip",
        "params": {"a": round(a, 4), "b": round(b, 4), "c": round(c, 4),
                   "d": round(d, 4), "e": round(e, 4),
                   "conn_mean": round(conn_mean, 4),
                   "beta": round(beta, 4), "slip": round(slip, 4)},
        "conn": {n: round(v, 3) for n, v in sorted(conn.items())},
        "target_retention": TARGET_RETENTION,
        "mass": mass,
        "fit": {"trials": len(trials), "loglik": round(ll_model, 4),
                "baseline_loglik": round(ll_base, 4)},
    }
    with open(os.path.join(GRAPH_DIR, "curve.json"), "w") as f:
        json.dump(curve, f, indent=2)

    from rich.console import Console
    console = Console(highlight=False)
    print = lambda line: console.print(
        f"[bold]{line}[/bold]" if line.startswith("fitted") or line.startswith("wrote")
        else f"[dim]{line}[/dim]" if line.startswith("  ") else f"[cyan]{line}[/cyan]")
    print(f"fitted on {len(trials)} trials: "
          f"P = {1 - slip:.2f}·(1 + Δ/s)^(−{beta:.2f}), "
          f"s = exp({a:.2f} + {b:.3f}·cleans − {c:.3f}·struggles − {d:.3f}·assist "
          f"+ {e:.3f}·conn)")
    print(f"loglik/trial {ll_model:.4f} vs always-{base_rate:.0%} baseline {ll_base:.4f}")
    print(f"{TARGET_RETENTION:.0%}-retention window by clean reps (no struggles, unaided):")
    for k in (1, 2, 3, 5, 10, 20):
        window = stab(k, 0) * (TARGET_RETENTION ** (-1 / beta) - 1)
        print(f"  {k:2d} reps: stability {stab(k, 0):5.0f}d -> window ≈ {window:5.0f}d")
    print("cost of assistance (5 clean reps, no struggles):")
    for label, x in (("unaided", 0.0), ("one hint", 0.5),
                     ("walkthrough", 1.0), ("spoiled", 2.0)):
        window = stab(5, 0, x) * (TARGET_RETENTION ** (-1 / beta) - 1)
        print(f"  {label:12s}: window ≈ {window:5.0f}d")
    print("calibration (model mean vs observed unaided-recall rate):")
    for lo, hi in GAP_BUCKETS:
        rows = [(g, s, k, m, x, cn) for g, s, k, m, x, cn in trials if lo <= g <= hi]
        if rows:
            obs = sum(s for _, s, _, _, _, _ in rows) / len(rows)
            mod = sum(pred(g, k, m, x, cn) for g, _, k, m, x, cn in rows) / len(rows)
            print(f"  gap {lo:3d}-{hi:3d}d: model {mod:4.0%}  observed {obs:4.0%}  (n={len(rows)})")
    print(f"wrote {os.path.join(GRAPH_DIR, 'curve.json')}")

    # the same report as a picture, drawn in-place on iTerm (silently skipped
    # when piped or unsupported — the text above is the everywhere fallback)
    import sys
    if sys.stdout.isatty():
        png = render_chart(stab, pred, trials, beta)
        if png:
            from kg.kg_render import show_inline
            show_inline(png, display_width_px=1100)


if __name__ == "__main__":
    main()
