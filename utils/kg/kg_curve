#!/usr/bin/env python3

# kg_curve — fit a personal forgetting curve from evidence.json and write
# graph/curve.json, which kg_lib.node_status() uses instead of the flat
# 42-day window (delete curve.json to fall back).
#
#   make curve                 # refit from current evidence + report
#
# Fit knobs, for experimenting with what the trial pool should say
# (CLI flag or env var; .envrc carries them the way it carries SPOT_EVERY,
# and --if-stale treats a knob change as stale):
#   --since YYYY-MM-DD / CURVE_SINCE       era boundary: older trials dropped
#   --half-life DAYS   / CURVE_HALF_LIFE   recency weight 0.5^(age/half-life)
#
# Model: power-law forgetting with a slip rate.
#   P(recall after gap Δ) = (1−slip) · (1 + Δ/s)^(−β)
#   s = exp(a + b·log1p(cleans) − c·struggles − d·assist)   — stability, grows with reps
#   (cleans = distinct clean DAYS: same-day reps are one rep, not several;
#   log1p because per-rep stability gain saturates — a linear exponent
#   compounded to multi-year windows at rep counts the data never sampled)
# Power-law because real forgetting curves have heavy tails (Wixted), and an
# exponential fitted to this data loses to a constant baseline; slip because
# short-gap failures are retrieval noise, not forgetting — no curve pinned to
# P(0)=1 can fit a 95% ceiling. Fit by maximum likelihood on recall trials:
# a trial is the FIRST solve of a node on a day, when the node had at least
# one prior clean — success if clean, failure if struggled. Within-day order
# comes from filename timestamps, so a morning struggle followed by an
# evening consolidation counts as the failure it was. 'avoided' verdicts are
# neither success nor failure (the move went unused). A trial only counts as
# a SUCCESS if the recall was the candidate's own: clean with assist none or
# hint. Walked-through or learning solves are failures — the code ran, but no
# retrieval happened. Status uses the memory component only: SOLID while
# (1 + Δ/s)^(−β) >= target_retention.

import json
import math
import os
import re
from collections import defaultdict

from kg import kg_lib
from kg.kg_lib import ASSIST_WEIGHT, GRAPH_DIR, assist_of, ev_index, load_evidence, load_problems, node_conn

TARGET_RETENTION = 0.9   # node_status calls a node SOLID above this


def extract_trials(evidence, with_date=False, with_conn=False):
    """[(gap_days, success, prior_cleans, prior_struggles, prior_assist)] per
    node; with_date=True appends the trial's date as a 6th element,
    with_conn=True appends the node's connectivity (log2 carriers) instead —
    the covariate the fit uses (solve-time analysis 2026-08-25: well-carried
    moves hold on longer than their rep counts alone predict)."""
    # (date, ts, verdict, assist, node_assist): assist is the help actually
    # taken, what a trial asks about; node_assist is what node_eval charges
    # the node for, "none" on the first rep of a drill (kg_lib.ev_index), so
    # the fitted covariates match the ones node_eval applies.
    events = defaultdict(list)
    first_reps = ev_index(evidence).first_reps
    for fname, rec in evidence.items():
        m = re.search(r"\d{4}_\d{2}_\d{2}T[\d_]+", fname)
        ts = m.group(0) if m else ""
        for node, verdict in rec.get("moves", {}).items():
            a = assist_of(rec, node)
            events[node].append((rec["date"], ts, verdict, a,
                                 "none" if fname in first_reps else a))

    conn = node_conn(load_problems()) if with_conn else {}
    trials = []
    for node, evs in events.items():
        evs.sort()
        days = defaultdict(list)
        for d, _, v, a, na in evs:
            days[d].append((v, a, na))
        last_clean, cleans, struggles, assisted = None, 0, 0, 0.0
        retrieved = False  # an unaided clean so far: the memory exists to test
        for d in sorted(days):
            verdict, assist, _ = days[d][0]
            # a learning solve is CENSORED, not failed: the candidate never
            # attempted the recall, so this day says nothing about whether the
            # memory was still there. It earns no rep either way (below).
            # a trial needs a prior UNAIDED clean: after only walked-through
            # or hinted cleans nothing was retrieved yet, so the next attempt
            # is a first attempt, not a recall (2026-08-31: the sql cram walk,
            # copied one day and tried the next, read as 15 recall failures
            # at short gaps, z = -4.7; after an unaided clean the same wing
            # ran 8 of 8)
            if (retrieved and verdict in ("clean", "struggled")
                    and assist != "learning"):
                gap = (_date(d) - _date(last_clean)).days
                if gap >= 1:
                    # the trial asks "did you retrieve this unaided?" — needing
                    # a nudge or a walkthrough answers no, however clean the code
                    success = int(verdict == "clean" and assist == "none")
                    row = (gap, success, cleans, struggles, assisted)
                    if with_conn:
                        row += (conn.get(node, 0.0),)
                    trials.append(row + (_date(d),) if with_date else row)
            # a day counts as at most one clean rep: same-day reps are massed
            # practice, and crediting each one grows stability as if they
            # were spaced (2026-09-02: five union-find drills in one sitting
            # read as a 60+ day window)
            day_clean = 0
            for v, a, na in days[d]:
                if v == "clean" and na != "learning":
                    day_clean = 1
                    last_clean = d
                    retrieved = retrieved or a == "none"
                elif v == "struggled":
                    struggles += 1
                assisted += ASSIST_WEIGHT[na]
            cleans += day_clean
    return trials


def _date(s):
    from datetime import date
    return date.fromisoformat(s)


def select_trials(trials, since=None, half_life=None):
    """(trials without dates, weights or None) from dated trials.

    `since` (a date) drops trials before it: an era boundary, for when an
    old regime should not vote at all. `half_life` (days) weights each
    trial 0.5^(age/half_life), age measured back from the newest trial:
    recency weighting, for when the old regime should vote less. Both knobs
    exist because the Oct-Nov 2025 era dominates the trial pool (73% of
    trials at gaps <= 7d) while the 2026 graph era keeps disagreeing with
    the curve it fitted (residuals z < -2 in four groups by sep 2026)."""
    if since:
        trials = [t for t in trials if t[-1] >= since]
    if not trials:
        return [], None
    weights = None
    if half_life:
        newest = max(t[-1] for t in trials)
        weights = [0.5 ** ((newest - t[-1]).days / half_life) for t in trials]
    return [t[:-1] for t in trials], weights


def fit(trials, iters=8000, lr=0.05, weights=None):
    """MLE for (a, b, c, d, e, conn_mean, beta, slip) in
    P = (1−slip)·(1 + Δ/s)^(−beta), s = exp(a + b·k − c·m − d·x + e·(conn − conn_mean)).
    Trials are 6-tuples (gap, success, cleans, struggles, assist, conn); the
    conn term is centered so a/b/c/d keep their meaning and consumers that
    ignore e are simply assuming average connectivity. `weights` (parallel
    to trials, from select_trials) turns the fit into weighted MLE."""
    try:
        return _fit_numpy(trials, iters, lr, weights)
    except ImportError:
        pass
    ws = [1.0] * len(trials) if weights is None else list(weights)
    wsum = sum(ws)
    conn_mean = sum(w * t[5] for w, t in zip(ws, trials)) / wsum
    a, b, c, d, e, beta, slip = math.log(60), 0.05, 0.05, 0.05, 0.0, 0.5, 0.05
    for it in range(iters):
        ga = gb = gc = gd = ge = gbeta = gslip = 0.0
        for w, (gap, sf, k, m, x, cn) in zip(ws, trials):
            k = math.log1p(k)
            stab = math.exp(a + b * k - c * m - d * x + e * (cn - conn_mean))
            u = gap / stab
            mem = (1 + u) ** (-beta)
            p = min(1 - 1e-9, max(1e-9, (1 - slip) * mem))
            # E = dLL/dP scaled: success pulls P up, failure pushes it down
            E = w * (sf - (1 - sf) * p / (1 - p))
            dlns = E * beta * u / (1 + u)          # dLL/d(ln stability)
            ga += dlns
            gb += dlns * k
            gc += dlns * (-m)
            gd += dlns * (-x)
            ge += dlns * (cn - conn_mean)
            gbeta += E * (-math.log(1 + u))
            gslip += E * (-1 / (1 - slip))
        step = lr / (1 + it / 2000)
        a += step * ga / wsum
        b = max(0.0, b + step * gb / wsum)          # reps should not shorten memory
        c = max(0.0, c + step * gc / wsum)
        d = max(0.0, d + step * gd / wsum)          # nor should being helped
        e += step * ge / wsum
        beta = min(5.0, max(0.02, beta + step * gbeta / wsum))
        slip = min(0.25, max(0.0, slip + step * gslip / wsum))
    return a, b, c, d, e, conn_mean, beta, slip


def _fit_numpy(trials, iters, lr, weights=None):
    import numpy as np

    gap, sf, k, m, x, cn = (np.array(v, dtype=float) for v in zip(*trials))
    k = np.log1p(k)
    w = np.ones(len(trials)) if weights is None else np.array(weights, dtype=float)
    conn_mean = float((w * cn).sum() / w.sum())
    cnc = cn - conn_mean
    a, b, c, d, e, beta, slip = math.log(60), 0.05, 0.05, 0.05, 0.0, 0.5, 0.05
    for it in range(iters):
        u = gap / np.exp(a + b * k - c * m - d * x + e * cnc)
        mem = (1 + u) ** (-beta)
        p = np.clip((1 - slip) * mem, 1e-9, 1 - 1e-9)
        E = w * (sf - (1 - sf) * p / (1 - p))
        dlns = E * beta * u / (1 + u)
        step = lr / (1 + it / 2000) / w.sum()
        a += step * dlns.sum()
        b = max(0.0, b + step * (dlns * k).sum())
        c = max(0.0, c + step * (-dlns * m).sum())
        d = max(0.0, d + step * (-dlns * x).sum())
        e += step * (dlns * cnc).sum()
        beta = min(5.0, max(0.02, beta + step * (-E * np.log1p(u)).sum()))
        slip = min(0.25, max(0.0, slip + step * (-E / (1 - slip)).sum()))
    return a, b, c, d, e, conn_mean, beta, slip


def loglik(trials, pred, weights=None):
    ws = [1.0] * len(trials) if weights is None else list(weights)
    return sum(w * math.log(max(1e-9, pred(g, k, m, x, cn) if s else 1 - min(1 - 1e-9, pred(g, k, m, x, cn))))
               for w, (g, s, k, m, x, cn) in zip(ws, trials)) / sum(ws)


GAP_BUCKETS = ((1, 7), (8, 21), (22, 42), (43, 90), (91, 180), (181, 400))

# Terminal chart palette: the GitHub-dark tones kg_render already draws the
# trees in. The model/observed pair is validated (dataviz six checks, dark
# surface); the reps ramp is sequential (one blue, darker -> lighter with
# reps) and every series is direct-labeled, never legend-only.
INK, INK2, GRID, SURFACE = "#c9d1d9", "#8b949e", "#21262d", "#0d1117"
BLUE_RAMP = ("#1f6feb", "#388bfd", "#79c0ff")
MODEL_BLUE, OBSERVED_GREEN = "#388bfd", "#2ea043"


def render_chart(stab, pred, trials, beta):
    """graph/curve_report.png — the refit report as three panels: the fitted
    forgetting curves by clean reps, the retention window by assist level,
    and the calibration check (model vs observed per gap bucket). Returns
    the png path, or None when matplotlib is unavailable."""
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
    except ImportError:
        return None

    fig, axes = plt.subplots(1, 3, figsize=(13.5, 4.0), dpi=200)
    fig.patch.set_facecolor(SURFACE)
    for ax in axes:
        ax.set_facecolor(SURFACE)
        for side in ("top", "right"):
            ax.spines[side].set_visible(False)
        for side in ("left", "bottom"):
            ax.spines[side].set_color(GRID)
        ax.tick_params(colors=INK2, labelsize=8)
        ax.grid(True, color=GRID, linewidth=0.6, alpha=0.6)
        ax.set_axisbelow(True)

    def window(k, x=0.0):
        return stab(k, 0, x) * (TARGET_RETENTION ** (-1 / beta) - 1)

    # panel 1: P(recall) vs gap, one curve per rep count, window marked where
    # each curve crosses the retention target
    ax = axes[0]
    gaps = [g / 2 for g in range(1, 481)]  # 0.5..240d
    for color, k in zip(BLUE_RAMP, (1, 5, 20)):
        ax.plot(gaps, [pred(g, k, 0) for g in gaps], color=color, linewidth=2)
        w = window(k)
        ax.annotate(f"{k} rep{'s' if k > 1 else ''} · {w:.0f}d",
                    xy=(min(w, 235), TARGET_RETENTION), color=color, fontsize=8,
                    xytext=(4, 4 + 11 * (1, 5, 20).index(k)), textcoords="offset points")
        ax.plot([w], [TARGET_RETENTION], "o", color=color, markersize=5)
    ax.axhline(TARGET_RETENTION, color=INK2, linewidth=1, linestyle="--", alpha=0.7)
    ax.annotate(f"SOLID above {TARGET_RETENTION:.0%}", xy=(238, TARGET_RETENTION),
                color=INK2, fontsize=8, ha="right", xytext=(0, -12),
                textcoords="offset points")
    ax.set_xlim(0, 240)
    ax.set_title("P(recall) by clean reps, unaided", color=INK, fontsize=10)
    ax.set_xlabel("days since last clean", color=INK2, fontsize=8)

    # panel 2: what help costs — the 90% window at 5 reps per assist level
    ax = axes[1]
    labels = ("unaided", "one hint", "walkthrough", "learning")
    xs = (0.0, 0.5, 1.0, 2.0)
    ws = [window(5, x) for x in xs]
    ys = range(len(labels))[::-1]
    ax.barh(ys, ws, height=0.55, color=MODEL_BLUE)
    for y, w in zip(ys, ws):
        ax.annotate(f"{w:.0f}d", xy=(w, y), color=INK, fontsize=9,
                    va="center", xytext=(4, 0), textcoords="offset points")
    ax.set_yticks(list(ys), labels)
    ax.tick_params(axis="y", colors=INK)
    ax.grid(axis="y", visible=False)
    ax.set_title("90%-retention window at 5 reps", color=INK, fontsize=10)
    ax.set_xlabel("days", color=INK2, fontsize=8)

    # panel 3: calibration — model mean vs observed clean-rate per gap
    # bucket, observed dots sized by evidence mass; y spans the data, not 0..1
    ax = axes[2]
    pts = []
    for lo, hi in GAP_BUCKETS:
        rows = [t for t in trials if lo <= t[0] <= hi]
        if not rows:
            continue
        obs = sum(t[1] for t in rows) / len(rows)
        mod = sum(pred(g, k, m, x, cn) for g, _, k, m, x, cn in rows) / len(rows)
        pts.append(((lo * hi) ** 0.5, mod, obs, len(rows)))
    xs, mods, obss, ns = zip(*pts)
    ax.set_xscale("log")
    ax.plot(xs, mods, color=MODEL_BLUE, linewidth=2, marker="o", markersize=5)
    ax.scatter(xs, obss, color=OBSERVED_GREEN, s=[12 + n / 2 for n in ns], zorder=3)
    for x, o, n in zip(xs, obss, ns):
        ax.annotate(f"n={n}", xy=(x, o), color=INK2, fontsize=7,
                    xytext=(0, 8), textcoords="offset points", ha="center")
    ax.annotate("model", xy=(xs[-1], mods[-1]), color=MODEL_BLUE, fontsize=9,
                xytext=(6, -2), textcoords="offset points")
    ax.annotate("observed", xy=(xs[-1], obss[-1]), color=OBSERVED_GREEN, fontsize=9,
                xytext=(6, 4), textcoords="offset points")
    lo_y = min(min(mods), min(obss))
    ax.set_ylim(max(0.0, lo_y - 0.06), 1.04)
    ax.set_xticks(xs, [f"{lo}-{hi}" for lo, hi in GAP_BUCKETS[:len(xs)]])
    ax.minorticks_off()
    ax.set_title("calibration by gap (model vs observed)", color=INK, fontsize=10)
    ax.set_xlabel("gap, days (log)", color=INK2, fontsize=8)

    fig.tight_layout(pad=1.4)
    out = os.path.join(GRAPH_DIR, "curve_report.png")
    fig.savefig(out, facecolor=SURFACE)
    plt.close(fig)
    return out


def fit_mass(evidence, problems):
    """Rehearsal mass as a predictor of a clean cold first attempt. Recorded
    in curve.json as a measurement of the evidence; the pass model does not
    read it, having offered `mass` to fit_solve as a candidate feature and
    watched the held-out check reject it.
    logistic regression of a cold first attempt being clean and unaided on
    x = log(1 + mass), mass = how many evidenced problems carry the walk's
    rarest move, with one intercept per difficulty. The 2026-08-31 check:
    Medium first attempts go 74% -> 92% clean from the rarest to the most
    rehearsed tercile, Easy 75% -> 95%, and acceptance rate predicts
    nothing. beta is the log-odds per unit of x; consumers apply
    beta * (x - pool mean x), so a uniform draw keeps its average and a
    friendly-first serving order (rule 6) stops biasing the fitted rate.
    Returns {"beta", "se", "n", "by_difficulty": {intercept per class}}."""
    import numpy as np
    from kg.kg_lib import assist_of, problem_difficulty, carrier_counts, walk_mass
    counts = carrier_counts(problems)
    seen, rows = set(), []
    for fname in sorted(evidence, key=lambda k: (evidence[k]["date"], k)):
        rec = evidence[fname]
        pnum = str(rec.get("problem", ""))
        if not pnum[:1].isdigit() or pnum in seen or not rec.get("moves"):
            continue
        seen.add(pnum)
        dif = problem_difficulty(pnum, problems)
        if dif not in ("Easy", "Medium", "Hard"):
            continue
        clean = all(v == "clean" for v in rec["moves"].values()) \
            and assist_of(rec) == "none"
        rows.append((dif, walk_mass(rec["moves"], counts), clean))
    if len(rows) < 30:
        return {"beta": 0.0, "se": 0.0, "n": len(rows), "by_difficulty": {}}
    difs = ["Easy", "Medium", "Hard"]
    X = np.array([[d == dd for dd in difs] + [x] for d, x, _ in rows], dtype=float)
    y = np.array([c for _, _, c in rows], dtype=float)
    w = np.zeros(X.shape[1])
    for _ in range(25):  # Newton's method on the log-likelihood
        pr = 1 / (1 + np.exp(-(X @ w)))
        grad = X.T @ (y - pr)
        hess = (X * (pr * (1 - pr))[:, None]).T @ X + 1e-6 * np.eye(X.shape[1])
        step = np.linalg.solve(hess, grad)
        w += step
        if np.abs(step).max() < 1e-8:
            break
    pr = 1 / (1 + np.exp(-(X @ w)))
    cov = np.linalg.inv((X * (pr * (1 - pr))[:, None]).T @ X + 1e-6 * np.eye(X.shape[1]))
    return {"beta": round(float(w[3]), 4), "se": round(float(np.sqrt(cov[3, 3])), 4),
            "n": len(rows),
            "by_difficulty": {d: round(float(w[i]), 4) for i, d in enumerate(difs)}}


# ---- the cold-solve model ---------------------------------------------------
# P(solve a problem cold, unaided, inside the clock) as one fitted logistic,
# on the games kg_lib.scored_games scores. Difficulty enters as the problem's
# contest rating (utils/kg/clist.py), not as its Easy/Medium/Hard label: the
# label is a three-way bucket whose Medium tier spans a wider rating range
# than the gap between the Easy and Medium medians, and out of sample it
# predicts these outcomes worse than an intercept does.
#
#   logit P = k0 + k_gap    * (his elo that day - rating)/400
#                + k_rating * (rating - 1500)/400
#                + k_recall * sum ln(recall of each move already met)
#                + k_unseen * (moves in the walk never met before)
#                + k_exper  * log1p(games played before this one)
#                + k_mass   * log1p(carriers of the walk's rarest move)
#                + k_length * ln(walk length)
#
# Recall comes from the forgetting curve fitted above, evaluated the day of
# the attempt. Every coefficient is fitted; a feature ships only if it earns
# its place on held-out games (expanding-window blocks, so a fold is always
# scored on games later than the ones it was fitted on).

SOLVE_FEATURES = ("gap", "rating", "recall", "unseen", "experience", "mass", "length")
SOLVE_FOLDS = 5
SOLVE_LAMBDAS = (0.0, 0.1, 0.3, 1.0, 3.0, 10.0)


def _logistic(X, y, lam=0.0, iters=60):
    """Newton's method on the ridge-penalised log-likelihood; the intercept
    (column 0) is never penalised."""
    import numpy as np
    w = np.zeros(X.shape[1])
    pen = np.eye(X.shape[1]) * lam
    pen[0, 0] = 0.0
    for _ in range(iters):
        pr = 1 / (1 + np.exp(-(X @ w)))
        grad = X.T @ (y - pr) - pen @ w
        hess = (X * (pr * (1 - pr))[:, None]).T @ X + pen + 1e-6 * np.eye(X.shape[1])
        step = np.linalg.solve(hess, grad)
        w += step
        if np.abs(step).max() < 1e-9:
            break
    return w


def _mean_loglik(X, y, w):
    import numpy as np
    pr = np.clip(1 / (1 + np.exp(-(X @ w))), 1e-9, 1 - 1e-9)
    return float((y * np.log(pr) + (1 - y) * np.log(1 - pr)).mean())


def solve_rows(evidence, params, ratings):
    """Per scored game: (features dict, outcome, date). Features are built
    from evidence strictly older than the game, so a row never sees its own
    result or anything after it."""
    import bisect
    cleans = defaultdict(list)          # move -> sorted clean dates
    for fname, rec in evidence.items():
        for mv, verdict in (rec.get("moves") or {}).items():
            if verdict == "clean":
                cleans[mv].append(rec["date"])
    for v in cleans.values():
        v.sort()

    def recall(move, day):
        seen = cleans.get(move)
        if not seen:
            return None
        i = bisect.bisect_left(seen, day)
        if i == 0:
            return None                  # never met before this attempt
        prior = seen[:i]
        s = min(max(math.exp(params["a"] + params["b"]
                             * math.log1p(len(set(prior)))), 7), 3650)
        gap = (_date(day) - _date(prior[-1])).days
        return (1 + gap / s) ** (-params["beta"])

    counts = kg_lib.carrier_counts(kg_lib.load_problems())
    rows = []
    for g in kg_lib.elo_games(evidence, ratings):
        rating = g["rating"]
        rs = [recall(m, g["date"]) for m in g["moves"]]
        rows.append(({
            "gap": (g["elo_before"] - rating) / 400,
            "rating": (rating - 1500) / 400,
            "recall": sum(math.log(max(r, 1e-3)) for r in rs if r is not None),
            "unseen": float(sum(1 for r in rs if r is None)),
            "experience": math.log1p(len(rows)),
            "mass": kg_lib.walk_mass(g["moves"], counts),
            "length": math.log(max(len(g["moves"]), 1)),
        }, g["score"], g["date"]))
    return rows


def _design(rows, features):
    import numpy as np
    X = np.array([[1.0] + [r[0][f] for f in features] for r in rows])
    y = np.array([r[1] for r in rows])
    return X, y


def _cv_loglik(rows, features, lam):
    """Mean held-out log-likelihood over expanding-window folds: fold k is
    fitted on everything before it and scored on the block after."""
    import numpy as np
    X, y = _design(rows, features)
    n = len(y)
    edges = [round(n * (i + 1) / (SOLVE_FOLDS + 1)) for i in range(SOLVE_FOLDS + 1)]
    lls, sizes = [], []
    for lo, hi in zip(edges, edges[1:]):
        if hi <= lo:
            continue
        w = _logistic(X[:lo], y[:lo], lam)
        lls.append(_mean_loglik(X[lo:hi], y[lo:hi], w) * (hi - lo))
        sizes.append(hi - lo)
    return sum(lls) / sum(sizes) if sizes else float("-inf")


def solve_ratings():
    """Problem number -> contest rating, zerotrac where it has one and
    rescaled CLIST elsewhere (utils/kg/clist.py). Empty when the CLIST cache
    has not been fetched, which leaves the cold-solve model unfitted."""
    try:
        from kg import clist
        return clist.combined_ratings()
    except (ImportError, SystemExit):
        return {}


def fit_solve(evidence, params, ratings):
    """Forward-select the features that earn their place on held-out games,
    refit on everything, and report what the alternatives score."""
    rows = solve_rows(evidence, params, ratings)
    if len(rows) < 100:
        return {"games": len(rows), "features": {}, "note": "too few games"}
    chosen, best = [], max(_cv_loglik(rows, [], lam) for lam in SOLVE_LAMBDAS)
    base_cv, best_lam = best, 0.0
    while True:
        gains = []
        for f in SOLVE_FEATURES:
            if f in chosen:
                continue
            for lam in SOLVE_LAMBDAS:
                gains.append((_cv_loglik(rows, chosen + [f], lam), f, lam))
        if not gains:
            break
        cv, feature, lam = max(gains)
        if cv <= best + 1e-4:
            break
        chosen, best, best_lam = chosen + [feature], cv, lam
    import numpy as np
    X, y = _design(rows, chosen)
    w = _logistic(X, y, best_lam)
    # The skill channel. `gap` (his Elo that day minus the problem's rating) is
    # offered above as a feature and loses to plain `rating` on held-out games:
    # tracking skill does not predict TODAY better, because his skill has not
    # measurably moved. It still belongs in the model, as the one term that can
    # move a projection - so the drift of the Elo state is measured here and
    # the forward simulation advances the fitted intercept by it. Near zero
    # today, with a standard error that says how near.
    drift, drift_se = kg_lib.elo_drift(evidence, ratings)
    pr = 1 / (1 + np.exp(-(X @ w)))
    cov = np.linalg.inv((X * (pr * (1 - pr))[:, None]).T @ X
                        + 1e-6 * np.eye(X.shape[1]))
    return {
        "games": len(rows),
        "features": {f: round(float(c), 4) for f, c in zip(["intercept"] + chosen, w)},
        "se": {f: round(float(np.sqrt(cov[i, i])), 4)
               for i, f in enumerate(["intercept"] + chosen)},
        "intercept_se": round(float(np.sqrt(cov[0, 0])), 4),
        "elo": {"now": round(kg_lib.elo_now(evidence, ratings), 1),
                "drift_per_day": round(drift, 5),
                "drift_se": round(drift_se, 5)},
        "lambda": best_lam,
        "cv_loglik": round(best, 4),
        "baseline_cv_loglik": round(base_cv, 4),
        "rejected": [f for f in SOLVE_FEATURES if f not in chosen],
    }


def solve_report(evidence, params, ratings):
    """Held-out comparison of the cold-solve model against the alternatives,
    on the same expanding-window folds: the base rate, the Easy/Medium/Hard
    label, the rating alone, and the fitted set. Printed by --solve-report."""
    import numpy as np
    rows = solve_rows(evidence, params, ratings)
    games = [g for g in kg_lib.scored_games(evidence) if g["problem"] in ratings]
    y = np.array([r[1] for r in rows])
    n = len(y)
    edges = [round(n * (i + 1) / (SOLVE_FOLDS + 1)) for i in range(SOLVE_FOLDS + 1)]

    def out_of_fold(X, lam):
        pred = np.full(n, np.nan)
        for lo, hi in zip(edges, edges[1:]):
            w = _logistic(X[:lo], y[:lo], lam)
            pred[lo:hi] = 1 / (1 + np.exp(-(X[lo:hi] @ w)))
        return pred

    fit = fit_solve(evidence, params, ratings)
    chosen = [f for f in fit["features"] if f != "intercept"]
    lab = np.column_stack([np.ones(n)] + [
        np.array([g["difficulty"] == d for g in games], float) for d in ("Medium", "Hard")])
    models = {
        "base rate": out_of_fold(np.ones((n, 1)), 0.0),
        "Easy/Medium/Hard label": out_of_fold(lab, 0.0),
        "rating alone": out_of_fold(_design(rows, ["rating"])[0], fit["lambda"]),
        "fitted: " + " + ".join(chosen): out_of_fold(_design(rows, chosen)[0], fit["lambda"]),
    }
    scored = ~np.isnan(next(iter(models.values())))
    print(f"{n} games, {int(scored.sum())} scored out of fold "
          f"({SOLVE_FOLDS} expanding-window blocks)")
    print(f"  {'model':34}{'loglik/game':>13}{'Brier':>9}{'mean p':>9}{'actual':>9}")
    lls = {}
    for name, pred in models.items():
        p = np.clip(pred[scored], 1e-9, 1 - 1e-9)
        t = y[scored]
        lls[name] = t * np.log(p) + (1 - t) * np.log(1 - p)
        print(f"  {name:34}{lls[name].mean():13.4f}{((p - t) ** 2).mean():9.4f}"
              f"{p.mean():9.3f}{t.mean():9.3f}")
    rng = np.random.default_rng(0)
    best = [k for k in models if k.startswith("fitted")][0]
    for other in ("base rate", "Easy/Medium/Hard label"):
        d = lls[best] - lls[other]
        boot = np.array([d[rng.integers(0, len(d), len(d))].mean() for _ in range(4000)])
        lo, hi = np.percentile(boot, [2.5, 97.5])
        print(f"  fitted - {other}: {d.mean():+.4f}/game, "
              f"95% CI [{lo:+.4f}, {hi:+.4f}], P(better) {(boot > 0).mean():.3f}")


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Fit the personal forgetting curve.")
    parser.add_argument("--if-stale", action="store_true",
                        help="refit only when evidence.json (or a knob) is newer than curve.json")
    parser.add_argument("--since", default=os.environ.get("CURVE_SINCE") or None,
                        metavar="YYYY-MM-DD",
                        help="era boundary: fit on trials on or after this date "
                             "(env CURVE_SINCE)")
    parser.add_argument("--solve-report", action="store_true",
                        help="held-out comparison of the cold-solve model "
                             "against the base rate, the difficulty label and "
                             "the rating alone")
    parser.add_argument("--half-life", type=float,
                        default=float(os.environ.get("CURVE_HALF_LIFE", 0) or 0),
                        metavar="DAYS",
                        help="recency weighting: a trial DAYS older than the newest "
                             "counts half as much (env CURVE_HALF_LIFE, 0 = off)")
    args = parser.parse_args()
    knobs = {"since": args.since, "half_life": args.half_life or 0}

    curve_path = os.path.join(GRAPH_DIR, "curve.json")
    evidence_path = os.path.join(GRAPH_DIR, "evidence.json")
    if (args.if_stale and os.path.exists(curve_path)
            and os.path.getmtime(curve_path) >= os.path.getmtime(evidence_path)):
        # a knob change makes the file stale even with no new evidence,
        # otherwise an .envrc experiment never reaches the serving path
        try:
            with open(curve_path) as f:
                prev = json.load(f).get("fit", {})
        except (OSError, ValueError):
            prev = {}
        if (prev.get("since") == knobs["since"]
                and prev.get("half_life", 0) == knobs["half_life"]):
            return  # curve already reflects current evidence and knobs

    evidence = load_evidence()
    dated = extract_trials(evidence, with_date=True, with_conn=True)
    since = _date(args.since) if args.since else None
    trials, weights = select_trials(dated, since, args.half_life or None)
    if not trials:
        raise SystemExit(f"no trials on or after {args.since}; curve.json left as is")
    a, b, c, d, e, conn_mean, beta, slip = fit(trials, weights=weights)
    problems = load_problems()
    conn = node_conn(problems)
    mass = fit_mass(evidence, problems)
    ratings = solve_ratings()
    if ratings:
        from kg import clist
        clist.write_ratings()          # graph/ratings.json, read by kg_mock
    solve = fit_solve(evidence, {"a": a, "b": b, "beta": beta}, ratings)

    def stab(k, m, x=0.0, cn=None):
        cn = conn_mean if cn is None else cn
        return math.exp(a + b * math.log1p(k) - c * m - d * x + e * (cn - conn_mean))

    def pred(gap, k, m, x=0.0, cn=None):
        return (1 - slip) * (1 + gap / stab(k, m, x, cn)) ** (-beta)

    ws = [1.0] * len(trials) if weights is None else weights
    base_rate = sum(w * t[1] for w, t in zip(ws, trials)) / sum(ws)
    ll_model = loglik(trials, pred, weights)
    ll_base = sum(w * math.log(base_rate if t[1] else 1 - base_rate)
                  for w, t in zip(ws, trials)) / sum(ws)

    curve = {
        "_comment": "Personal forgetting curve fitted by utils/kg/kg_curve. "
        "P(recall) = (1-slip)*(1 + gap/s)^(-beta), "
        "s = exp(a + b*log1p(cleans) - c*struggles - d*assist + e*(conn - conn_mean)); cleans counts distinct clean days, same-day reps are one rep. "
        "conn is the node's log2 carrier count, frozen below at fit time; "
        "consumers that ignore e are assuming average connectivity. "
        "\"solve\" is the cold-solve model fitted by fit_solve: "
        "logit P(solve cold, unaided, inside the clock) = the listed "
        "coefficients over (rating - 1500)/400, the walk's summed log recall, "
        "and its count of never-met moves; features not listed did not earn "
        "their place on held-out games. "
        "node_status() calls a node SOLID while the memory component "
        "(1 + gap/s)^(-beta) >= target_retention; delete this file to fall "
        "back to the flat 42-day window.",
        "model": "power-law-slip",
        "params": {"a": round(a, 4), "b": round(b, 4), "c": round(c, 4),
                   "d": round(d, 4), "e": round(e, 4),
                   "conn_mean": round(conn_mean, 4),
                   "beta": round(beta, 4), "slip": round(slip, 4)},
        "conn": {n: round(v, 3) for n, v in sorted(conn.items())},
        "target_retention": TARGET_RETENTION,
        "mass": mass,
        "solve": solve,
        "fit": {"trials": len(trials), "loglik": round(ll_model, 4),
                "baseline_loglik": round(ll_base, 4),
                "since": knobs["since"], "half_life": knobs["half_life"],
                "effective_trials": round(sum(ws), 1)},
    }
    with open(os.path.join(GRAPH_DIR, "curve.json"), "w") as f:
        json.dump(curve, f, indent=2)

    from rich.console import Console
    console = Console(highlight=False)
    print = lambda line: console.print(
        f"[bold]{line}[/bold]" if line.startswith("fitted") or line.startswith("wrote")
        else f"[dim]{line}[/dim]" if line.startswith("  ") else f"[cyan]{line}[/cyan]")
    if knobs["since"] or knobs["half_life"]:
        parts = []
        if knobs["since"]:
            parts.append(f"era boundary {knobs['since']}")
        if knobs["half_life"]:
            parts.append(f"recency half-life {knobs['half_life']:g}d "
                         f"(effective n {sum(ws):.0f})")
        print("knobs: " + ", ".join(parts))
    print(f"fitted on {len(trials)} trials: "
          f"P = {1 - slip:.2f}·(1 + Δ/s)^(−{beta:.2f}), "
          f"s = exp({a:.2f} + {b:.3f}·log1p(cleans) − {c:.3f}·struggles − {d:.3f}·assist "
          f"+ {e:.3f}·conn)")
    print(f"loglik/trial {ll_model:.4f} vs always-{base_rate:.0%} baseline {ll_base:.4f}")
    print(f"{TARGET_RETENTION:.0%}-retention window by clean reps (no struggles, unaided):")
    for k in (1, 2, 3, 5, 10, 20):
        window = stab(k, 0) * (TARGET_RETENTION ** (-1 / beta) - 1)
        print(f"  {k:2d} reps: stability {stab(k, 0):5.0f}d -> window ≈ {window:5.0f}d")
    print("cost of assistance (5 clean reps, no struggles):")
    for label, x in (("unaided", 0.0), ("one hint", 0.5),
                     ("walkthrough", 1.0), ("learning", 2.0)):
        window = stab(5, 0, x) * (TARGET_RETENTION ** (-1 / beta) - 1)
        print(f"  {label:12s}: window ≈ {window:5.0f}d")
    print("calibration (model mean vs observed unaided-recall rate):")
    for lo, hi in GAP_BUCKETS:
        rows = [(g, s, k, m, x, cn) for g, s, k, m, x, cn in trials if lo <= g <= hi]
        if rows:
            obs = sum(s for _, s, _, _, _, _ in rows) / len(rows)
            mod = sum(pred(g, k, m, x, cn) for g, _, k, m, x, cn in rows) / len(rows)
            print(f"  gap {lo:3d}-{hi:3d}d: model {mod:4.0%}  observed {obs:4.0%}  (n={len(rows)})")
    if solve.get("features"):
        terms = " ".join(f"{c:+.3f}·{f}" for f, c in solve["features"].items()
                         if f != "intercept")
        print(f"cold solve, fitted on {solve['games']} timed games: "
              f"logit P = {solve['features']['intercept']:.3f} {terms}")
        print(f"  held-out loglik/game {solve['cv_loglik']:.4f} vs base rate "
              f"{solve['baseline_cv_loglik']:.4f}"
              + (f"; earned no place: {', '.join(solve['rejected'])}"
                 if solve["rejected"] else ""))
    if args.solve_report:
        solve_report(evidence, {"a": a, "b": b, "beta": beta}, solve_ratings())
    print(f"wrote {os.path.join(GRAPH_DIR, 'curve.json')}")

    # the same report as a picture, drawn in-place on iTerm (silently skipped
    # when piped or unsupported — the text above is the everywhere fallback)
    import sys
    if sys.stdout.isatty():
        png = render_chart(stab, pred, trials, beta)
        if png:
            from kg.kg_render import show_inline
            show_inline(png, display_width_px=1100)


if __name__ == "__main__":
    main()
