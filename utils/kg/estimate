#!/usr/bin/env python3

# estimate — print today's readiness snapshot. No LLM, and nothing stored:
# every consumer (README chart, progress bars, dashboard) recomputes these
# numbers on the fly from git + the technique graph, so this is display only.
#
# The projected dates come from the Monte-Carlo mock model (utils/kg/kg_mock_rs):
# contest = hard-competent (central P(single hard) >= 50%), onsite = central
# P(onsite) >= 50%. kg_predict's work-done date rides along for comparison.

import json
import os
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from rich.console import Console
from rich.table import Table

from kg.kg_lib import load_nodes, load_evidence, node_status, SOLID, STALE, FRAGILE, MISSING

console = Console()


def main():
    nodes = load_nodes()
    evidence = load_evidence()

    statuses = {n: node_status(n, evidence) for n in nodes}
    counts = defaultdict(int)
    for node_id in nodes:
        s, _ = statuses[node_id]
        counts[s] += 1

    status_line = f"{counts[SOLID]} SOLID, {counts[STALE]} STALE, {counts[FRAGILE]} FRAGILE, {counts[MISSING]} MISSING (of {len(nodes)} technique nodes)"

    manila_tz = timezone(timedelta(hours=8))
    run_date = datetime.now(manila_tz).strftime("%Y-%m-%d")

    # work-done date from the curve simulator (utils/kg/kg_predict): when the
    # graph would be fully solid + enough mediums banked + a polish block
    predict = None
    try:
        out = subprocess.run(
            [sys.executable, os.path.join(os.path.dirname(__file__), "kg_predict"), "--json"],
            capture_output=True, text=True, check=True,
            env={**os.environ, "PYTHONPATH": os.path.dirname(os.path.dirname(os.path.abspath(__file__)))},
        ).stdout
        predict = json.loads(out)
    except (subprocess.CalledProcessError, json.JSONDecodeError) as e:
        console.print(f"[yellow]kg_predict failed, no work-done date: {e}[/yellow]")

    # Monte-Carlo milestone dates from `make mock` (utils/kg/kg_mock_rs): contest =
    # hard-competent (central P(single hard) >= 50%), onsite = central
    # P(onsite) >= 50%. These headline the README progress bars.
    mock = None
    mock_bin = os.path.join(os.path.dirname(__file__), "kg_mock_rs", "target", "release", "kg_mock")
    try:
        out = subprocess.run(
            [mock_bin, "--json"], capture_output=True, text=True, check=True,
        ).stdout
        mock = json.loads(out)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as e:
        console.print(f"[yellow]kg_mock failed, no mock milestones: {e}[/yellow]")

    table = Table(show_header=False, box=None, padding=(0, 2))
    table.add_row("Run date", run_date)
    table.add_row("Node statuses", status_line)
    if mock:
        table.add_row("Contest (mock hard-competent)", str(mock["hard_competent"]))
        table.add_row("Onsite (mock P(onsite)>=50%)", f"{mock['onsite_ready']} at {mock['hours']:g}h/day")
    if predict:
        table.add_row("Work done (kg_predict)", f"{predict['ready']} at {predict['hours']:g}h/day")
    console.print(table)


if __name__ == "__main__":
    main()
