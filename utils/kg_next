#!/usr/bin/env python3

# kg_next — deterministically pick the next problem from the technique graph
# and draw its full input tree (the problem's moves + every transitive
# prerequisite) inline in the terminal.
#
#   utils/kg_next              # pick, print preflight table, draw status+emoji tree
#   utils/kg_next --graph      # same, with node labels (the map)
#   utils/kg_next --no-show    # same, without the drawing
#   utils/kg_next --prepare    # same, then run `make prepare` on the pick
#   make next graph            # makefile form of --graph (make eats dashed args)
#   make next -- --prepare     # makefile form of --prepare (-- stops make's
#                              # option parsing; %: swallows the extra goal)
#
# Picking rules (same preference order the /next coach uses):
#   -1. session start (fewer than 2 solves since Manila midnight): the
#       gentlest all-SOLID easy (tiny walk, high acceptance) that has not
#       been solved inside WARMUP_COOLDOWN_DAYS — juice, not a rerun of
#       Thursday. Normal rules resume from the day's second solve onward.
#   0. sleep (graph/sleep.json, written by `make sleep`): a WOKEN problem —
#      timer expired, not yet re-attempted — jumps the queue for a fresh try;
#      while one is ASLEEP it is excluded everywhere and its walk's rusty
#      moves/prereqs get warmed first, via other carriers
#   1. consolidate the FRAGILE node with the highest unlock count (bank
#      problems blocked only by it; oldest evidence breaks ties), via the
#      freshest READY carrier
#   2. spaced re-solve of the STALE node's latest carrier, same unlock-count
#      order — unless the
#      move is DEEP stale (no clean solve within 2x the solid window): then the
#      memory is effectively gone, so re-enter on a gentle fresh carrier the way
#      FRAGILE does, instead of a cold "re-solve" that plays like a new problem
#   3. one new MISSING move whose prereqs are all SOLID — the one that
#      unlocks the most bank problems first
#   4. nothing rusty and nothing new: a summit — the gentlest unsolved Hard
#      whose whole walk is already SOLID and mature (kg_lib.mature: spaced
#      clean reps + a real-problem carry proof — a badge earned in one burst
#      of drills does not yet carry a Hard).
#      A Hard is never a CARRIER (not where
#      a rusty move gets its rep), but once it is all-green it is exactly what
#      to work on next, so it is picked here rather than behind `make hard`.
# One-new-move rule is enforced: every other move in the walk must be SOLID.
# Drill-success gate (kg_lib.drill_gated): a MISSING/FRAGILE/deep-stale target
# with a drill bank gets ONLY its drill until a clean rep clears the status —
# a struggled drill holds the carrier instead of unlocking it.
#
# NOTE: the default drawing writes only status + a random face from that
# status's pool (SOLID 💪, STALE 😐, ...) — no move names — so the tree
# can be used for pattern recognition. --graph names the walk: that is
# the "show me the map" flow. The /next chat flow seals targets.

import argparse
import json
import os
import random
import subprocess
import sys
from datetime import date
from rich.console import Console
from rich.table import Table

from kg_lib import (
    GRAPH_DIR, load_nodes, load_problems, load_evidence,
    node_status, latest_carrier, SOLID, STALE, FRAGILE, MISSING,
    DEEP_STALE_DAYS, load_sleep, sleep_state,
    last_solved, pnum_key, dodged_nodes, dodgeable, carriers_for, gentleness, unlocks,
    input_tree, tree_size, acceptance, due_drill, drill_gated, has_drill_bank,
    CLASSICS, route_gaps, rank_summits, immature_nodes,
)
from kg_render import make_digraph, status_node, render, display, animate, STATUS_FACE

console = Console()

UTILS = os.path.dirname(os.path.abspath(__file__))

STATUS_STYLE = {SOLID: "green", STALE: "yellow", FRAGILE: "red", MISSING: "dim"}

# Session-start juice: a problem solved this recently is muscle memory, not a
# warmup. Recent ones sink below the rest; they only surface if the cool pool
# is empty.
WARMUP_COOLDOWN_DAYS = 14


def is_session_start():
    """Exit code of the is_session_start script: 0 = still in the window."""
    return subprocess.run(
        [sys.executable, os.path.join(UTILS, "is_session_start")],
        capture_output=True).returncode == 0


def _iss():
    from importlib.machinery import SourceFileLoader
    return SourceFileLoader("_iss", os.path.join(UTILS, "is_session_start")).load_module()


def solved_today_pnums():
    """Problems already solved today — never re-offered, whatever the rule."""
    mod = _iss()
    pnums = set()
    for f in mod.solves_today():
        name = os.path.basename(f)
        num = name[1:].split("_", 1)[0]
        if name.startswith("p") and num.isdigit():
            pnums.add(num)
    return pnums


def _warmup_hot(pnum, evidence, today=None):
    """True if this problem was solved inside the warmup cooldown."""
    last = last_solved(pnum, evidence)
    if not last:
        return False
    today = today or date.today()
    return (today - date.fromisoformat(last)).days < WARMUP_COOLDOWN_DAYS


def trivial_easies(problems, nodes, evidence, statuses):
    """The gentlest all-SOLID easies: tiny walks, high acceptance, not done
    in the last WARMUP_COOLDOWN_DAYS. Session-start picks — juice, not
    training, so nothing rusty, nothing new, and nothing from Thursday."""
    cands = []
    for pnum, p in problems.items():
        moves = p.get("moves", [])
        if p.get("banned") or p.get("difficulty") != "Easy" or not moves:
            continue
        if not all(m in nodes and statuses[m][0] == SOLID for m in moves):
            continue
        # Hot (recently solved) sorts after cool. Size and acceptance only
        # rank inside that band, so 0.8% acceptance cannot beat a 2-day gap.
        cands.append((int(_warmup_hot(pnum, evidence)),
                      tree_size(pnum, problems, nodes), -acceptance(pnum),
                      last_solved(pnum, evidence), pnum))
    cands.sort()
    return [c[-1] for c in cands]


def drill_title(path):
    """The DRILL: header of a bank drill file (falls back to the filename)."""
    import re
    for line in open(path):
        m = re.match(r"\s*DRILL:\s*(.+)", line)
        if m:
            return m.group(1).strip()
    return os.path.splitext(os.path.basename(path))[0]


def problem_url(pnum):
    meta_path = os.path.join(os.path.dirname(GRAPH_DIR), "data/problems_metadata.json")
    try:
        slug = json.load(open(meta_path))[str(pnum)]["slug"]
        return f"https://leetcode.com/problems/{slug}/"
    except Exception:
        return f"https://leetcode.com/problemset/?search={pnum}"


def pick(nodes, problems, evidence, statuses, asleep=(), woken=(), exclude=(),
         session_start=False):
    """Return (target, status, pnum, reason) or None."""
    def due(target):
        """The drill pseudo-pick for a node, or None if none is due."""
        drill_id = f"drill:{target}"
        return drill_id if drill_id not in exclude and due_drill(target, evidence) else None

    # rule -1: inside the session-start window, a trivial easy comes first
    if session_start:
        for pnum in trivial_easies(problems, nodes, evidence, statuses):
            if pnum not in asleep and pnum not in exclude:
                return problems[pnum]["moves"][0], SOLID, pnum, \
                    "session start — trivial easy to get the juices flowing"

    # rule 0a: a woken problem jumps the queue for a fresh attempt
    for pnum in woken:
        if pnum in exclude:
            continue
        moves = problems[pnum]["moves"]
        target = next((m for m in moves if statuses[m][0] != SOLID), moves[0])
        return target, statuses[target][0], pnum, "woken from sleep — fresh attempt, from scratch"

    # rule 0b: while a problem sleeps, warm the rusty ground under it
    for pnum in asleep:
        closure = input_tree(problems[pnum]["moves"], nodes)
        rusty = sorted((n for n in closure if statuses[n][0] != SOLID),
                       key=lambda n: (statuses[n][1] is not None, statuses[n][1]))
        for target in rusty:
            if drill_gated(target, *statuses[target]):
                if due(target):
                    return target, statuses[target][0], due(target), \
                        f"warm the ground under sleeping {pnum} — drill {target} first"
                continue  # drilled today, still not clean — carrier stays held
            cands = [c for c in carriers_for(target, problems, statuses, nodes)
                     if c not in asleep and c not in exclude]
            if cands:
                cands.sort(key=lambda p: (last_solved(p, evidence), tree_size(p, problems, nodes), pnum_key(p)))
                return target, statuses[target][0], cands[0], \
                    f"warm the ground under sleeping {pnum} ({target})"
            if due(target):
                return target, statuses[target][0], due(target), \
                    f"warm the ground under sleeping {pnum} — no READY carrier, drill {target}"

    # reachability-aware ordering (PLAN.md phase 1): among the due nodes,
    # service the one that unblocks the most bank problems first; evidence
    # age breaks ties. Deep-stale re-entry still backstops anything left
    # waiting. The ZPD constraint is untouched.
    unl = unlocks(statuses, problems)
    fragile = sorted((n for n in nodes if statuses[n][0] == FRAGILE),
                     key=lambda n: (-unl.get(n, 0), statuses[n][1]))
    stale = sorted((n for n in nodes if statuses[n][0] == STALE),
                   key=lambda n: (-unl.get(n, 0), statuses[n][1]))
    missing = sorted((n for n in nodes if statuses[n][0] == MISSING
                      and all(statuses[p][0] == SOLID for p in nodes[n].get("prereqs", []))),
                     key=lambda n: (-unl.get(n, 0), n))

    dodged = dodged_nodes(evidence)
    for target in fragile:
        if drill_gated(target, *statuses[target]):
            if due(target):
                return target, FRAGILE, due(target), "fragile move — drill until clean, carrier after"
            continue  # drilled today, still not clean — carrier stays held
        cands = [c for c in carriers_for(target, problems, statuses, nodes) if c not in asleep and c not in exclude]
        if cands:
            if target in dodged:
                # anti-dodge: prefer carriers with no recorded escape route and
                # short walks (the target is load-bearing, not optional)
                cands.sort(key=lambda p: (dodgeable(p, target, problems),
                                          tree_size(p, problems, nodes),
                                          last_solved(p, evidence), pnum_key(p)))
                return target, FRAGILE, cands[0], \
                    f"you dodged this move on {dodged[target]} — carrier chosen to resist the dodge"
            cands.sort(key=lambda p: (gentleness(p, problems, nodes), last_solved(p, evidence), -acceptance(p), pnum_key(p)))
            return target, FRAGILE, cands[0], "consolidate a fragile move on a fresh carrier"

    for target in stale:
        age = (date.today() - statuses[target][1]).days
        if drill_gated(target, *statuses[target]):
            if due(target):
                return target, STALE, due(target), \
                    f"re-enter a deep-stale move ({age}d since clean) — drill until clean, carrier after"
            continue  # drilled today, still not clean — carrier stays held
        cands = [c for c in carriers_for(target, problems, statuses, nodes) if c not in asleep and c not in exclude]
        if not cands:
            continue
        if age > DEEP_STALE_DAYS:
            cands.sort(key=lambda p: (gentleness(p, problems, nodes), last_solved(p, evidence), -acceptance(p), pnum_key(p)))
            return target, STALE, cands[0], \
                f"re-enter a deep-stale move ({age}d since clean) on a gentle fresh carrier"
        carrier = latest_carrier(target, evidence)
        pnum = carrier[2] if carrier and carrier[2] in cands else \
            sorted(cands, key=lambda p: last_solved(p, evidence), reverse=True)[0]
        return target, STALE, pnum, "spaced re-solve of a stale move's carrier"

    for target in missing:
        if drill_gated(target, *statuses[target]):
            if due(target):
                return target, MISSING, due(target), "new move — drill until clean, carrier after"
            continue  # drilled today, still not clean — carrier stays held
        cands = [c for c in carriers_for(target, problems, statuses, nodes) if c not in asleep and c not in exclude]
        if cands:
            cands.sort(key=lambda p: (gentleness(p, problems, nodes), -acceptance(p), pnum_key(p)))
            return target, MISSING, cands[0], "one genuinely new move, prereqs all solid"

    # rule 4: nothing rusty and nothing new — take a summit. A Hard is never a
    # CARRIER (it is not where a rusty move gets its rep), but once its walk is
    # gap-free it is exactly what to work on next, so it belongs in the same
    # pick as everything else rather than behind a second command.
    summits = [p for p in ready_hards(problems, nodes, evidence, statuses)
               if p not in asleep and p not in exclude]
    if summits:
        pnum = rank_summits(summits, problems, nodes, statuses)[0]
        return problems[pnum]["moves"][0], SOLID, pnum, \
            "summit — its walk has no gaps left"

    return None


def ready_hards(problems, nodes, evidence, statuses):
    """Unsolved Hards with no gaps left in their route: every node in the
    transitive input tree SOLID — and mature (kg_lib.mature: a young badge
    from one burst of drills is not yet load-bearing) — and no `unmapped`
    move (a trick the taxonomy has no node for yet — unroutable new ground,
    so the walk is farther away than its mapped moves suggest).

    Classics come first, and the whole list is ranked by kg_lib.rank_summits,
    so `make next` and `make hard` cannot name different summits."""
    solved = {r["problem"] for r in evidence.values() if r.get("problem")}
    immature = immature_nodes(nodes, evidence, problems)
    out = []
    for pnum, p in problems.items():
        if p.get("difficulty") != "Hard" or p.get("banned") or pnum in solved \
                or not p.get("moves"):
            continue
        if route_gaps(pnum, problems, nodes, statuses, immature)[1] == 0:
            out.append(pnum)
    classics = [p for p in out if p in CLASSICS]
    pool = classics or out
    return rank_summits(pool, problems, nodes, statuses, immature)


def blocked_frontier(nodes, problems, evidence, statuses, asleep=(), exclude=()):
    """The frontier nodes pick() had to walk past, each with the reason it
    could not be served: [(node, status, why), ...].

    pick() returning None is two different answers wearing the same face —
    "nothing is due" and "something is due but the bank cannot carry it" —
    and only the second one is a to-do. A node with no READY carrier and no
    drill bank fell through every branch silently, which is how the last
    MISSING node in the graph stayed invisible while `make next` printed
    nothing at all."""
    out = []
    for nid in nodes:
        status, _ = statuses[nid]
        if status == SOLID:
            continue
        if status == MISSING and not all(statuses[p][0] == SOLID
                                         for p in nodes[nid].get("prereqs", [])
                                         if p in statuses):
            continue  # a prereq is still rusty — not on the frontier yet
        ready = carriers_for(nid, problems, statuses, nodes)
        if [c for c in ready if c not in asleep and c not in exclude]:
            continue  # servable — pick() just preferred something else
        if due_drill(nid, evidence):
            continue  # its drill is available and pick() would offer it

        walks = [p for p, v in problems.items() if nid in v.get("moves", [])]
        usable = [p for p in walks if not problems[p].get("banned")
                  and problems[p].get("difficulty") != "Hard"]
        listed = ", ".join(sorted(walks, key=pnum_key))
        if not walks:
            why = "no problem in the graph uses this move"
        elif not usable:
            why = (f"the only problem using it is {listed}, a Hard or banned one "
                   "(hards are summits, never used to introduce a move)"
                   if len(walks) == 1 else
                   f"every problem using it ({listed}) is a Hard or banned")
        elif not ready:
            why = "every problem using it also needs a second rusty move made solid first"
        else:
            why = "every problem using it is asleep or already solved today"
        if has_drill_bank(nid):
            why += ", and its drill is done for today"
        else:
            why += ", and no drill exists for it"
        out.append((nid, status, why))
    return out


def main():
    parser = argparse.ArgumentParser(description="Pick the next problem and draw its input tree.")
    parser.add_argument("n", nargs="?", type=int, default=1,
                        help="show the Nth recommendation (skip the first N-1)")
    parser.add_argument("--graph", action="store_true",
                        help="label tree nodes with move names (default: shape only)")
    parser.add_argument("--no-show", action="store_true", help="skip the drawing")
    parser.add_argument("--why", action="store_true",
                        help="when there is nothing to serve, name the frontier "
                             "nodes the bank cannot carry, and why")
    parser.add_argument("--prepare", action="store_true",
                        help="run `make prepare` on the pick (stub + branch — the solve clock starts)")
    args = parser.parse_args()
    labeled = args.graph

    def prepare(target):
        if not args.prepare:
            return
        cur = os.path.join(os.path.dirname(UTILS), "current.py")
        if os.path.exists(cur) and open(cur).read().strip():
            console.print("[yellow]current.py is not empty — record it (make solved) before preparing the next one.[/yellow]")
            sys.exit(1)
        subprocess.run([sys.executable, os.path.join(UTILS, "prepare"), str(target)],
                       cwd=os.path.dirname(UTILS))

    nodes = load_nodes()
    problems = load_problems()
    evidence = load_evidence()
    statuses = {n: node_status(n, evidence) for n in nodes}
    sleeps = load_sleep()
    asleep, woken = sleep_state(sleeps, evidence)

    session_start = is_session_start()

    secs = _iss().solve_seconds_today()
    if secs:
        h, m = divmod(secs // 60, 60)
        clock = f"{h}h {m:02d}m" if h else f"{m}m"
        console.print(f"[dim]today: {clock} solving[/dim]")

    exclude = set(solved_today_pnums())
    choice = None
    shown = 0
    for _ in range(max(1, args.n)):
        choice = pick(nodes, problems, evidence, statuses, asleep=asleep, woken=woken,
                      exclude=exclude, session_start=session_start)
        if not choice:
            break
        shown += 1
        exclude.add(choice[2])
    if not choice:
        # Zero friction: time worked, and what to work on next. Nothing else.
        # Basecamp running dry is the expected end state, not a fault — it
        # means the summits are the only thing left, so say so in one line.
        # The diagnosis of WHY a frontier node could not be served is real
        # but it is bank maintenance, not the answer to "what now": it lives
        # behind --why.
        if shown:
            console.print(f"[yellow]Only {shown} recommendation(s) available.[/yellow]")
        else:
            console.print("\nNothing to serve — the graph needs new problems mapped.")

        if args.why:
            blocked = blocked_frontier(nodes, problems, evidence, statuses, asleep, exclude)
            if blocked:
                table = Table(show_header=True, header_style="bold", box=None, padding=(0, 2))
                table.add_column("Move")
                table.add_column("Status")
                table.add_column("Why it can't be served")
                for nid, status, why in blocked:
                    table.add_row(nid, f"[{STATUS_STYLE[status]}]{status}[/{STATUS_STYLE[status]}]", why)
                console.print()
                console.print(table)
        return
    target, target_status, pnum, reason = choice

    if str(pnum).startswith("drill:"):
        path = due_drill(target, evidence)
        title = drill_title(path)
        s, d = statuses[target]
        table = Table(show_header=True, header_style="bold", box=None, padding=(0, 2))
        table.add_column("Move")
        table.add_column("Status")
        table.add_column("Last evidence")
        label = target if labeled else random.choice(STATUS_FACE[s])
        table.add_row(label, f"[{STATUS_STYLE[s]}]{s}[/{STATUS_STYLE[s]}]", str(d) if d else "—")
        with console.capture() as cap:
            console.print(f"\n[bold]drill: {title}[/bold]")
            console.print(path)
            console.print(table)
            console.print(f"`make prepare {target}`")
        if not args.no_show:
            tree = input_tree([target], nodes)
            dot = make_digraph("input-tree")
            for n in tree:
                s, d = statuses[n]
                status_node(dot, n, nodes[n], s, d, highlight=(n == target),
                            labeled=labeled)
            for n in tree:
                for pre in nodes[n].get("prereqs", []):
                    if pre in tree:
                        dot.edge(pre, n)
            dot.node(
                "drill_box",
                label=f"drill: {title}",
                shape="box",
                style="filled",
                fillcolor="#1f6feb",
                color="#c9d1d9",
                penwidth="2",
                fontsize="13",
                margin="0.2,0.12",
            )
            dot.edge(target, "drill_box", penwidth="1.4")
            logical_width = render(dot, "kg_next")
            display("kg_next", logical_width)
        animate(cap.get())
        prepare(target)
        return

    p = problems[pnum]

    table = Table(show_header=True, header_style="bold", box=None, padding=(0, 2))
    table.add_column("Move")
    table.add_column("Status")
    table.add_column("Last evidence")
    for m in p["moves"]:
        s, d = statuses[m]
        label = m if labeled else random.choice(STATUS_FACE[s])
        table.add_row(label, f"[{STATUS_STYLE[s]}]{s}[/{STATUS_STYLE[s]}]", str(d) if d else "—")

    # A summit reads differently from a basecamp problem — it is a test, taken
    # all-green — so it gets kg_hard's mountain rather than a word of prose.
    summit = "⛰  " if p.get("difficulty") == "Hard" else ""

    with console.capture() as cap:
        console.print(f"\n[bold]{summit}{pnum}. {p['title']}[/bold]")
        console.print(problem_url(pnum))
        if p.get("note"):
            console.print(f"[yellow]⚠ {p['note']}[/yellow]")
        console.print(table)

    if args.no_show:
        animate(cap.get())
        prepare(pnum)
        return

    tree = input_tree(p["moves"], nodes)
    dot = make_digraph("input-tree")
    for n in tree:
        s, d = statuses[n]
        status_node(dot, n, nodes[n], s, d, highlight=(n in p["moves"]),
                    labeled=labeled)
    for n in tree:
        for pre in nodes[n].get("prereqs", []):
            if pre in tree:
                dot.edge(pre, n)
    problem_node = f"problem_{pnum}"
    dot.node(
        problem_node,
        label=f"{pnum}. {p['title']}",
        shape="box",
        style="filled",
        fillcolor="#1f6feb",
        color="#c9d1d9",
        penwidth="2",
        fontsize="13",
        margin="0.2,0.12",
        tooltip=problem_url(pnum),
    )
    for m in p["moves"]:
        dot.edge(m, problem_node, penwidth="1.4")
    logical_width = render(dot, "kg_next")
    display("kg_next", logical_width)
    animate(cap.get())
    prepare(pnum)


if __name__ == "__main__":
    main()
