#!/usr/bin/env python3

# drill — load a drill from the bank (drills/<node-id>/*.py) into current.py.
#
#   utils/drill monotonic-stack        # least-recently-drilled file for that node
#   utils/drill drills/monotonic-stack/next_greater_index.py
#   utils/drill monotonic-stack --list
#
# The workflow then matches leetcode problems exactly: a branch named after
# the node is created off master with the stub committed; solve current.py,
# run `make solved` — the DRILL/TRAINS docstring headers route it to a
# d_-prefixed file in solved/ and drill evidence in the graph, and the branch
# squash-merges into master like any problem branch.

import argparse
import glob
import os
import re
import subprocess
import sys
from rich.console import Console

from kg_lib import load_evidence, last_drilled, released_rungs, clear_branch

console = Console()


def main():
    parser = argparse.ArgumentParser(description="Load a bank drill into current.py.")
    parser.add_argument("target", help="node id (drills/<node>/) or a direct path to a drill file")
    parser.add_argument("--list", action="store_true", help="list the node's drills and when last drilled")
    args = parser.parse_args()

    if os.path.isfile(args.target):
        candidates = [args.target]
    else:
        candidates = sorted(glob.glob(os.path.join("drills", args.target, "*.py")))
        if not candidates:
            console.print(f"[red]No drills found under drills/{args.target}/[/red]")
            existing = sorted(os.path.basename(d) for d in glob.glob("drills/*") if os.path.isdir(d))
            if existing:
                console.print(f"[dim]Nodes with drills: {', '.join(existing)}[/dim]")
            sys.exit(1)

    evidence = load_evidence()

    # the bank's filename order is the ladder: a rung is held while the rung
    # below it is not warm (kg_lib.released_rungs). A direct file path
    # bypasses the hold.
    released = released_rungs(candidates, evidence)

    if args.list:
        for path in candidates:
            when = last_drilled(path, evidence) or "never"
            hold = "" if path in released else "  [yellow]held[/yellow]"
            console.print(f"{path}  [dim]last drilled: {when}[/dim]{hold}")
        return

    # least-recently-drilled first; never-drilled sorts before everything
    path = min(released, key=lambda p: last_drilled(p, evidence))

    if os.path.exists("current.py") and open("current.py").read().strip():
        console.print("[red]current.py is not empty — finish or clear it first.[/red]")
        sys.exit(1)

    content = open(path).read()
    m = re.search(r"^\s*DRILL:\s*(.+)$", content, flags=re.M)
    title = m.group(1).strip() if m else os.path.splitext(os.path.basename(path))[0]
    node_id = os.path.basename(os.path.dirname(path))

    if not clear_branch(node_id):
        return

    # same branch flow as prepare: stub committed on a branch off master,
    # which `make solved` later squash-merges back and deletes
    subprocess.run(["git", "checkout", "master"], check=True, capture_output=True)
    with open("current.py", "w") as dst:
        dst.write(content)
    subprocess.run(["git", "checkout", "-b", node_id], check=True, capture_output=True)
    subprocess.run(["git", "add", "."], check=True, capture_output=True)
    subprocess.run(["git", "commit", "-m", f"drill: {title}"], check=True, capture_output=True)

    when = last_drilled(path, evidence) or "never"
    console.print(f"Loaded [bold]{path}[/bold] into current.py on branch [bold]{node_id}[/bold]  "
                  f"[dim](last drilled: {when})[/dim]")
    console.print("Solve it, then `make solved` as usual.")


if __name__ == "__main__":
    main()
