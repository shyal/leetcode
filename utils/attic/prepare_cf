lock = threading.Lock()


def process_problem(id_):
    m = re.match(r"(\d+)([a-zA-Z])$", id_)
    if not m:
        raise ValueError(f"Invalid problem id: {id_}")
    contest, index = m.group(1), m.group(2).upper()
    problem_url = f"https://codeforces.com/contest/{contest}/problem/{index}"

    print(f"Enter the title for problem {id_}: ")
    title = input().strip()

    print(
        f"Paste the problem description for {id_} (including input/output specs, samples, constraints), then press Ctrl+D to confirm:"
    )
    content = sys.stdin.read().strip()

    user_prompt = f"""Please generate a usable solution for Codeforces problem {id_}. {title}.

Use the following accurate data from user:

Content (text, please clean and format it nicely for the docstring):

{content}

Parse the content to extract the problem statement, examples (including inputs, outputs, explanations), and constraints.
Format them properly in the docstring.

The docstring should start with:
URL: {problem_url}

{id_}. {title}

Then the cleaned problem statement.

Then the examples.

Then the constraints.

The solution should include this docstring,
then def main(): with the body implemented with a passable solution (generate one),
then if __name__ == "__main__": main()
Then import sys, from io import StringIO
Then def run_with_input(input_str): ... as in the example.
Then the first example is invoked with print(run_with_input(input1))  # expected output commented
This is so the user can run the code and see output without asserting.
Then generate all the examples as assert statements.

Here is an example of how the stub should look:

{example_stub}

Here is the `sitecustomize.py`. Use builtins when necessary.

{open('utils/harness/sitecustomize.py').read() if os.path.exists('utils/harness/sitecustomize.py') else ''}

Here are utility functions:

{open('utils/harness/tree_utils.py').read() if os.path.exists('utils/harness/tree_utils.py') else ''}

{open('utils/harness/bst_utils.py').read() if os.path.exists('utils/harness/bst_utils.py') else ''}

{open('utils/harness/linked_list_utils.py').read() if os.path.exists('utils/harness/linked_list_utils.py') else ''}

{open('utils/harness/graph_utils.py').read() if os.path.exists('utils/harness/graph_utils.py') else ''}

You can directly use the custom function for tree building, linked lists. No need to re-implement them unless
no utility function exists for what needs doing.

Output only the description docstring, the Python code for the stub, and asserts. Indents are 4 spaces.
"""

    code = claude(user_prompt)

    asserts_prompt = f"""
Please generate output in the same format as input (description in docstring, solution, instantiation, and asserts). Your
goal is to generate more asserts that handle edge cases, and ensure full coverage of the solution, not to make sure
the solution passes.

Run the code with new asserts to make sure they're valid, and correctly test expected outputs. Do not generate
comments for the tests.

Now the content:

{code}

"""

    code = claude(asserts_prompt)

    clean_up_prompt = f"""
Please generate output in the same format as input (description in docstring, solution, instantiation, and asserts). Your
goal is to strip out the actual solution method body, so a candidate can use your output as a stub.

Comment out the asserts so the candidate can run the file (after filling in their solution) and see the output
of the first example.

Now the content:

{code}

"""

    code = claude(clean_up_prompt)
    problem_title = f"{id_}. {title}"
    print("problem_title", problem_title)
    file_name = f"current.py"

    with lock:
        run_git(["checkout", "master"])
        with open(file_name, "w") as f:
            f.write(code)

        print(f"Saved stub to {file_name}")
        run_git(["checkout", "-b", id_])
        run_git(["add", "."])
        run_git(["commit", "-m", problem_title])


threads = []
for id_ in args.ids:
    t = threading.Thread(target=process_problem, args=(id_,))
    t.start()
    threads.append(t)

for t in threads:
    t.join()
