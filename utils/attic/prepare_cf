#!/usr/bin/env python3

# prepare.py

import argparse
import sys
import subprocess
import os
import re
import subprocess as _subprocess
import threading


def strip_triple_ticks(text: str) -> str:
    pattern = r"^```(?:\w+)?\n|```$"
    result = re.sub(pattern, "", text, flags=re.MULTILINE)
    return result.strip()


def claude(user_prompt):
    result = _subprocess.run(
        ["claude", "-p", user_prompt, "--system-prompt",
         "You are a helpful assistant that generates Python stubs for Codeforces problems."],
        capture_output=True, text=True,
    )
    return strip_triple_ticks(result.stdout.strip())


def run_git(cmd):
    """Run a git command and return its output."""
    try:
        return (
            subprocess.check_output(["git"] + cmd, stderr=subprocess.STDOUT)
            .decode()
            .strip()
        )
    except subprocess.CalledProcessError as e:
        print(f"Git command failed: {' '.join(cmd)}\nOutput: {e.output.decode()}")
        sys.exit(1)


parser = argparse.ArgumentParser(description="Prepare codeforces questions.")
parser.add_argument(
    "ids", type=str, nargs="+", help="The ids of the codeforces questions, e.g. 231A"
)

args = parser.parse_args()

