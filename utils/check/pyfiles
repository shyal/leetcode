#!/usr/bin/env python3
# Print the Python sources the gates run on, one per line: every tracked .py
# under utils/ and dsa/, plus the extensionless scripts in utils/ that start
# with a python shebang. solved/, drills/ and utils/attic are not code under
# maintenance and stay out. `make check` feeds this list to black, ruff, mypy
# and the complexity gate so all four see the same files.
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


def python_sources(root=ROOT):
    out = subprocess.run(
        ["git", "ls-files", "utils", "dsa", ":!utils/attic"],
        cwd=root,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()
    keep = []
    for f in out:
        if f.endswith(".py"):
            keep.append(f)
            continue
        if "." in os.path.basename(f):
            continue
        try:
            with open(os.path.join(root, f), "rb") as fh:
                first = fh.readline()
        except OSError:
            continue
        if first.startswith(b"#!") and b"python" in first:
            keep.append(f)
    return sorted(keep)


if __name__ == "__main__":
    only_mypy = "--mypy" in sys.argv
    for f in python_sources():
        # dsa/ is written in the LeetCode dialect: the names sitecustomize
        # injects are invisible to mypy, so the type gate covers utils/ only
        if only_mypy and (f.startswith("dsa/") or f.endswith("sitecustomize.py")):
            continue
        print(f)
