#!/usr/bin/env python3
# Cyclomatic complexity gate over the files given as arguments (radon).
# Fails when the largest function exceeds MAX or the mean exceeds AVG.
# Both numbers are where the code stood when the gate went in; lower
# them when a refactor earns it, never raise them.
import json
import subprocess
import sys

MAX = 140  # utils/kg/kg_next _main
AVG = 5.3

files = sys.argv[1:]
raw = subprocess.run(
    [sys.executable, "-m", "radon", "cc", "-s", "-j"] + files,
    capture_output=True,
    text=True,
    check=True,
).stdout
blocks = []
for f, bs in json.loads(raw).items():
    if not isinstance(bs, list):
        print(f"{f}: {bs}", file=sys.stderr)
        sys.exit(2)
    blocks += [(b["complexity"], f, b["name"], b["lineno"]) for b in bs]
if not blocks:
    print("complexity: no functions found", file=sys.stderr)
    sys.exit(2)
worst = max(blocks)
avg = sum(b[0] for b in blocks) / len(blocks)
ok = worst[0] <= MAX and avg <= AVG
print(
    f"complexity: {len(blocks)} blocks, max {worst[0]} ({worst[1]}:{worst[3]} {worst[2]}), "
    f"avg {avg:.2f}; limits max {MAX}, avg {AVG}: {'ok' if ok else 'FAIL'}"
)
if not ok:
    for c, f, name, line in sorted(blocks, reverse=True)[:10]:
        print(f"  {c:>4}  {f}:{line}  {name}")
sys.exit(0 if ok else 1)
