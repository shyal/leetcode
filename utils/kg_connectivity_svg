#!/usr/bin/env python3

# kg_connectivity_svg — the connectivity effect on its own: every timed
# solve as a dot, x = how many problems in the bank share the solve's
# moves (mean carriers per move, log scale), y = minutes (log scale).
# Rendered into graph/connectivity.svg for the README pipeline.
#
# Split by difficulty so the rating confound stays out of the picture:
# easies green, mediums blue (hards have too few timed solves to plot a
# trend). The running-median line per difficulty is the effect; the dots
# are there to show how much scatter it lives in. Times mined the same
# way as kg_solvetime_svg (single-solve commits only, fails excluded).

import json
import math
import os
from collections import defaultdict
from importlib.machinery import SourceFileLoader

from kg_lib import GRAPH_DIR

kst = SourceFileLoader(
    "kst", os.path.join(os.path.dirname(os.path.abspath(__file__)), "kg_solvetime_svg")
).load_module()

OUT = os.path.join(GRAPH_DIR, "connectivity.svg")

W, H = 1200, 430
ML, MR, PT, PB = 70, 30, 56, 370
BG = "#0d1117"
INK = "#c9d1d9"
MUTED = "#8b949e"
GRID = "#21262d"
COLORS = {"Easy": "#3fb950", "Medium": "#58a6ff"}

X_LO, X_HI = 1.0, 7.0        # log2 mean carriers: 2 .. 128
Y_LO, Y_HI = -1.0, 7.0       # log2 minutes: 0.5m .. 128m
N_BINS = 6


def main():
    with open(os.path.join(GRAPH_DIR, "problems.json")) as f:
        problems = json.load(f)["problems"]
    carriers = defaultdict(int)
    for p in problems.values():
        for m in p.get("moves", []):
            carriers[m] += 1

    pts = defaultdict(list)
    for key, d, secs in kst.mine_reps():
        p = problems.get(key)
        if p and p.get("moves") and p.get("difficulty") in COLORS:
            conn = sum(carriers[m] for m in p["moves"]) / len(p["moves"])
            pts[p["difficulty"]].append((math.log2(max(conn, 2)), math.log2(secs / 60)))

    def x_of(c):
        return ML + (c - X_LO) / (X_HI - X_LO) * (W - ML - MR)

    def y_of(t):
        return PT + (Y_HI - t) / (Y_HI - Y_LO) * (PB - PT)

    svg = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" '
           f'font-family="Helvetica,sans-serif">',
           f'<rect width="{W}" height="{H}" fill="{BG}"/>',
           f'<text x="{W / 2:.0f}" y="24" text-anchor="middle" font-size="13" fill="{INK}">'
           'Move connectivity vs solve time: each timed solve, by how many problems '
           'share its moves, lines = running median</text>']

    for e in range(int(Y_LO), int(Y_HI) + 1):
        y = y_of(e)
        svg.append(f'<line x1="{ML}" y1="{y:.1f}" x2="{W - MR}" y2="{y:.1f}" '
                   f'stroke="{GRID}" stroke-width="1"/>')
        mins = 2 ** e
        lab = f"{mins:g}m" if mins >= 1 else "30s"
        svg.append(f'<text x="{ML - 8}" y="{y + 4:.1f}" text-anchor="end" font-size="11" '
                   f'fill="{MUTED}">{lab}</text>')
    for e in range(int(X_LO), int(X_HI) + 1):
        x = x_of(e)
        svg.append(f'<line x1="{x:.1f}" y1="{PB}" x2="{x:.1f}" y2="{PB + 4}" '
                   f'stroke="{MUTED}" stroke-width="1"/>')
        svg.append(f'<text x="{x:.1f}" y="{PB + 17}" text-anchor="middle" font-size="11" '
                   f'fill="{MUTED}">{2 ** e}</text>')
    svg.append(f'<text x="{(ML + W - MR) / 2:.0f}" y="{PB + 34}" text-anchor="middle" '
               f'font-size="11" fill="{MUTED}">problems sharing the walk\'s moves '
               '(mean carriers per move)</text>')

    # legend
    for i, diff in enumerate(COLORS):
        y = PT + 16 + i * 17
        svg.append(f'<circle cx="{ML + 14}" cy="{y - 4:.1f}" r="4" fill="{COLORS[diff]}"/>')
        svg.append(f'<text x="{ML + 24}" y="{y}" font-size="12" fill="{INK}">'
                   f'{diff.lower()} (n={len(pts[diff])})</text>')

    for diff, color in COLORS.items():
        for c, t in pts[diff]:
            c = max(min(c, X_HI), X_LO)
            t = max(min(t, Y_HI), Y_LO)
            svg.append(f'<circle cx="{x_of(c):.1f}" cy="{y_of(t):.1f}" r="3" '
                       f'fill="{color}" fill-opacity="0.4"/>')

    # running median per difficulty over equal-count bins
    for diff, color in COLORS.items():
        rows = sorted(pts[diff])
        per = len(rows) // N_BINS
        line = []
        for b in range(N_BINS):
            chunk = rows[b * per:(b + 1) * per if b < N_BINS - 1 else len(rows)]
            cs = sorted(c for c, _ in chunk)
            ts = sorted(t for _, t in chunk)
            line.append((cs[len(cs) // 2], ts[len(ts) // 2]))
        path = " ".join(f"{x_of(c):.1f},{y_of(t):.1f}" for c, t in line)
        svg.append(f'<polyline points="{path}" fill="none" stroke="{color}" '
                   f'stroke-width="2.5"/>')
        cx, ct = line[-1]
        svg.append(f'<text x="{x_of(cx) + 10:.1f}" y="{y_of(ct) + 4:.1f}" font-size="12" '
                   f'fill="{color}">{diff.lower()}</text>')

    svg.append("</svg>")
    with open(OUT, "w") as f:
        f.write("\n".join(svg) + "\n")
    print(f"wrote {OUT} (" +
          ", ".join(f"{d.lower()} n={len(pts[d])}" for d in COLORS) + ")")


if __name__ == "__main__":
    main()
