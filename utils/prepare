#!/usr/bin/env python3

# prepare.py

import argparse
import json
import sys
import subprocess
import os
import subprocess as _subprocess
import threading
import requests

CACHE_DIR = ".prepare_cache"


def cache_path(num):
    return os.path.join(CACHE_DIR, f"{num}.json")


def cache_load(num):
    try:
        with open(cache_path(num)) as f:
            entry = json.load(f)
        return entry["title"], entry["code"]
    except (OSError, ValueError, KeyError):
        return None


def cache_save(num, title, code):
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(cache_path(num), "w") as f:
        json.dump({"title": title, "code": code}, f)


def claude(user_prompt):
    result = _subprocess.run(
        [
            "claude", "-p", user_prompt,
            "--system-prompt",
            "You are a helpful assistant that generates Python stubs for "
            "LeetCode problems. Output ONLY the raw Python source code for "
            "the stub — no explanations, no markdown fences, no preamble, "
            "no postamble. Do NOT attempt to use any tools; the caller "
            "writes your stdout straight to disk.",
            "--disallowedTools", "Write,Edit,Read,Bash,NotebookEdit",
            "--output-format", "text",
        ],
        capture_output=True, text=True,
    )
    return result.stdout.strip()


def run_git(cmd):
    """Run a git command and return its output."""
    try:
        return (
            subprocess.check_output(["git"] + cmd, stderr=subprocess.STDOUT)
            .decode()
            .strip()
        )
    except subprocess.CalledProcessError as e:
        print(f"Git command failed: {' '.join(cmd)}\nOutput: {e.output.decode()}")
        sys.exit(1)


def get_question_info(num):
    url = "https://leetcode.com/graphql/"
    headers = {"Content-Type": "application/json"}

    # First query to get title, slug, difficulty using problemsetQuestionList
    query1 = """
    query problemsetQuestionList($categorySlug: String, $limit: Int, $skip: Int, $filters: QuestionListFilterInput) {
      problemsetQuestionList: questionList(
        categorySlug: $categorySlug
        limit: $limit
        skip: $skip
        filters: $filters
      ) {
        questions: data {
          difficulty
          frontendQuestionId: questionFrontendId
          paidOnly: isPaidOnly
          title
          titleSlug
        }
      }
    }
    """
    variables1 = {"categorySlug": "", "limit": 1, "skip": num - 1, "filters": {}}
    response1 = requests.post(
        url, headers=headers, json={"query": query1, "variables": variables1}
    )
    if response1.status_code != 200:
        raise ValueError(
            f"Failed to fetch question list: {response1.status_code} - {response1.text}"
        )
    data1 = response1.json()
    if "errors" in data1:
        raise ValueError(f"GraphQL error: {data1['errors']}")
    questions = data1["data"]["problemsetQuestionList"]["questions"]
    if not questions:
        raise ValueError(f"No question found for number {num}")
    q = questions[0]
    if q["frontendQuestionId"] != str(num):
        raise ValueError(
            f"Question frontend ID mismatch: expected {num}, got {q['frontendQuestionId']}"
        )
    if q["paidOnly"]:
        raise ValueError(f"Question {num} is paid only")
    title = q["title"]
    slug = q["titleSlug"]
    difficulty = q["difficulty"]

    # Second query to get details
    query2 = """
    query questionDetails($titleSlug: String!) {
      question(titleSlug: $titleSlug) {
        content
        exampleTestcases
        codeSnippets {
          lang
          langSlug
          code
        }
      }
    }
    """
    variables2 = {"titleSlug": slug}
    response2 = requests.post(
        url, headers=headers, json={"query": query2, "variables": variables2}
    )
    if response2.status_code != 200:
        raise ValueError(
            f"Failed to fetch question details: {response2.status_code} - {response2.text}"
        )
    data2 = response2.json()
    if "errors" in data2:
        raise ValueError(f"GraphQL error: {data2['errors']}")
    q2 = data2["data"]["question"]
    content = q2["content"]
    example_testcases = q2["exampleTestcases"]
    code_snippets = q2["codeSnippets"]

    python_stub = next(
        (sn["code"] for sn in code_snippets if sn["langSlug"] == "python3"), None
    )
    if not python_stub:
        raise ValueError("No Python3 code snippet found")

    return title, slug, difficulty, content, example_testcases, python_stub


parser = argparse.ArgumentParser(description="Prepare leetcode questions or bank drills.")
parser.add_argument(
    "targets", nargs="+",
    help="Leetcode question numbers, or drill node ids (drills/<node-id>/).",
)

args = parser.parse_args()

numbers = [int(t) for t in args.targets if str(t).isdigit()]
node_ids = [t for t in args.targets if not str(t).isdigit()]

example_stub = '''
"""
URL: https://leetcode.com/problems/smallest-even-multiple/description/?envType=problem-list-v2&envId=vn57k9wr

2413. Smallest Even Multiple

Given a positive integer n, return the smallest positive integer that is a multiple of both 2 and n.


Example 1:

Input: n = 5
Output: 10
Explanation: The smallest multiple of both 5 and 2 is 10.

Example 2:

Input: n = 6
Output: 6
Explanation: The smallest multiple of both 6 and 2 is 6. Note that a number is a multiple of itself.


Constraints:

    1 <= n <= 150
"""


class Solution:
    def smallestEvenMultiple(self, n: int) -> int:
        i = 1
        while True:
            if i % 2 == 0 and i % n == 0:
                return i
            i += 1


sol = Solution()

print(sol.smallestEvenMultiple(5))  # 10

assert sol.smallestEvenMultiple(5) == 10
assert sol.smallestEvenMultiple(6) == 6
'''

lock = threading.Lock()


def process_problem(num):
    cached = cache_load(num)
    if cached:
        title, code = cached
        print(f"Using cached stub for {num}. {title}")
        finalize(num, title, code)
        return

    title, slug, difficulty, content, example_testcases, python_stub = (
        get_question_info(num)
    )

    problem_url = f"https://leetcode.com/problems/{slug}/description/?envType=problem-list-v2&envId=vn57k9wr"

    user_prompt = f"""Please generate a usable solution for LeetCode problem {num}. {title}.

Use the following accurate data from LeetCode API:

Difficulty: {difficulty}

Content (HTML, please clean and format it nicely for the docstring):

{content}

Example inputs (newline-separated):

{example_testcases}

Python3 code snippet (use this for the Solution class and method signature):

{python_stub}

Parse the content to extract the problem statement, examples (including inputs, outputs, explanations), and constraints.
Format them properly in the docstring, removing HTML tags.

The docstring should start with:
URL: {problem_url}

{num}. {title}

Then the cleaned problem statement.

Then the examples.

Then the constraints.

The solution should include this docstring,
the Solution class with the method implemented with a passable solution (generate one),
then instantiate sol = Solution().
The first example is invoked with a print() (or draw_tree, tabulate etc if special printing functions apply), with the expected result commented out.
This is so the user can run the code and see output without asserting.
Then generate all the examples as assert statements.

Here is an example of how the stub should look:

{example_stub}

Here is the `sitecustomize.py`. Use builtins when necessary.

{open('utils/sitecustomize.py').read()}

Here are utility functions:



{open('utils/tree_utils.py').read()}




{open('utils/bst_utils.py').read()}




{open('utils/linked_list_utils.py').read()}


{open('utils/graph_utils.py').read()}


IMPORTANT: sitecustomize.py injects a large set of names into `builtins`. Do NOT import ANY of these —
they are already available without imports:
- Typing: List, Optional, Dict, Tuple, Any, Callable, Iterable, Iterator, TypeVar, Union
- Collections: Counter, defaultdict, OrderedDict, deque
- Functools/itertools: cache, reduce, chain, combinations, permutations, product, accumulate,
  groupby, pairwise, zip_longest, takewhile, dropwhile, starmap, islice, compress
- Math: gcd, isclose, log2, log10, floor, ceil, prod, sqrt, maxsize
- Heapq: heapify, heappop, heappush, nlargest, nsmallest
- Bisect: bisect_left, bisect_right
- Strings: ascii_letters, ascii_lowercase, ascii_uppercase, digits, hexdigits
- Types: TreeNode, ListNode, GraphNode, Node
- Utilities: build_tree, build_linked_list, get_list_values, build_graph, draw_tree,
  draw_linked_list, tabulate, rich_print, and the rest of the helpers above.

Do NOT emit `from typing import ...`, `from collections import ...`, `from functools import ...`,
`from itertools import ...`, `from math import ...`, `from heapq import ...`, `from bisect import ...`,
or `from string import ...`. The stub should have ZERO import statements unless it genuinely needs
something not listed above.

Output only the description docstring, the Python code for the stub, and asserts. Indents are 4 spaces.
"""

    code = claude(user_prompt)

    asserts_prompt = f"""
Please generate output in the same format as input (description in docstring, solution, instantiation, and asserts). Your
goal is to generate more asserts that handle edge cases, and ensure full coverage of the solution, not to make sure
the solution passes.

Run the code with new asserts to make sure they're valid, and correctly test expected outputs. Do not generate
comments for the tests.

Now the content:

{code}

"""

    code = claude(asserts_prompt)

    clean_up_prompt = f"""
Please generate output in the same format as input (description in docstring, solution, instantiation, and asserts). Your
goal is to strip out the actual solution method body, so a candidate can use your output as a stub.

IMPORTANT rules:
- Keep the URL line at the top of the docstring exactly as-is.
- Keep the print() call for the first example UNCOMMENTED (so the user can run the file and see output).
- Comment out all the assert statements.

Now the content:

{code}

"""

    code = claude(clean_up_prompt)
    cache_save(num, title, code)
    finalize(num, title, code)


def finalize(num, title, code):
    problem_title = f"{num}. {title}"
    print("problem_title", problem_title)
    file_name = f"current.py"

    with lock:
        run_git(["checkout", "master"])
        with open(file_name, "w") as f:
            f.write(code)

        print(f"Saved stub to {file_name}")
        run_git(["checkout", "-b", str(num)])
        run_git(["add", "."])
        run_git(["commit", "-m", problem_title])


# a node id routes to the drill bank picker — same flow as `make drill <node-id>`
for nid in node_ids:
    env = dict(os.environ)
    env["PYTHONPATH"] = "utils" + os.pathsep + env.get("PYTHONPATH", "")
    r = subprocess.run(
        [sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "drill"), nid],
        env=env,
    )
    if r.returncode:
        sys.exit(r.returncode)

threads = []
for num in numbers:
    t = threading.Thread(target=process_problem, args=(num,))
    t.start()
    threads.append(t)

for t in threads:
    t.join()
