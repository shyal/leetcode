from stub_utils import sanitize, strip_solution, structure_problems

CACHE_DIR = ".prepare_cache"


def cache_path(num):
    return os.path.join(CACHE_DIR, f"{num}.json")


def cache_load(num):
    try:
        with open(cache_path(num)) as f:
            entry = json.load(f)
        # "solution" is absent on entries cached before it was kept
        return entry["title"], entry["code"], entry.get("solution")
    except (OSError, ValueError, KeyError):
        return None


def cache_save(num, title, code, solution):
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(cache_path(num), "w") as f:
        json.dump({"title": title, "code": code, "solution": solution}, f)


SYSTEM_PROMPT = (
    "You are a helpful assistant that generates Python stubs for "
    "LeetCode problems. Output ONLY the raw Python source code for "
    "the stub — no explanations, no markdown fences, no preamble, "
    "no postamble. Do NOT attempt to use any tools; the caller "
    "writes your stdout straight to disk."
)


def strip_fences(out):
    # some models wrap output in markdown fences despite the system prompt
    if out.startswith("```"):
        lines = out.splitlines()[1:]
        if lines and lines[-1].strip() == "```":
            lines = lines[:-1]
        out = "\n".join(lines).strip()
    return out


def openai_llm(user_prompt):
    key = open(os.path.expanduser("~/.openai_key_leet")).read().strip()
    r = requests.post(
        "https://api.openai.com/v1/chat/completions",
        headers={"Authorization": "Bearer " + key},
        json={
            "model": args.model,
            "messages": [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_prompt},
            ],
            # reasoning models (gpt-5*, o*) only accept the default temperature
            **({"temperature": 0.2} if args.model.startswith("gpt-4") else {}),
        },
        timeout=600,
    )
    r.raise_for_status()
    return strip_fences(r.json()["choices"][0]["message"]["content"].strip())


def claude(user_prompt):
    result = _subprocess.run(
        [
            "claude", "-p", user_prompt,
            *(["--model", args.model] if args.model else []),
            "--system-prompt", SYSTEM_PROMPT,
            "--disallowedTools", "Write,Edit,Read,Bash,NotebookEdit",
            "--output-format", "text",
        ],
        capture_output=True, text=True,
    )
    return strip_fences(result.stdout.strip())


def llm(user_prompt):
    if args.model and args.model.startswith(("gpt-", "o3", "o4")):
        return openai_llm(user_prompt)
    return claude(user_prompt)


def validate(code):
    """Execute a solution+asserts stub. Returns (ok, combined output)."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", suffix=".py", delete=False, dir=CACHE_DIR
    ) as f:
        f.write(code)
        path = f.name
    env = dict(os.environ)
    env["PYTHONPATH"] = "utils" + os.pathsep + env.get("PYTHONPATH", "")
    try:
        r = subprocess.run(
            [sys.executable, path],
            capture_output=True, text=True, env=env, timeout=60,
        )
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    except subprocess.TimeoutExpired:
        return False, "Timed out after 60s (likely an infinite loop)."
    finally:
        os.unlink(path)


def append_computed_asserts(code, exprs_text):
    """Evaluate model-proposed test expressions against the validated
    solution and append `assert expr == <computed value>` lines for the ones
    that yield a stable literal. Anything that fails to parse, raises, or
    returns a non-literal is silently dropped."""
    import ast

    exprs = []
    for line in exprs_text.splitlines():
        line = line.strip().rstrip(",")
        if not line or line.startswith("#") or line.startswith("```"):
            continue
        try:
            compile(line, "<expr>", "eval")
        except SyntaxError:
            continue
        exprs.append(line)
    if not exprs:
        return code

    harness = [code, ""]
    for i, e in enumerate(exprs):
        harness.append(
            f"try:\n"
            f"    print('@@EXPR', {i}, repr(({e})))\n"
            f"except Exception:\n"
            f"    pass"
        )
    ok, output = validate("\n".join(harness))
    results = {}
    for line in output.splitlines():
        if line.startswith("@@EXPR "):
            _, idx, rep = line.split(" ", 2)
            if len(rep) > 400:
                continue  # a wall of output makes a useless, bloated assert
            try:
                value = ast.literal_eval(rep)
            except (ValueError, SyntaxError):
                continue  # reprs like <TreeNode ...> can't be asserted against
            if value is not None:
                results[int(idx)] = rep
    new = [f"assert {exprs[i]} == {results[i]}" for i in sorted(results)]
    if not new:
        return code
    return code.rstrip() + "\n\n" + "\n".join(new) + "\n"


def run_git(cmd):
    """Run a git command and return its output."""
    try:
        return (
            subprocess.check_output(["git"] + cmd, stderr=subprocess.STDOUT)
            .decode()
            .strip()
        )
    except subprocess.CalledProcessError as e:
        print(f"Git command failed: {' '.join(cmd)}\nOutput: {e.output.decode()}")
        sys.exit(1)


def get_question_info(num):
    url = "https://leetcode.com/graphql/"
    headers = {"Content-Type": "application/json"}

    # First query to get title, slug, difficulty using problemsetQuestionList
    query1 = """
    query problemsetQuestionList($categorySlug: String, $limit: Int, $skip: Int, $filters: QuestionListFilterInput) {
      problemsetQuestionList: questionList(
        categorySlug: $categorySlug
        limit: $limit
        skip: $skip
        filters: $filters
      ) {
        questions: data {
          difficulty
          frontendQuestionId: questionFrontendId
          paidOnly: isPaidOnly
          title
          titleSlug
        }
      }
    }
    """
    variables1 = {"categorySlug": "", "limit": 1, "skip": num - 1, "filters": {}}
    response1 = requests.post(
        url, headers=headers, json={"query": query1, "variables": variables1}
    )
    if response1.status_code != 200:
        raise ValueError(
            f"Failed to fetch question list: {response1.status_code} - {response1.text}"
        )
    data1 = response1.json()
    if "errors" in data1:
        raise ValueError(f"GraphQL error: {data1['errors']}")
    questions = data1["data"]["problemsetQuestionList"]["questions"]
    if not questions:
        raise ValueError(f"No question found for number {num}")
    q = questions[0]
    if q["frontendQuestionId"] != str(num):
        raise ValueError(
            f"Question frontend ID mismatch: expected {num}, got {q['frontendQuestionId']}"
        )
    if q["paidOnly"]:
        raise ValueError(f"Question {num} is paid only")
    title = q["title"]
    slug = q["titleSlug"]
    difficulty = q["difficulty"]

    # Second query to get details
    query2 = """
    query questionDetails($titleSlug: String!) {
      question(titleSlug: $titleSlug) {
        content
        exampleTestcases
        codeSnippets {
          lang
          langSlug
          code
        }
      }
    }
    """
    variables2 = {"titleSlug": slug}
    response2 = requests.post(
        url, headers=headers, json={"query": query2, "variables": variables2}
    )
    if response2.status_code != 200:
        raise ValueError(
            f"Failed to fetch question details: {response2.status_code} - {response2.text}"
        )
    data2 = response2.json()
    if "errors" in data2:
        raise ValueError(f"GraphQL error: {data2['errors']}")
    q2 = data2["data"]["question"]
    content = q2["content"]
    example_testcases = q2["exampleTestcases"]
    code_snippets = q2["codeSnippets"]

    python_stub = next(
        (sn["code"] for sn in code_snippets if sn["langSlug"] == "python3"), None
    )
    if not python_stub:
        raise ValueError("No Python3 code snippet found")

    return title, slug, difficulty, content, example_testcases, python_stub


parser = argparse.ArgumentParser(description="Prepare leetcode questions or bank drills.")
parser.add_argument(
    "targets", nargs="+",
    help="Leetcode question numbers, or drill node ids (drills/<node-id>/).",
)
parser.add_argument(
    "--warm", action="store_true",
    help="Only populate .prepare_cache; skip the git branch/commit step.",
)
parser.add_argument(
    "--jobs", type=int, default=4,
    help="Max problems generated concurrently (default 4).",
)
parser.add_argument(
    "--model", default=None,
    help="Model for the claude calls (default: your CLI default).",
)

args = parser.parse_args()

numbers = [int(t) for t in args.targets if str(t).isdigit()]
node_ids = [t for t in args.targets if not str(t).isdigit()]

example_stub = '''
"""
URL: https://leetcode.com/problems/smallest-even-multiple/description/?envType=problem-list-v2&envId=vn57k9wr

2413. Smallest Even Multiple

Given a positive integer n, return the smallest positive integer that is a multiple of both 2 and n.


Example 1:

Input: n = 5
Output: 10
Explanation: The smallest multiple of both 5 and 2 is 10.

Example 2:

Input: n = 6
Output: 6
Explanation: The smallest multiple of both 6 and 2 is 6. Note that a number is a multiple of itself.


Constraints:

    1 <= n <= 150
"""


class Solution:
    def smallestEvenMultiple(self, n: int) -> int:
        i = 1
        while True:
            if i % 2 == 0 and i % n == 0:
                return i
            i += 1


sol = Solution()

print(sol.smallestEvenMultiple(5))  # 10

assert sol.smallestEvenMultiple(5) == 10
assert sol.smallestEvenMultiple(6) == 6
'''

lock = threading.Lock()


def process_problem(num):
    cached = cache_load(num)
    if cached:
        title, code, _solution = cached
        print(f"Using cached stub for {num}. {title}")
        if not args.warm:
            finalize(num, title, code)
        return

    title, slug, difficulty, content, example_testcases, python_stub = (
        get_question_info(num)
    )

    problem_url = f"https://leetcode.com/problems/{slug}/description/?envType=problem-list-v2&envId=vn57k9wr"

    # the static preamble (environment + rules) comes FIRST and is identical
    # for every problem, so API-side prefix caching can bill it at the cached
    # rate; everything problem-specific comes after it.
    user_prompt = f"""You generate LeetCode solution files. The environment and rules below are FIXED and identical for every request; the problem comes at the end.

Here is the `sitecustomize.py`. Use builtins when necessary.

{open('utils/sitecustomize.py').read()}

Here are utility functions:



{open('utils/tree_utils.py').read()}




{open('utils/bst_utils.py').read()}




{open('utils/linked_list_utils.py').read()}


{open('utils/graph_utils.py').read()}


IMPORTANT: sitecustomize.py injects a large set of names into `builtins`. Do NOT import ANY of these —
they are already available without imports:
- Typing: List, Optional, Dict, Tuple, Any, Callable, Iterable, Iterator, TypeVar, Union
- Collections: Counter, defaultdict, OrderedDict, deque
- Functools/itertools: cache, reduce, chain, combinations, permutations, product, accumulate,
  groupby, pairwise, zip_longest, takewhile, dropwhile, starmap, islice, compress
- Math: gcd, isclose, log2, log10, floor, ceil, prod, sqrt, maxsize
- Heapq: heapify, heappop, heappush, nlargest, nsmallest
- Bisect: bisect_left, bisect_right
- Strings: ascii_letters, ascii_lowercase, ascii_uppercase, digits, hexdigits
- Types: TreeNode, ListNode, GraphNode, Node
- Utilities: build_tree, build_linked_list, get_list_values, build_graph, draw_tree,
  draw_linked_list, tabulate, rich_print, and the rest of the helpers above.

Do NOT emit `from typing import ...`, `from collections import ...`, `from functools import ...`,
`from itertools import ...`, `from math import ...`, `from heapq import ...`, `from bisect import ...`,
or `from string import ...`. The file should have ZERO import statements unless it genuinely needs
something not listed above.

Likewise do NOT redefine any injected helper or class (build_tree, get_level_order,
build_linked_list, get_list_values, draw_tree, TreeNode, ListNode, ...) — call the builtins.
The ONLY exception is a problem-specific class the problem statement itself defines (e.g. a
Node with a random pointer, graph neighbors, or quad-tree fields), which must shadow the
injected name. Same for helpers: if the builtin's signature does not fit the problem (e.g.
level order of a FOREST), define the variant locally rather than reshaping the builtin.

Parse the content to extract the problem statement, examples (including inputs, outputs, explanations), and constraints.
Format them properly in the docstring, removing HTML tags.

The docstring should start with the URL line given with the problem, then:

<num>. <title>

Then the cleaned problem statement.

Then the examples.

Then the constraints.

The solution should include this docstring,
the Solution class with the method implemented with a passable solution (generate one),
then instantiate sol = Solution().
The first example is invoked with a print() (or draw_tree, tabulate etc if special printing functions apply), with the expected result commented out.
This is so the user can run the code and see output without asserting.
Then generate all the examples as assert statements. ONLY the official examples
given in the problem content - do NOT invent additional test cases; their
expected values would be guesses, and extra coverage is added by a later stage
that computes expected values by execution.

Here is an example of how the file should look:

{example_stub}

Output only the description docstring, the Python code for the solution, and asserts. Indents are 4 spaces.

Now the problem. Please generate a usable solution for LeetCode problem {num}. {title}.

Use the following accurate data from LeetCode API:

Difficulty: {difficulty}

URL line for the docstring:

URL: {problem_url}

Content (HTML, please clean and format it nicely for the docstring):

{content}

Example inputs (newline-separated):

{example_testcases}

Python3 code snippet (use this for the Solution class and method signature):

{python_stub}
"""

    code = llm(user_prompt)

    # The generator can't execute anything, so its asserts are unverified.
    # Actually run solution+asserts here and loop failures back until green.
    for attempt in range(3):
        ok, output = validate(code)
        if ok:
            break
        print(f"{num}: validation attempt {attempt + 1} failed, asking for a fix")
        code = llm(f"""
The following LeetCode stub (solution + asserts) FAILED when executed. Fix the
SOLUTION. The asserts encode the official examples from the problem statement:
their expected values are ground truth and must NOT be changed (only fix an
expected value if it plainly contradicts the Output shown in the docstring's
examples). If an assert is NOT one of the official examples, DELETE it rather
than guessing its value. Keep the format identical (description in docstring, solution,
instantiation, print of first example, asserts). Output only the raw Python
source.

Execution output:

{output}

The code:

{code}
""")
    else:
        print(f"{num}: could not produce a passing solution+asserts, skipping.\nLast output:\n{output}")
        return

    # Enforce the house format: first deterministically (drop redundant
    # imports / helper-class redefinitions), then one corrective call if the
    # file is still structurally wrong. sanitize can remove a class the file
    # genuinely needs (e.g. a quad-tree Node shadowing the injected graph
    # Node), so it only stands if the file still runs afterwards.
    sanitized = sanitize(code)
    if sanitized != code:
        ok, _ = validate(sanitized)
        if ok:
            code = sanitized
    flaws = structure_problems(code)
    if flaws:
        print(f"{num}: fixing structure ({'; '.join(flaws)})")
        code = llm(f"""
The following file works but violates the required format:
{chr(10).join('- ' + f for f in flaws)}

Fix ONLY those violations. Keep the solution, docstring content, prints and asserts
otherwise identical. Output only the raw Python source.

{code}
""")
        code = sanitize(code)
        ok, _ = validate(code)
        if not ok or structure_problems(code):
            print(f"{num}: structure fix failed, skipping.")
            return

    # Edge-case coverage: the model proposes test EXPRESSIONS only; the
    # validated solution computes each expected value locally, so no
    # hand-derived (and possibly wrong) value ever lands in an assert.
    exprs = llm(f"""
The file below contains a correct, validated solution. Propose extra edge-case test
expressions for it: ONE Python expression per line, nothing else. Each expression must
call the solution and evaluate to a plain comparable value (wrap structure results with
helpers like get_level_order / get_list_values as the existing asserts do). Do NOT write
assert statements, expected values, comments, or blank lines. Cover boundary sizes,
duplicates, negatives, and constraint extremes. At most 12 lines.

{code}
""")
    with_edges = append_computed_asserts(code, exprs)
    if with_edges is not code:
        ok, _ = validate(with_edges)
        if ok:
            code = with_edges
    # current.py is derived from it, deterministically, at write time.
    # both cache fields are stored black-formatted.
    solution = code
    try:
        import black
        solution = black.format_str(solution, mode=black.Mode())
    except ImportError:
        pass
    except Exception as e:
        print(f"{num}: black failed ({e}), storing unformatted")
    try:
        stub = strip_solution(solution)
    except SyntaxError as e:
        print(f"{num}: could not strip the solution, skipping.\n{e}")
        return
    try:
        import black
        stub = black.format_str(stub, mode=black.Mode())
    except Exception:
        pass
    cache_save(num, title, stub, solution)
    if args.warm:
        print(f"{num}: cached.")
    else:
        finalize(num, title, stub)


def finalize(num, title, code):
    problem_title = f"{num}. {title}"
    print("problem_title", problem_title)
    file_name = f"current.py"

    with lock:
        run_git(["checkout", "master"])
        with open(file_name, "w") as f:
            f.write(code)

        print(f"Saved stub to {file_name}")
        run_git(["checkout", "-b", str(num)])
        run_git(["add", "."])
        run_git(["commit", "-m", problem_title])


# a node id routes to the drill bank picker — same flow as `make drill <node-id>`
for nid in node_ids:
    env = dict(os.environ)
    env["PYTHONPATH"] = "utils" + os.pathsep + env.get("PYTHONPATH", "")
    r = subprocess.run(
        [sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "drill"), nid],
        env=env,
    )
    if r.returncode:
        sys.exit(r.returncode)

work = queue.Queue()
for num in numbers:
    work.put(num)


def worker():
    while True:
        try:
            num = work.get_nowait()
        except queue.Empty:
            return
        try:
            process_problem(num)
        except Exception as e:
            print(f"{num}: failed ({e})")


threads = [
    threading.Thread(target=worker)
    for _ in range(min(args.jobs, len(numbers)) or 1)
]
for t in threads:
    t.start()
for t in threads:
    t.join()
